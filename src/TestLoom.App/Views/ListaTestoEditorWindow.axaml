<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:TestLoom.App.Services"
        xmlns:models="using:TestLoom.App.Models"
        xmlns:local="using:TestLoom.App"
        x:Class="TestLoom.App.Views.ListaTestoEditorWindow"
        Width="640" Height="640" MinWidth="480" MinHeight="420" CanResize="True"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
            <TextBlock x:Name="TitoloText" FontSize="16" FontWeight="Bold" AutomationProperties.AutomationId="ListaTesto_Titolo_Text" />
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ListaTestoEditorSottotitolo}" Classes="Muted" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
            <TextBox x:Name="IncollaBox" Grid.Column="0" AutomationProperties.AutomationId="ListaTesto_Incolla_TextBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="90"
                     VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas,monospace"
                     PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=IncollaQuiPlaceholder}" />
            <Button x:Name="AggiungiRigheButton" Grid.Column="1" Classes="Secondary" Margin="8,0,0,0" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ListaTesto_AggiungiRighe_Button"
                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AggiungiRigheDaTestoBtn}" />
            <Button x:Name="ImportaFileButton" Grid.Column="2" Classes="Secondary" Margin="8,0,0,0" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ListaTesto_ImportaFile_Button"
                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportaDaFileBtn}" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RigheItems" AutomationProperties.AutomationId="ListaTesto_Righe_ItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RigaEvidenziata">
                            <!-- Righe "a elenco" compatte, non campi modulo separati (feedback utente 2026-08-24):
                                 niente bordo arrotondato/padding largo per riga, solo una sottile linea divisoria
                                 — con centinaia di righe di un trace lo stile "Field" le rendeva troppo staccate. -->
                            <Border Background="{Binding Colore, Converter={x:Static local:ColoreEvidenziazioneBrushConverter.Instance}}"
                                    BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" AutomationProperties.AutomationId="ListaTesto_Riga_TextBox" Text="{Binding Testo}" FontFamily="Consolas,monospace" FontSize="13"
                                             Padding="6,3" BorderThickness="0" Background="Transparent" CornerRadius="0">
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=EvidenziaNessuna}" Tag="Nessuno" Click="OnImpostaColoreRiga" />
                                                <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=EvidenziaGiallo}" Tag="Giallo" Click="OnImpostaColoreRiga" />
                                                <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=EvidenziaRosso}" Tag="Rosso" Click="OnImpostaColoreRiga" />
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                    <Button Grid.Column="1" Content="✕" Classes="Link" Padding="6,0" FontSize="13" Click="OnRimuoviRiga" Tag="{Binding}" AutomationProperties.AutomationId="ListaTesto_RimuoviRiga_Button" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button x:Name="AnnullaButton" Classes="Secondary" AutomationProperties.AutomationId="ListaTesto_Annulla_Button"
                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=Annulla}" />
            <Button x:Name="SalvaButton" Classes="Primary" AutomationProperties.AutomationId="ListaTesto_Salva_Button"
                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=Salva}" />
        </StackPanel>
    </Grid>
</Window>
