<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:TestLoom.App.Services"
        x:Class="TestLoom.App.Views.ConfirmDialog"
        Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ConfermaSemplice}"
        Width="420" SizeToContent="Height" CanResize="True"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="MessaggioText" TextWrapping="Wrap" FontSize="14" AutomationProperties.AutomationId="Confirm_Message_Text" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="NoButton" Classes="Secondary" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=NoLabel}" AutomationProperties.AutomationId="Confirm_No_Button" />
            <Button x:Name="SiButton" Classes="Primary" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=SiLabel}" AutomationProperties.AutomationId="Confirm_Yes_Button" />
        </StackPanel>
    </StackPanel>
</Window>
