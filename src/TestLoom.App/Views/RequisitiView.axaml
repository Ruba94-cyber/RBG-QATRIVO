<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestLoom.App.ViewModels"
             xmlns:services="using:TestLoom.App.Services"
             xmlns:local="using:TestLoom.App"
             xmlns:models="using:TestLoom.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="TestLoom.App.Views.RequisitiView"
             x:DataType="vm:RequisitiViewModel"
             x:Name="Root">
<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{DynamicResource PagePadding}" IsEnabled="{Binding InterazioneEditorAbilitata}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding TitoloScheda}" Classes="PageTitle" AutomationProperties.AutomationId="Requis_Titolo_Text" />
                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=RequisitiSottotitolo}" Classes="Muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ReqSottotitolo}" Classes="Muted" Margin="0,4,0,0" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Classes="AzioniPagina" MaxWidth="560">
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=Modifica}" Classes="Secondary" Command="{Binding IniziaModificaCommand}" IsVisible="{Binding MostraModifica}" AutomationProperties.AutomationId="Requis_Modifica_Button" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=NuovoGenerico}" Classes="Secondary" Command="{Binding NuovoCommand}" IsVisible="{Binding InModifica}" AutomationProperties.AutomationId="Requis_Nuovo_Button" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=NuovoTooltipCtrlN}" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportaExcelBtn}" Classes="Secondary" Command="{Binding ImportaDaExcelCommand}" IsVisible="{Binding InModifica}" Click="OnImportaExcel" AutomationProperties.AutomationId="Requis_ImportaExcel_Button" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=EsportaExcelBtn}" Classes="Secondary" Click="OnEsportaExcel" IsVisible="{Binding !InModifica}" AutomationProperties.AutomationId="Requis_EsportaExcel_Button" />
                <!-- Import guasto massivo (scheda Extra): colonne Requisito, guasto, componente su piu requisiti Extra. Streaming, annullabile. -->
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcImportaBtn}" Classes="Secondary" Click="OnImportaDtc" IsVisible="{Binding PuoImportareDtcMassivo}" AutomationProperties.AutomationId="Requis_ImportaDtcMassivo_Button" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcDalRegistroBtn}" Classes="Secondary" Command="{Binding AggiungiDtcDalRegistroCommand}" IsVisible="{Binding PuoAggiungereDtcDalRegistro}" AutomationProperties.AutomationId="Requis_AggiungiDtcDalRegistro_Button" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcAssociaAlRequisitoBtn}" Classes="Secondary" Command="{Binding AssociaDtcAlRequisitoCommand}" IsVisible="{Binding PuoAssociareDtcAlRequisito}" AutomationProperties.AutomationId="Requis_AssociaDtcAlRequisito_Button" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcImportAnnullaBtn}" Classes="Secondary" Click="OnAnnullaImportDtc" IsVisible="{Binding ImportDtcInCorso}" AutomationProperties.AutomationId="Requis_ImportaDtcAnnulla_Button" />
                <TextBlock Text="{Binding ImportDtcProgresso}" IsVisible="{Binding ImportDtcInCorso}" VerticalAlignment="Center" AutomationProperties.AutomationId="Requis_ImportaDtcProgresso_Text" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterDataSalvaPaginaBtn}" Classes="Secondary" Command="{Binding SalvaPaginaCommand}" IsVisible="{Binding MostraSalvaPagina}" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterDataSalvaPaginaTip}" AutomationProperties.AutomationId="Requis_SalvaPagina_Button" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=Annulla}" Classes="Secondary" Command="{Binding AnnullaCommand}" IsVisible="{Binding InModifica}" AutomationProperties.AutomationId="Requis_Annulla_Button" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AnnullaTooltipEsc}" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=Salva}" Classes="Primary" Command="{Binding SalvaCommand}" IsVisible="{Binding InModifica}" AutomationProperties.AutomationId="Requis_Salva_Button" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=SalvaTooltipCtrlS}" />
            </WrapPanel>
        </Grid>

        <!-- Banner lock/errore/esito: sempre visibili, fuori dall'area scorrevole (un errore di Salva non deve finire fuori vista). -->
        <StackPanel Grid.Row="1">
            <Border Classes="Banner BannerAvviso" IsVisible="{Binding AvvisoLockNonConfermato}" Margin="0,12,0,0">
                <TextBlock Text="{Binding AvvisoLockNonConfermatoTesto}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="Banner BannerAvviso" IsVisible="{Binding LockDetenutoDaAltri}" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding LockInfoTesto, StringFormat='🔒 {0}'}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ForzaSbloccoBtn}" Classes="Link" Command="{Binding ForzaSbloccoCommand}" />
                </Grid>
            </Border>

            <Border Classes="Banner BannerErrore" IsVisible="{Binding HaMessaggioErrore}" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding MessaggioErrore}" TextWrapping="Wrap" AutomationProperties.AutomationId="Requis_MessaggioErrore_Text" />
                    <Button Grid.Column="1" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=RiprovaIndice}" Classes="Link" Command="{Binding RiprovaRilascioLockCommand}" IsVisible="{Binding RilascioLockInAttesa}" AutomationProperties.AutomationId="Requis_RiprovaRilascioLock_Button" />
                </Grid>
            </Border>

            <StackPanel Margin="0,12,0,0" Spacing="6">
                <Border Classes="Banner BannerSuccesso" IsVisible="{Binding HaMessaggio}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="BannerSuccessoTesto" Text="{Binding Messaggio}" />
                        <Button Grid.Column="1" Classes="BannerChiudi" Content="✕" Command="{Binding CancellaMessaggioCommand}" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ChiudiMessaggioTip}" AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ChiudiMessaggioTip}" />
                    </Grid>
                </Border>
                <Border Classes="Banner BannerSuccesso" IsVisible="{Binding HaReportImport}" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="BannerSuccessoTesto" Text="{Binding ReportImport}" TextWrapping="Wrap" AutomationProperties.AutomationId="Requis_ReportImport_Text" />
                        <WrapPanel>
                            <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportReportCopia}" Classes="Secondary" Command="{Binding CopiaReportImportCommand}" AutomationProperties.AutomationId="Requis_CopiaReportImport_Button" />
                            <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportReportAnnullaUltimo}" Classes="Secondary" Command="{Binding AnnullaUltimoImportCommand}" IsVisible="{Binding PuoAnnullareUltimoImport}" AutomationProperties.AutomationId="Requis_AnnullaUltimoImport_Button" />
                            <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportReportRiprova}" Classes="Secondary" Command="{Binding RiprovaImportCommand}" IsVisible="{Binding PuoRiprovareImport}" AutomationProperties.AutomationId="Requis_RiprovaImport_Button" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Classes="Banner BannerAvviso" IsVisible="{Binding MostraAvvisoModificaLimitata}">
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterDataModificaLimitataPagina}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Zona sopra la tabella: altezza limitata e scorrevole, cosi' la griglia principale mantiene sempre
             un'altezza minima utile (NON mettere mai la DataGrid dentro questo ScrollViewer: spezza la virtualizzazione). -->
        <ScrollViewer Grid.Row="2" MaxHeight="{Binding #Root.Bounds.Height, Converter={x:Static local:AltezzaResiduaConverter.Instance}, ConverterParameter=400}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                    <TextBox Grid.Column="0" Classes="Field" Text="{Binding FiltroTesto}" AutomationProperties.AutomationId="Requis_Cerca_TextBox"
                              PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=CercaMasterDataPlaceholder}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ConfermaRicercaCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=RimuoviFiltriBtn}" Classes="Link"
                            Margin="8,0,0,0" Command="{Binding ReimpostaFiltriCommand}" IsVisible="{Binding HaFiltriAttivi}" />
                </Grid>


                <!-- RowHeight fisso (feedback utente: "l'elenco va letteralmente scattando mentre scorro"): senza
                     un'altezza dichiarata il pannello virtualizzante stima l'altezza media dalle sole righe già
                     realizzate e su ~100+ righe quella stima diverge abbastanza da far saltare la scrollbar avanti
                     o indietro invece di scorrere con continuità. -->

                <!-- guasto del requisito selezionato (6.5.0, punto 7). Lista VIRTUALIZZATA (ListBox con pannello di default
                     virtualizzante, altezza fissa): regge migliaia di voci. Modifica/import solo in modalita modifica. -->
                <Expander Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False" IsVisible="{Binding MostraPannelloDtc}" Header="{Binding TitoloDtc}" AutomationProperties.AutomationId="Requis_Guasto_Expander">
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <!-- Nuova voce: Sottoveicolo (tra i DICHIARATI dal requisito) e componente (anagrafica) da menu a tendina, codice digitato. -->
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" IsVisible="{Binding DtcModificabile}">
                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding VeicoliScegliibili}" SelectedItem="{Binding NuovoDtcVeicoloScelto}" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcVeicoloPlaceholder}" AutomationProperties.AutomationId="Requis_Guasto_Veicolo_Combo" />
                            <ComboBox Grid.Column="1" Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding EcuDisponibili}" SelectedItem="{Binding NuovoDtcEcu}" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcEcuPlaceholder}" AutomationProperties.AutomationId="Requis_Guasto_Componente_Combo" />
                            <Button Grid.Column="2" Classes="Secondary" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcImportaBtn}" Click="OnImportaDtc" AutomationProperties.AutomationId="Requis_Guasto_Importa_Button" />
                        </Grid>
                        <!-- Nodo scelto (Veicolo + componente): i guasti si incollano in blocco nell'area di testo (uno per riga o separati da , ; spazio). -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding DtcModificabile}">
                            <TextBox Grid.Column="0" Classes="Field" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140" Text="{Binding NuovoDtcCodici}" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcCodiciPlaceholder}" AutomationProperties.AutomationId="Requis_Guasto_Codice_TextBox" />
                            <Button Grid.Column="1" Classes="Secondary" VerticalAlignment="Top" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcAggiungiAlNodoBtn}" Command="{Binding AggiungiDtcCommand}" AutomationProperties.AutomationId="Requis_Guasto_Aggiungi_Button" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding DtcModificabile}">
                            <Button Classes="Link" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcNodoVeicoloBtn}" Command="{Binding AggiungiNodoVeicoloCommand}" AutomationProperties.AutomationId="Requis_Guasto_NodoVeicolo_Button" />
                            <Button Classes="Link" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DtcNodoEcuBtn}" Command="{Binding AggiungiNodoEcuCommand}" AutomationProperties.AutomationId="Requis_Guasto_NodoEcu_Button" />
                        </StackPanel>
                        <Border Classes="Banner BannerAvviso" IsVisible="{Binding HaAvvisoDtcVolume}"><TextBlock Text="{Binding AvvisoDtcVolume}" TextWrapping="Wrap" AutomationProperties.AutomationId="Requis_Guasto_Avviso_Text" /></Border>
                        <!-- Albero Sottoveicolo -> componente -> guasto: righe appiattite in una ListBox VIRTUALIZZATA (un TreeView non virtualizza e non regge 100k guasto). -->
                        <ListBox ItemsSource="{Binding AlberoDtc}" SelectedItem="{Binding NodoDtcSelezionato}" Height="260" SelectionMode="Single" AutomationProperties.AutomationId="Requis_Guasto_Albero">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="services:DtcAlberoNodo">
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="services:DtcAlberoNodo">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="{Binding Margine}">
                                        <Button Grid.Column="0" Classes="Link" MinWidth="24" Content="{Binding Freccia}" IsVisible="{Binding EIntestazione}"
                                                Command="{Binding #Root.((vm:RequisitiViewModel)DataContext).ToggleNodoDtcCommand}" CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='{}{0}_Toggle'}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Testo}" FontWeight="{Binding Peso}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ConteggioTesto}" Classes="Muted" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding AvvisoTesto, StringFormat='⚠ {0}'}" IsVisible="{Binding HaAvviso}" Margin="8,0,0,0" VerticalAlignment="Center" Classes="Muted" />
                                        <StackPanel Grid.Column="4" IsVisible="{Binding EFoglia}">
                                            <Button Classes="Link" Content="✕" IsVisible="{Binding #Root.((vm:RequisitiViewModel)DataContext).DtcModificabile}"
                                                    Command="{Binding #Root.((vm:RequisitiViewModel)DataContext).RimuoviDtcCommand}" CommandParameter="{Binding Voce}"
                                                    AutomationProperties.AutomationId="{Binding AutomationIdRimuovi}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Expander>

                <Expander Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False" IsVisible="{Binding Unione.MostraPannello}" Header="{Binding Unione.TitoloPannello}" AutomationProperties.AutomationId="RequisUnioneExpander">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnioneNessunaSelezione}" Classes="Muted" IsVisible="{Binding !Unione.HaSelezione}" />
                        <Border Classes="Banner BannerErrore" IsVisible="{Binding Unione.HaErroreOperazione}"><TextBlock Text="{Binding Unione.ErroreOperazione}" TextWrapping="Wrap" AutomationProperties.AutomationId="RequisUnioneErrore_Text" /></Border>
                        <Border Classes="Banner BannerSuccesso" IsVisible="{Binding Unione.HaMessaggioEsito}"><TextBlock Classes="BannerSuccessoTesto" Text="{Binding Unione.MessaggioEsito}" AutomationProperties.AutomationId="RequisUnioneEsito_Text" /></Border>
                        <TextBlock Text="{Binding Unione.ProgressoTesto}" Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding Unione.IsBusy}" AutomationProperties.AutomationId="RequisUnioneAvanzamento" />
                        <StackPanel Spacing="4" IsEnabled="{Binding Unione.PannelloAbilitato}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Unione.HaSelezione}">
                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Unione.AltreVociPerUnione}" SelectedItem="{Binding Unione.VocePerUnioneSelezionata}"
                                      PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnisciInPlaceholder}"
                                      AutomationProperties.AutomationId="RequisComboUnisciIn"
                                      IsVisible="{Binding Unione.AltreVociPerUnione, Converter={x:Static local:ListaEntroSogliaConverter.Instance}}" />
                            <Button Grid.Column="0" Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Unione.VocePerUnioneTesto}" Command="{Binding Unione.ScegliVocePerUnioneCommand}"
                                    IsVisible="{Binding Unione.AltreVociPerUnione, Converter={x:Static local:ListaOltreSogliaConverter.Instance}}" AutomationProperties.AutomationId="RequisBtnScegliUnisciIn" />
                            <Button Grid.Column="1" Classes="Secondary" AutomationProperties.AutomationId="RequisBtnUnisci"
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnisciBtn}"
                                    Command="{Binding Unione.UnisciSelezionataCommand}" IsEnabled="{Binding Unione.VocePerUnioneSelezionata, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Unione.HaSelezione}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding Unione.NuovoNomeRinomina}"
                                     PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterRinominaInPlaceholder}"
                                     AutomationProperties.AutomationId="RequisTextRinominaIn" />
                            <Button Grid.Column="1" Classes="Secondary" AutomationProperties.AutomationId="RequisBtnRinomina"
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterRinominaBtn}"
                                    Command="{Binding Unione.RinominaSelezionataCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Unione.HaSelezione}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding Unione.VociDivisioneTesto}"
                                     PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterDividiInPlaceholder}"
                                     AutomationProperties.AutomationId="RequisTextDividiIn" />
                            <Button Grid.Column="1" Classes="Secondary" AutomationProperties.AutomationId="RequisBtnDividi"
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterDividiBtn}"
                                    Command="{Binding Unione.DividiSelezionataCommand}" />
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <Border Classes="Banner BannerAvviso" Margin="0,12,0,0" IsVisible="{Binding Unione.MostraCoppieSospette}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnioneCoppieSospetteTitolo}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnioneCoppieSospetteSottotitolo}" Classes="Muted" FontSize="13" TextWrapping="Wrap" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Unione.CoppieSospette}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CoppiaSospettaMaster">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run Text="{Binding A}" FontWeight="SemiBold" /><Run Text=" ↔ " /><Run Text="{Binding B}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Classes="Secondary" Padding="8,4" Margin="8,0,0,0" AutomationProperties.AutomationId="RequisBtnUnisciRapido"
                                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=WuUnisciRapidoBtn}"
                                                    Command="{Binding #Root.((vm:RequisitiViewModel)DataContext).Unione.UnisciCoppiaSospettaCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>


        <DataGrid x:Name="GridPrincipale" BeginningEdit="OnGridBeginningEdit" services:TableLayoutPreferences.TableId="requirements" Grid.Row="3" MinHeight="200" Margin="0,16,0,0" ItemsSource="{Binding ItemsAttivi}" IsReadOnly="{Binding !InModifica}"
                  SelectedItem="{Binding ElementoSelezionato}"
                  RowHeight="48"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColId}" Binding="{Binding Id}" SortMemberPath="Id" Width="110" MinWidth="110" />
                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColTestoRequisito}" Binding="{Binding Testo}" Width="*" MinWidth="120" />
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TipoCampoColonna}" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Requisito">
                            <!-- Tipo fisso (6.5.1): dipende dalla lista in cui il requisito e stato creato, non modificabile. -->
                            <TextBlock Text="{Binding Converter={x:Static services:RequisitoDisplayConverter.Instance}, ConverterParameter=tipo}"
                                       VerticalAlignment="Center" Margin="8,0" AutomationProperties.AutomationId="Requis_Tipo_Label" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Tag="ColSottoveicoliD4d" Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ReqColSottoveicoliD4d}" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Requisito">
                            <Button Content="{Binding Converter={x:Static services:RequisitoDisplayConverter.Instance}, ConverterParameter=sottoveicoli}" Classes="Link"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="{Binding Converter={x:Static services:RequisitoDisplayConverter.Instance}, ConverterParameter=ambito}"
                                    Tag="{Binding}" Click="OnScegliSottoveicoli"
                                    IsEnabled="{Binding #Root.((vm:RequisitiViewModel)DataContext).InModifica}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Tag="ColVeicoliEcuD4d" Header="Veicolo / componente" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Requisito">
                            <Button Content="{Binding Converter={x:Static services:RequisitoDisplayConverter.Instance}, ConverterParameter=veicoliecu}"
                                    Classes="Link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Tag="{Binding}" Click="OnScegliVeicoliEcu"
                                    IsEnabled="{Binding #Root.((vm:RequisitiViewModel)DataContext).InModifica}"
                                    AutomationProperties.AutomationId="Requis_VeicoliEcu_Button" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColBanco}" Binding="{Binding ApplicabileBanco}" Width="64" />
                <DataGridCheckBoxColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColVeicolo}" Binding="{Binding ApplicabileVeicolo}" Width="80" />
                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColUltimaModifica}" Binding="{Binding UltimaModifica, Mode=OneWay, StringFormat={}{0:dd/MM/yy HH:mm}}" Width="150" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColDa}" Binding="{Binding ModificatoDa}" Width="100" IsReadOnly="True" />
                <DataGridTemplateColumn Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Requisito">
                            <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ArchiviaBtn}" Classes="Link"
                                    IsEnabled="{Binding #Root.((vm:RequisitiViewModel)DataContext).InModifica}"
                                    Command="{Binding #Root.((vm:RequisitiViewModel)DataContext).ArchiviaCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="Requis_RigaArchivia_Button" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Stato vuoto: sovrapposto alla griglia, non intercetta i click. -->
        <StackPanel Grid.Row="3" Classes="ElencoVuotoOverlay" Margin="0,40,0,0">
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ElencoVuoto}" Classes="Muted" HorizontalAlignment="Center" IsVisible="{Binding MostraElencoVuoto}" AutomationProperties.AutomationId="Requis_ElencoVuoto_Text" />
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ElencoVuotoFiltrato}" Classes="Muted" HorizontalAlignment="Center" IsVisible="{Binding MostraElencoVuotoFiltrato}" />
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ElencoVuotoSuggerimento}" Classes="Muted" HorizontalAlignment="Center" IsVisible="{Binding MostraSuggerimentoElencoVuoto}" />
        </StackPanel>

        <!-- Paging solo in consultazione: entrando in modifica la base ricarica il JSON completo post-lock. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding MostraControlliPaginazione}">
            <Button Content="‹" Classes="Secondary" AutomationProperties.AutomationId="Requis_PaginaPrec_Button" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListPaginaPrecedenteTip}" AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListPaginaPrecedenteTip}" Command="{Binding PaginaPrecedenteCommand}" IsEnabled="{Binding PaginaPrecedenteDisponibile}" MinWidth="42" />
            <TextBlock Text="{Binding PaginaCorrente}" AutomationProperties.AutomationId="Requis_PaginaCorrente_Text" VerticalAlignment="Center" Classes="Muted" MinWidth="28" TextAlignment="Center" />
            <Button Content="›" Classes="Secondary" AutomationProperties.AutomationId="Requis_PaginaSucc_Button" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListPaginaSuccessivaTip}" AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListPaginaSuccessivaTip}" Command="{Binding PaginaSuccessivaCommand}" IsEnabled="{Binding PaginaSuccessivaDisponibile}" MinWidth="42" />
        </StackPanel>
    </Grid>
</UserControl>
