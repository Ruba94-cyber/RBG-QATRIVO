<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:TestLoom.App.Services"
             xmlns:vm="using:TestLoom.App.ViewModels"
             xmlns:models="using:TestLoom.App.Models"
             xmlns:svc="using:TestLoom.App.Services"
             xmlns:local="using:TestLoom.App"
             xmlns:localview="using:TestLoom.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="TestLoom.App.Views.TestCaseEditorView"
             x:DataType="vm:TestCaseEditorViewModel"
             x:Name="Root">

    <!-- Perf 6.4.0 (richiesta utente 2026-09-25, apertura Test 2,7-3,2s a caldo/18535 visuali): il
         DataTemplate di models:CampoStrumentoValore era duplicato 8 volte in questo file, e ognuna
         materializzava SEMPRE i controlli di TUTTI i Tipo possibili (Testo/Numero/Lista/Checkbox/Data/
         File/ListaTesto), nascondendo tutti tranne uno con IsVisible+TipoCampoEqualsConverter. Tipo è
         get-only (immutabile per istanza, Models/TestCase.cs) quindi il ramo giusto si conosce una volta
         sola, alla costruzione. I sotto-template CampoValoreCampo* qui sotto contengono SOLO il controllo
         di un singolo Tipo (nessun IsVisible sul Tipo, quello lo decide localview:CampoValoreEditorSelector
         scegliendo quale COSTRUIRE, non quale nascondere); i template CampoValoreSelector* le raggruppano
         per le 3 combinazioni realmente distinte di Tipo disponibili nell'editor; i template
         CampoValoreItemTemplate* aggiungono l'intestazione (Nome, eventuale pulsante "Ricorda come mio
         default") per le 4 combinazioni realmente distinte di intestazione+corpo usate nel file (5 dei 8
         punti di utilizzo condividono la stessa combinazione "intestazione semplice + corpo senza
         ListaTesto" e riusano perciò lo stesso CampoValoreItemTemplateSemplice). Stessi binding/comandi/
         Classes/AutomationId di prima in ogni ramo — cambia solo QUANTI controlli vengono costruiti per
         ogni campo. -->
    <UserControl.Styles>
        <Style Selector="Button.Esito:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.Esito">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.Esito.ok:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#CDEBD6" /></Style>
        <Style Selector="Button.Esito.ok.on /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1E8E3E" /><Setter Property="TextElement.Foreground" Value="White" /></Style>
        <Style Selector="Button.Esito.nok.on /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#D93025" /><Setter Property="TextElement.Foreground" Value="White" /></Style>
        <Style Selector="Button.Esito.dev.on /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#F29900" /><Setter Property="TextElement.Foreground" Value="Black" /></Style>
        <Style Selector="Button.Esito.na.on /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#6B7280" /><Setter Property="TextElement.Foreground" Value="White" /></Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <DataTemplate x:Key="CampoValoreCampoTesto" x:DataType="models:CampoStrumentoValore">
            <TextBox Classes="Field" Text="{Binding Valore}" AutomationProperties.AutomationId="{Binding Nome, StringFormat='Editor_Campo_{0}'}" />
        </DataTemplate>

        <!-- Evidenziazione (feedback utente 2026-08-24, punto 8): tasto destro per marcare l'intero campo,
             solo dentro un'operazione (PerOperazione) — nessun pulsante dedicato in più. -->
        <DataTemplate x:Key="CampoValoreCampoTestoEvidenziato" x:DataType="models:CampoStrumentoValore">
            <TextBox Classes="Field" Text="{Binding Valore}" AutomationProperties.AutomationId="{Binding Nome, StringFormat='Editor_Campo_{0}'}"
                     Background="{Binding Colore, Converter={x:Static local:ColoreEvidenziazioneBrushConverter.Instance}}">
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaNessuna}" Tag="Nessuno" Click="OnImpostaColoreEvidenziato" />
                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaGiallo}" Tag="Giallo" Click="OnImpostaColoreEvidenziato" />
                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaRosso}" Tag="Rosso" Click="OnImpostaColoreEvidenziato" />
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
        </DataTemplate>

        <DataTemplate x:Key="CampoValoreCampoNumero" x:DataType="models:CampoStrumentoValore">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Classes="Field" Text="{Binding Valore}" AutomationProperties.AutomationId="{Binding Nome, StringFormat='Editor_Campo_{0}'}" />
                <TextBlock Grid.Column="1" Text="{Binding UnitaMisura}" IsVisible="{Binding HaUnitaMisura}" VerticalAlignment="Center" Margin="6,0,0,0" Classes="Muted" />
            </Grid>
        </DataTemplate>

        <!-- ComboBox (sotto soglia) + Button (sopra soglia, apre un dialog di scelta): entrambi materializzati
             insieme oggi dietro un IsVisible su ListaEntroSogliaConverter/ListaOltreSogliaConverter — invariato
             qui (dipende da OpzioniLista.Count a runtime, non da Tipo, quindi non eliminabile con questo
             selector; vedi nota nel report finale). -->
        <DataTemplate x:Key="CampoValoreCampoLista" x:DataType="models:CampoStrumentoValore">
            <StackPanel Spacing="4">
                <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding OpzioniVisualizzate}" SelectedItem="{Binding Valore}" IsVisible="{Binding OpzioniLista, Converter={x:Static local:ListaEntroSogliaConverter.Instance}}" AutomationProperties.AutomationId="{Binding Nome, StringFormat='Editor_Campo_{0}'}" />
                <Button Classes="Field" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Valore, TargetNullValue='—'}" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).ScegliOpzioneListaCommand}" CommandParameter="{Binding}" IsVisible="{Binding OpzioniLista, Converter={x:Static local:ListaOltreSogliaConverter.Instance}}" AutomationProperties.AutomationId="{Binding Nome, StringFormat='Editor_Campo_{0}_Scegli'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CampoValoreCampoCheckbox" x:DataType="models:CampoStrumentoValore">
            <ToggleSwitch IsChecked="{Binding ValoreCheckboxVisual, Mode=TwoWay}" OnContent="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=SiLabel}" OffContent="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NoLabel}" AutomationProperties.AutomationId="{Binding Nome, StringFormat='Editor_Campo_{0}'}" />
        </DataTemplate>

        <DataTemplate x:Key="CampoValoreCampoData" x:DataType="models:CampoStrumentoValore">
            <CalendarDatePicker Classes="Field" HorizontalAlignment="Stretch" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DataPlaceholder}"
                                SelectedDate="{Binding Valore, Converter={x:Static local:DataTestoConverter.Instance}}" AutomationProperties.AutomationId="{Binding Nome, StringFormat='Editor_Campo_{0}'}" />
        </DataTemplate>

        <DataTemplate x:Key="CampoValoreCampoFile" x:DataType="models:CampoStrumentoValore">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Valore}" IsVisible="{Binding Valore, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextTrimming="CharacterEllipsis" Classes="Muted" />
                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NessunFileCollegato}" IsVisible="{Binding Valore, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" Classes="Muted" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ScegliFileBtn}" Classes="Link" Padding="0" FontSize="13" Click="OnScegliFileCampoStrumento" Tag="{Binding}" AutomationProperties.AutomationId="{Binding Nome, StringFormat='Editor_Campo_{0}_ScegliFile'}" />
                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ApriFileBtn}" Classes="Link" Padding="0" FontSize="13" IsVisible="{Binding Valore, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).ApriFileCampoStrumentoCommand}" CommandParameter="{Binding}" />
                    <Button Content="✕" Classes="Link" Padding="0" FontSize="13" IsVisible="{Binding Valore, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviFileCampoStrumentoCommand}" CommandParameter="{Binding}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ListaTesto (punto 8): righe di testo libero con evidenziazione per riga — editor dedicato, vedi
             ListaTestoEditorWindow. -->
        <DataTemplate x:Key="CampoValoreCampoListaTesto" x:DataType="models:CampoStrumentoValore">
            <Button Classes="Field" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Content="{Binding RigheListaTestoConteggio, Converter={x:Static local:ModificaListaTestoLabelConverter.Instance}}"
                    Click="OnModificaListaTesto" Tag="{Binding}" AutomationProperties.AutomationId="{Binding Nome, StringFormat='Editor_Campo_{0}'}" />
        </DataTemplate>

        <!-- 3 combinazioni realmente distinte di Tipo disponibili nell'editor (vedi CampoValoreEditorSelector:
             un Tipo senza template impostato non materializza nulla, come un IsVisible sempre falso prima). -->
        <localview:CampoValoreEditorSelector x:Key="CampoValoreSelectorSemplice"
            TestoTemplate="{StaticResource CampoValoreCampoTesto}"
            NumeroTemplate="{StaticResource CampoValoreCampoNumero}"
            ListaTemplate="{StaticResource CampoValoreCampoLista}"
            CheckboxTemplate="{StaticResource CampoValoreCampoCheckbox}"
            DataCampoTemplate="{StaticResource CampoValoreCampoData}"
            FileTemplate="{StaticResource CampoValoreCampoFile}" />

        <localview:CampoValoreEditorSelector x:Key="CampoValoreSelectorConListaTesto"
            TestoTemplate="{StaticResource CampoValoreCampoTesto}"
            NumeroTemplate="{StaticResource CampoValoreCampoNumero}"
            ListaTemplate="{StaticResource CampoValoreCampoLista}"
            CheckboxTemplate="{StaticResource CampoValoreCampoCheckbox}"
            DataCampoTemplate="{StaticResource CampoValoreCampoData}"
            FileTemplate="{StaticResource CampoValoreCampoFile}"
            ListaTestoTemplate="{StaticResource CampoValoreCampoListaTesto}" />

        <localview:CampoValoreEditorSelector x:Key="CampoValoreSelectorCondizione"
            TestoTemplate="{StaticResource CampoValoreCampoTestoEvidenziato}"
            NumeroTemplate="{StaticResource CampoValoreCampoNumero}"
            ListaTemplate="{StaticResource CampoValoreCampoLista}"
            CheckboxTemplate="{StaticResource CampoValoreCampoCheckbox}"
            DataCampoTemplate="{StaticResource CampoValoreCampoData}"
            FileTemplate="{StaticResource CampoValoreCampoFile}"
            ListaTestoTemplate="{StaticResource CampoValoreCampoListaTesto}" />

        <!-- 4 combinazioni realmente distinte di intestazione+corpo (5 degli 8 punti di utilizzo nel file
             condividono "intestazione semplice + corpo senza ListaTesto" e riusano CampoValoreItemTemplateSemplice). -->
        <DataTemplate x:Key="CampoValoreItemTemplateSemplice" x:DataType="models:CampoStrumentoValore">
            <StackPanel Spacing="4" Margin="0,0,16,12" MinWidth="240" MaxWidth="340">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ToolTip.Tip="{Binding Nome}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding ConfermaDefaultSalvato}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultSalvatoConferma}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding MostraEtichettaDefaultPersonale}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultPersonaleEtichetta}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding EDefaultMaster}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultMasterEtichetta}" />
                        <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicordaComeMioDefaultBtn}" Classes="Link" Padding="0" FontSize="12"
                                IsVisible="{Binding MostraRicordaDefault}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).SalvaValoreComeMioDefaultCommand}" CommandParameter="{Binding CampoPerRicordareDefault}"
                                AutomationProperties.AutomationId="{Binding AutomationIdRicordaDefault}"
                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicordaComeMioDefaultTooltip}" />
                        <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviMioDefaultBtn}" Classes="Link" Padding="0" FontSize="12"
                                IsVisible="{Binding MostraRimuoviDefault}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviMioDefaultCommand}" CommandParameter="{Binding CampoPerRicordareDefault}"
                                AutomationProperties.AutomationId="{Binding AutomationIdRimuoviDefault}"
                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviMioDefaultTooltip}" />
                    </StackPanel>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CampoValoreSelectorSemplice}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CampoValoreItemTemplateConDefault" x:DataType="models:CampoStrumentoValore">
            <StackPanel Spacing="4" Margin="0,0,16,12" MinWidth="240" MaxWidth="340">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ToolTip.Tip="{Binding Nome}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding ConfermaDefaultSalvato}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultSalvatoConferma}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding MostraEtichettaDefaultPersonale}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultPersonaleEtichetta}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding EDefaultMaster}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultMasterEtichetta}" />
                        <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicordaComeMioDefaultBtn}" Classes="Link" Padding="0" FontSize="12"
                                IsVisible="{Binding MostraRicordaDefault}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).SalvaValoreComeMioDefaultCommand}" CommandParameter="{Binding CampoPerRicordareDefault}"
                                AutomationProperties.AutomationId="{Binding AutomationIdRicordaDefault}"
                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicordaComeMioDefaultTooltip}" />
                        <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviMioDefaultBtn}" Classes="Link" Padding="0" FontSize="12"
                                IsVisible="{Binding MostraRimuoviDefault}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviMioDefaultCommand}" CommandParameter="{Binding CampoPerRicordareDefault}"
                                AutomationProperties.AutomationId="{Binding AutomationIdRimuoviDefault}"
                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviMioDefaultTooltip}" />
                    </StackPanel>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CampoValoreSelectorSemplice}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CampoValoreItemTemplateConDefaultEListaTesto" x:DataType="models:CampoStrumentoValore">
            <StackPanel Spacing="4" Margin="0,0,16,12" MinWidth="240" MaxWidth="340">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ToolTip.Tip="{Binding Nome}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding ConfermaDefaultSalvato}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultSalvatoConferma}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding MostraEtichettaDefaultPersonale}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultPersonaleEtichetta}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding EDefaultMaster}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultMasterEtichetta}" />
                        <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicordaComeMioDefaultBtn}" Classes="Link" Padding="0" FontSize="12"
                                IsVisible="{Binding MostraRicordaDefault}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).SalvaValoreComeMioDefaultCommand}" CommandParameter="{Binding CampoPerRicordareDefault}"
                                AutomationProperties.AutomationId="{Binding AutomationIdRicordaDefault}"
                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicordaComeMioDefaultTooltip}" />
                        <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviMioDefaultBtn}" Classes="Link" Padding="0" FontSize="12"
                                IsVisible="{Binding MostraRimuoviDefault}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviMioDefaultCommand}" CommandParameter="{Binding CampoPerRicordareDefault}"
                                AutomationProperties.AutomationId="{Binding AutomationIdRimuoviDefault}"
                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviMioDefaultTooltip}" />
                    </StackPanel>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CampoValoreSelectorConListaTesto}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CampoValoreItemTemplateCondizione" x:DataType="models:CampoStrumentoValore">
            <StackPanel Spacing="4" Margin="0,0,16,12" MinWidth="240" MaxWidth="340">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ToolTip.Tip="{Binding Nome}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding ConfermaDefaultSalvato}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultSalvatoConferma}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding MostraEtichettaDefaultPersonale}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultPersonaleEtichetta}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding EDefaultMaster}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultMasterEtichetta}" />
                        <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicordaComeMioDefaultBtn}" Classes="Link" Padding="0" FontSize="12"
                                IsVisible="{Binding MostraRicordaDefault}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).SalvaValoreComeMioDefaultCommand}" CommandParameter="{Binding CampoPerRicordareDefault}"
                                AutomationProperties.AutomationId="{Binding AutomationIdRicordaDefault}"
                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicordaComeMioDefaultTooltip}" />
                        <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviMioDefaultBtn}" Classes="Link" Padding="0" FontSize="12"
                                IsVisible="{Binding MostraRimuoviDefault}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviMioDefaultCommand}" CommandParameter="{Binding CampoPerRicordareDefault}"
                                AutomationProperties.AutomationId="{Binding AutomationIdRimuoviDefault}"
                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviMioDefaultTooltip}" />
                    </StackPanel>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CampoValoreSelectorCondizione}" />
            </StackPanel>
        </DataTemplate>
                                    <DataTemplate x:Key="OperazioneCardCompleta" x:DataType="models:Condizione">
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,2,0,8">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="2*,*,Auto,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <!-- Strumento proprietario dell'operazione (6.5.1): assente = operazione legacy/manuale. -->
                                                    <TextBlock Text="{Binding Strumento, StringFormat='🛠 {0}'}" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding Strumento, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                               AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Strumento_Text'}" />
                                                    <!-- Distingue a colpo d'occhio l'operazione ripetuta dall'originale, mostrando DA QUALE
                                                         operazione deriva e il numero del tentativo (feedback utente 2026-08-24, seconda
                                                         revisione): un badge generico "ripetizione" non bastava con più tentativi sulla
                                                         stessa operazione, che restavano indistinguibili tra loro (stesso Etichetta copiato
                                                         dall'origine da Ripeti). -->
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding OperazioneOrigineUid, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static local:EtichettaRipetizioneConverter.Instance}">
                                                                <Binding />
                                                                <Binding Path="#Root.((vm:TestCaseEditorViewModel)DataContext).CondizioniVisual" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <!-- A quale/i componente (tra quelle collegate al test) appartiene QUESTA operazione (feedback utente
                                                         2026-08-25, punto 9): nasce con tutti i componenti del test preselezionate (o l'unica, se il test
                                                         ne ha una sola), l'operatore restringe qui solo dove serve. Multi-selezione con flyout a
                                                         checkbox, stesso schema di EcuView.OnScegliVeicoli — niente dialog modale per ogni singola
                                                         operazione. -->
                                                    <Button Classes="Field" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Content="{Binding Componente, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=EcuCondizionePlaceholder}"
                                                            Click="OnScegliEcuCondizione" Tag="{Binding}" />
                                                    <!-- Etichetta libera sostituita da un selettore Funzionalità (feedback utente 2026-08-24, terza
                                                         revisione): quale Funzionalità (tra quelle collegate al test) sta verificando QUESTA
                                                         operazione, per sapere quale fallisce quando un test ne copre più di una insieme e per
                                                         calcolare la copertura per-Funzionalità sull'operazione invece che sull'esito aggregato
                                                         dell'intero test. Sempre visibile ed esplicito anche con una sola Funzionalità collegata. -->
                                                    <ComboBox Classes="Field" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=FunzionalitaCondizionePlaceholder}"
                                                              AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Funzionalita_Combo'}"
                                                              SelectedItem="{Binding Funzionalita, Mode=OneWay}"
                                                              ItemsSource="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).FunzionalitaOperazioniDisponibili}"
                                                              SelectionChanged="OnFunzionalitaOperazioneModificata"
                                                              IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).FunzionalitaOperazioneObbligatoria}">
                                                        <!-- 6.5.2: la Funzionalita non compare sulle operazioni guasto dello strumento guasto Injection, ne in un test con
                                                             guasto Injection senza strumento Da testare; resta sulle operazioni degli strumenti Da testare e libere. -->
                                                        <ComboBox.IsVisible>
                                                            <MultiBinding Converter="{x:Static local:FunzionalitaRigaVisibileConverter.Instance}">
                                                                <Binding Path="Strumento" />
                                                                <Binding Path="#Root.((vm:TestCaseEditorViewModel)DataContext).SoloOperazioniDtc" />
                                                                <Binding Path="#Root.((vm:TestCaseEditorViewModel)DataContext).StrumentiDaTestareNomi" />
                                                            </MultiBinding>
                                                        </ComboBox.IsVisible>
                                                    </ComboBox>
                                                    <!-- 6.5.0 punto 7: operazione guasto (solo template "Funzionalita non obbligatoria"). SelectedItem OneWay
                                                         come per la Funzionalita: solo una scelta concreta dell'utente viene scritta nel modello. -->
                                                    <TextBlock Text="{Binding DtcAvviso}" IsVisible="{Binding HaDtcAvviso}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                                                               AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DtcAvviso_Text'}" />
                                                    <StackPanel Spacing="2" IsVisible="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).MostraDtcOperazione}">
                                                        <!-- Operazioni guasto di proprieta dello strumento (blocco "Aggiungi guasto"): componente/requisito/rimozione si gestiscono dal blocco. -->
                                                        <StackPanel Spacing="2" IsVisible="{Binding !DtcDaStrumento}">
                                                        <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                                                  PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcOperazionePlaceholder}"
                                                                  SelectedItem="{Binding DtcEtichetta, Mode=OneWay}"
                                                                  ItemsSource="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).DtcOpzioniPiccole}"
                                                                  SelectionChanged="OnDtcOperazioneModificata"
                                                                  IsVisible="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).DtcMostraCombo}"
                                                                  AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Guasto_Combo'}" />
                                                        <!-- Strumento guasto Injection: codice guasto digitato (formato validato), abbinato al Extra per codice+componente. -->
                                                        <StackPanel IsVisible="{Binding DtcLegacy}">
                                                        <TextBox Classes="Field" HorizontalAlignment="Stretch" Text="{Binding Guasto, Mode=OneWay}"
                                                                 PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcCodiceLiberoPlaceholder}"
                                                                 IsVisible="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).MostraDtcCodiceLibero}"
                                                                 LostFocus="OnDtcCodiceLiberoCommit" KeyDown="OnDtcCodiceLiberoKeyDown"
                                                                 AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DtcCodice_Text'}" />
                                                        </StackPanel>
                                                        <!-- Elenco guasto grande (oltre soglia, fino a 100k): picker con ricerca invece della ComboBox. -->
                                                        <Button Classes="Field" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                Content="{Binding DtcEtichetta, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=DtcOperazionePlaceholder}"
                                                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).ScegliDtcOperazioneCommand}" CommandParameter="{Binding}"
                                                                IsVisible="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).DtcMostraPicker}"
                                                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Guasto_Scegli_Button'}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding DtcDaStrumento}">
                                                            <TextBlock Text="{Binding Guasto}" FontWeight="SemiBold" AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DtcGestito_Text'}" />
                                                            <TextBlock Text="{Binding DtcPasso, Converter={x:Static local:PassoDtcLabelConverter.Instance}}" Classes="Muted" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DtcStatoTesto}" Classes="Muted" FontSize="12" IsVisible="{Binding RiguardaDtc}" TextWrapping="Wrap"
                                                                   AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DtcStato_Text'}" />
                                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding DtcLegacy}">
                                                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                                                      SelectedItem="{Binding DtcPasso, Mode=OneWay}"
                                                                      ItemsSource="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PassiDtc}"
                                                                      SelectionChanged="OnPassoDtcModificato"
                                                                      AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DtcPasso_Combo'}">
                                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static local:PassoDtcLabelConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button Grid.Column="1" Classes="Link" Margin="8,0,0,0" Tag="{Binding}" Click="OnRimuoviDtcOperazione"
                                                                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcRimuoviBtn}"
                                                                    AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DtcRimuovi_Button'}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EsitoObblLabel}" Classes="Muted" FontSize="12" />
                                                    <ComboBox Classes="Field" ItemsSource="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).EsitiTecnici}" SelectedItem="{Binding Esito}" AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Esito_Combo'}">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static local:EsitoLabelConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <!-- Quick workflow: frequent outcomes are one click; N.A. and Da eseguire
                                                         remain in the unchanged selector, preserving all states and
                                                         the Complete editor. The commands update the same Condizione. -->
                                                    <!-- TIME (6.6.1): durata manuale in minuti per ogni operazione e tipo di Test; vuoto = non nota, 0 = zero noto. -->
                                                    <TextBlock Margin="0,6,0,0" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DurataOperazioneLabel}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding DurataTesto.HaErrore}"
                                                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DurataNonValidaMsg}"
                                                           AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Durata_Errore'}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4" AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Durata_Pannello'}">
                                                        <Button Classes="Secondary" Content="-5" Width="48" CommandParameter="{Binding}"
                                                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).DecrementaDurataOperazioneCommand}"
                                                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DurataMeno5_Button'}" />
                                                        <TextBox Classes="Field" Width="96" Text="{Binding DurataTesto.Testo, Mode=TwoWay}"
                                                                 PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DurataPlaceholder}"
                                                                 AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Durata_TextBox'}" />
                                                        <Button Classes="Secondary" Content="+5" Width="48" CommandParameter="{Binding}"
                                                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).IncrementaDurataOperazioneCommand}"
                                                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DurataPiu5_Button'}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- I due log UnitLogger hanno import separati: WU per l'operazione, main per i dati sessione. -->
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                    <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=CopiaDallaPrecedenteBtn}" Classes="Link" CommandParameter="{Binding}"
                                                            Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).CopiaCampiDallaPrecedenteOperazioneCommand}"
                                                            ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=CopiaDallaPrecedenteTip}"
                                                            AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_CopiaDallaPrecedente_Button'}">
                                                        <!-- Sulla prima operazione della revisione non c'e' nulla da copiare: il pulsante e' nascosto, non disabilitato. -->
                                                        <Button.IsVisible>
                                                            <MultiBinding Converter="{x:Static local:NonPrimaCondizioneConverter.Instance}">
                                                                <Binding Path="Uid" />
                                                                <Binding Path="#Root.((vm:TestCaseEditorViewModel)DataContext).UidPrimaCondizione" />
                                                            </MultiBinding>
                                                        </Button.IsVisible>
                                                    </Button>
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RipetiBtn}" Classes="Link" Margin="8,0,0,0" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RipetiCondizioneCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Ripeti_Button'}" />
                                                <Button Grid.Column="4" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviXBtn}" Classes="Link" Margin="8,0,0,0" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviCondizioneCommand}" CommandParameter="{Binding}" IsVisible="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).HaPiuDiUnaCondizione}" AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Rimuovi_Button'}" />
                                            </Grid>

                                            <!-- Optional technical details; expanded automatically in Full and read-only. -->
                                            <Expander x:Name="ParametriOperazioneExpander" Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickToolFields}"
                                                      IsExpanded="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).EspandiParametriOperazione, Mode=OneWay}"
                                                      AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Parametri_Expander'}">
                                                <StackPanel Spacing="8" Margin="0,6,0,4">
                                            <!-- Campi degli strumenti selezionati (ValidationTool/CaptureTool/altri), configurabili da Impostazioni →
                                                 Strumenti: compaiono/spariscono con lo strumento, layout a griglia che si adatta alla
                                                 larghezza invece di 3 colonne fisse strette (Addendum redesign 2026-08, revisione feedback QA). -->
                                            <ItemsControl ItemTemplate="{StaticResource CampoValoreItemTemplateCondizione}">
                                                <!-- Avalonia Expander is not lazy: defer expensive tool-field controls until actually expanded. -->
                                                <ItemsControl.ItemsSource>
                                                    <MultiBinding Converter="{x:Static localview:CampiSeEspansoConverter.Instance}">
                                                        <Binding Path="CampiVisual" />
                                                        <Binding Path="#ParametriOperazioneExpander.IsExpanded" />
                                                    </MultiBinding>
                                                </ItemsControl.ItemsSource>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <!-- Campi raggruppati (es. guasto Injection di ValidationTool: non il punto principale delle prove,
                                                 dietro tendina collassata come prima della migrazione al sistema generico) -->
                                            <ItemsControl>
                                                <!-- Avoid materializing nested group expanders when the Quick operation is collapsed. -->
                                                <ItemsControl.ItemsSource>
                                                    <MultiBinding Converter="{x:Static localview:CampiSeEspansoConverter.Instance}">
                                                        <Binding Path="GruppiVisual" />
                                                        <Binding Path="#ParametriOperazioneExpander.IsExpanded" />
                                                    </MultiBinding>
                                                </ItemsControl.ItemsSource>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:GruppoCampiStrumento">
                                                        <Expander x:Name="GruppoCampiExpanderCondizione" Header="{Binding Nome}" IsExpanded="False" Margin="0,0,0,8" ToolTip.Tip="{Binding Nome}">
                                                            <ItemsControl Margin="0,8,0,0" ItemTemplate="{StaticResource CampoValoreItemTemplateSemplice}">
                                                                <ItemsControl.ItemsSource>
                                                                    <MultiBinding Converter="{x:Static localview:CampiSeEspansoConverter.Instance}">
                                                                        <Binding Path="Campi" />
                                                                        <Binding Path="#GruppoCampiExpanderCondizione.IsExpanded" />
                                                                    </MultiBinding>
                                                                </ItemsControl.ItemsSource>
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Evidenziazione (feedback utente 2026-08-24, punto 8): tasto destro sul campo per marcarlo
                                                 giallo/rosso, solo qui dentro un'operazione — nessun pulsante dedicato in più, il colore si
                                                 vede subito nello sfondo del campo (ColoreEvidenziazioneBrushConverter). -->
                                            <TextBox Classes="Field" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=MotivazioneObblNA}" Text="{Binding MotivazioneNonApplicabile}" IsVisible="{Binding RichiedeMotivazioneNonApplicabile}"
                                                     AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_MotivazioneNA_TextBox'}"
                                                     Background="{Binding ColoreMotivazioneNonApplicabile, Converter={x:Static local:ColoreEvidenziazioneBrushConverter.Instance}}">
                                                <TextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaNessuna}" Tag="MotivazioneNonApplicabile|Nessuno" Click="OnImpostaColoreCondizione" />
                                                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaGiallo}" Tag="MotivazioneNonApplicabile|Giallo" Click="OnImpostaColoreCondizione" />
                                                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaRosso}" Tag="MotivazioneNonApplicabile|Rosso" Click="OnImpostaColoreCondizione" />
                                                    </ContextMenu>
                                                </TextBox.ContextMenu>
                                            </TextBox>
                                            <TextBox Classes="Field" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TcDescrizioneDeviazionePlaceholder}" Text="{Binding DescrizioneDeviazione}" IsVisible="{Binding RichiedeDescrizioneDeviazione}"
                                                     AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DescrizioneDeviazione_TextBox'}"
                                                     Background="{Binding ColoreDescrizioneDeviazione, Converter={x:Static local:ColoreEvidenziazioneBrushConverter.Instance}}">
                                                <TextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaNessuna}" Tag="DescrizioneDeviazione|Nessuno" Click="OnImpostaColoreCondizione" />
                                                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaGiallo}" Tag="DescrizioneDeviazione|Giallo" Click="OnImpostaColoreCondizione" />
                                                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaRosso}" Tag="DescrizioneDeviazione|Rosso" Click="OnImpostaColoreCondizione" />
                                                    </ContextMenu>
                                                </TextBox.ContextMenu>
                                            </TextBox>
                                            <TextBox Classes="Field" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TcProblemaOsservatoPlaceholder}" Text="{Binding DescrizioneProblema}" IsVisible="{Binding RichiedeDescrizioneProblema}"
                                                     AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_DescrizioneProblema_TextBox'}"
                                                     Background="{Binding ColoreDescrizioneProblema, Converter={x:Static local:ColoreEvidenziazioneBrushConverter.Instance}}">
                                                <TextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaNessuna}" Tag="DescrizioneProblema|Nessuno" Click="OnImpostaColoreCondizione" />
                                                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaGiallo}" Tag="DescrizioneProblema|Giallo" Click="OnImpostaColoreCondizione" />
                                                        <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaRosso}" Tag="DescrizioneProblema|Rosso" Click="OnImpostaColoreCondizione" />
                                                    </ContextMenu>
                                                </TextBox.ContextMenu>
                                            </TextBox>

                                            <!-- Nota propria di questa reiterazione (Addendum redesign 2026-08) -->
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NotaReiterazioneLabel}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBox Classes="Field" Text="{Binding Nota}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="150" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Nota_TextBox'}"
                                                         Background="{Binding ColoreNota, Converter={x:Static local:ColoreEvidenziazioneBrushConverter.Instance}}">
                                                    <TextBox.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaNessuna}" Tag="Nota|Nessuno" Click="OnImpostaColoreCondizione" />
                                                            <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaGiallo}" Tag="Nota|Giallo" Click="OnImpostaColoreCondizione" />
                                                            <MenuItem Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenziaRosso}" Tag="Nota|Rosso" Click="OnImpostaColoreCondizione" />
                                                        </ContextMenu>
                                                    </TextBox.ContextMenu>
                                                </TextBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
    <DataTemplate x:Key="OperazioneRigaRapida" x:DataType="models:Condizione">
        <Border DragDrop.AllowDrop="True" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2,0,6"
                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Riga'}">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static localview:RigaVisibileFiltroConverter.Instance}">
                    <Binding Path="#Root.((vm:TestCaseEditorViewModel)DataContext).SoloDaEseguireRapido" />
                    <Binding Path="Esito" />
                </MultiBinding>
            </Border.IsVisible>
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <ToggleButton x:Name="Espandi" Grid.Column="0" Classes="Link" Padding="4,2" Margin="0,0,10,0" Content="..." ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOperationDetails}"
                                  AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_Espandi_Button'}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,10,0">
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Funzionalita}" />
                        <TextBlock Classes="Muted" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Strumento}"
                                   IsVisible="{Binding Strumento, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Classes="Esito ok" Classes.on="{Binding Esito, Converter={x:Static localview:EsitoUgualeConverter.Instance}, ConverterParameter=Conforme}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).EsitoRapidoConformeCommand}" CommandParameter="{Binding}"
                                IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PuoModificareContenuto}"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOutcomeOk}" ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOutcomeOkHelp}"
                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickOk_Button'}" />
                        <Button Classes="Esito nok" Classes.on="{Binding Esito, Converter={x:Static localview:EsitoUgualeConverter.Instance}, ConverterParameter=NonConforme}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).EsitoRapidoNonConformeCommand}" CommandParameter="{Binding}"
                                IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PuoModificareContenuto}"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOutcomeNok}" ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOutcomeNokHelp}"
                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickNok_Button'}" />
                        <Button Classes="Esito dev" Classes.on="{Binding Esito, Converter={x:Static localview:EsitoUgualeConverter.Instance}, ConverterParameter=ConformeConDeviazioni}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).EsitoRapidoDeviazioneCommand}" CommandParameter="{Binding}"
                                IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PuoModificareContenuto}"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOutcomeDeviation}" ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOutcomeDeviationHelp}"
                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickDeviation_Button'}" />
                        <Button Classes="Esito na" Classes.on="{Binding Esito, Converter={x:Static localview:EsitoUgualeConverter.Instance}, ConverterParameter=NonApplicabile}"
                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).EsitoRapidoNonApplicabileCommand}" CommandParameter="{Binding}"
                                IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PuoModificareContenuto}"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOutcomeNa}" ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOutcomeNaHelp}"
                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickNa_Button'}" />
                    </StackPanel>
                    <TextBox Grid.Column="3" Classes="Field" Width="72" VerticalAlignment="Center" Margin="0,0,10,0" Text="{Binding DurataTesto.Testo, Mode=TwoWay}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DurataPlaceholder}"
                             AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickDurata_TextBox'}" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="Muted" VerticalAlignment="Center" IsVisible="{Binding HaEvidenze}" Text="{Binding NumeroEvidenze, StringFormat='[{0}]'}"
                                   AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_EvidenzeCount_Text'}" />
                        <Button Classes="Link" Padding="4,2" Content="+file" Click="OnSceglieFileOperazione" ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenzaOperazioneScegli}"
                                IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PuoModificareContenuto}"
                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_EvidenzaFile_Button'}" />
                        <Button Classes="Link" Padding="4,2" Content="+img" Click="OnIncollaScreenshotOperazione" ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPasteScreenshotTestHelp}"
                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickPasteScreenshot_Button'}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{x:Static local:TuttiVeriConverter.Instance}">
                                    <Binding Path="#Root.((vm:TestCaseEditorViewModel)DataContext).PuoModificareContenuto" />
                                    <Binding Path="#Root.((vm:TestCaseEditorViewModel)DataContext).TestRichiedeEcu" Converter="{x:Static conv:BoolConverters.Not}" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>
                        <Button Classes="Link" Padding="4,2" Tag="Anomalie" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickAnomalyFollowUp}"
                                AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickAnomalyLink_Button'}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static local:TuttiVeriConverter.Instance}">
                                    <Binding Path="RichiedeGestioneSegnalazione" />
                                    <Binding Path="#Root.((vm:TestCaseEditorViewModel)DataContext).PuoModificareContenuto" />
                                </MultiBinding>
                            </Button.IsVisible>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Collassata: solo nota e, quando l'esito la richiede, la motivazione nel punto giusto. Espansa: la scheda completa. -->
                <StackPanel Spacing="6" IsVisible="{Binding !#Espandi.IsChecked}">
                    <TextBox Classes="Field" Text="{Binding Nota}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NotaReiterazioneLabel}"
                             AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickNota_TextBox'}">
                        <TextBox.InnerLeftContent><TextBlock Margin="8,0,4,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickNoteShort}" /></TextBox.InnerLeftContent>
                    </TextBox>
                    <TextBox Classes="Field" Text="{Binding MotivazioneNonApplicabile}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=MotivazioneObblNA}" IsVisible="{Binding RichiedeMotivazioneNonApplicabile}"
                             AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickMotivazioneNA_TextBox'}">
                        <TextBox.InnerLeftContent><TextBlock Margin="8,0,4,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickReasonNa}" /></TextBox.InnerLeftContent>
                    </TextBox>
                    <TextBox Classes="Field" Text="{Binding DescrizioneDeviazione}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TcDescrizioneDeviazionePlaceholder}" IsVisible="{Binding RichiedeDescrizioneDeviazione}"
                             AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickDescrizioneDeviazione_TextBox'}">
                        <TextBox.InnerLeftContent><TextBlock Margin="8,0,4,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickReasonDeviation}" /></TextBox.InnerLeftContent>
                    </TextBox>
                    <TextBox Classes="Field" Text="{Binding DescrizioneProblema}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TcProblemaOsservatoPlaceholder}" IsVisible="{Binding RichiedeDescrizioneProblema}"
                             AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Condizione_{0}_QuickDescrizioneProblema_TextBox'}">
                        <TextBox.InnerLeftContent><TextBlock Margin="8,0,4,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickReasonProblem}" /></TextBox.InnerLeftContent>
                    </TextBox>
                </StackPanel>
                <ContentControl ContentTemplate="{StaticResource OperazioneCardCompleta}">
                    <ContentControl.Content>
                        <MultiBinding Converter="{x:Static localview:ContenutoSeVeroConverter.Instance}">
                            <Binding />
                            <Binding Path="#Espandi.IsChecked" />
                        </MultiBinding>
                    </ContentControl.Content>
                </ContentControl>
            </StackPanel>
        </Border>
    </DataTemplate>
</UserControl.Resources>

    <Grid RowDefinitions="Auto,*" IsEnabled="{Binding InterazioneEditorAbilitata}">
    <!-- Barra sempre visibile: stato del documento, salto alle sezioni e azioni principali restano
         raggiungibili anche nei test molto lunghi. -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,10" ZIndex="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
            <!-- Salto alle sezioni (scroll): resta identico a prima, solo per un test ESISTENTE — su un test
                 nuovo la controparte è la striscia di schede subito sotto (Addendum: audit UX 2026-08-26,
                 punto 1, vincolo esplicito "solo in compilazione per la creazione, non in modifica o
                 visualizzazione"). -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding MostraLinkSezioni}">
                <Button Classes="Link" Padding="7,4" Tag="Pianificazione" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=WorkflowContestoTitolo}" />
                <Button Classes="Link" Padding="7,4" Tag="Dettagli" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DettagliTitolo}" />
                <Button Classes="Link" Padding="7,4" Tag="Prove" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ReiterazioniTitolo}" />
                <Button Classes="Link" Padding="7,4" Tag="Allegati" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AllegatiTitolo}" />
                <Button Classes="Link" Padding="7,4" Tag="Riferimenti" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RiferimentiTitolo}" />
                <Button Classes="Link" Padding="7,4" Tag="Revisioni" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=StoricoRevisioniTitolo}" />
            </StackPanel>

            <!-- Striscia di schede: solo in creazione (Addendum: audit UX 2026-08-26, punto 1). A differenza
                 della barra sopra (che scorre), qui ogni pulsante cambia SchedaCorrente e nasconde le altre
                 sezioni — lo stesso form lungo diventa una scheda alla volta mentre si compila un test nuovo.
                 Background/Foreground bindati direttamente (valore locale, vince sempre sullo Setter statico
                 di Button.Secondary) invece di alternare classi CSS-style, per evidenziare la scheda attiva
                 senza ambiguità di precedenza tra stili. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding MostraSchedeCreazione}">
                <Button Classes="Secondary" Padding="10,5" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=WorkflowContestoTitolo}"
                        Command="{Binding VaiASchedaCommand}" CommandParameter="0"
                        AutomationProperties.AutomationId="Editor_Tab_0_Button"
                        Background="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaSfondoConverter.Instance}, ConverterParameter=0}"
                        Foreground="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaTestoConverter.Instance}, ConverterParameter=0}" />
                <Button Classes="Secondary" Padding="10,5" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DettagliTitolo}"
                        Command="{Binding VaiASchedaCommand}" CommandParameter="1"
                        AutomationProperties.AutomationId="Editor_Tab_1_Button"
                        Background="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaSfondoConverter.Instance}, ConverterParameter=1}"
                        Foreground="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaTestoConverter.Instance}, ConverterParameter=1}" />
                <Button Classes="Secondary" Padding="10,5" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ReiterazioniTitolo}"
                        Command="{Binding VaiASchedaCommand}" CommandParameter="2"
                        AutomationProperties.AutomationId="Editor_Tab_2_Button"
                        Background="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaSfondoConverter.Instance}, ConverterParameter=2}"
                        Foreground="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaTestoConverter.Instance}, ConverterParameter=2}" />
                <Button Classes="Secondary" Padding="10,5" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AllegatiTitolo}"
                        Command="{Binding VaiASchedaCommand}" CommandParameter="3"
                        AutomationProperties.AutomationId="Editor_Tab_3_Button"
                        Background="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaSfondoConverter.Instance}, ConverterParameter=3}"
                        Foreground="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaTestoConverter.Instance}, ConverterParameter=3}" />
                <Button Classes="Secondary" Padding="10,5" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RiferimentiTitolo}"
                        Command="{Binding VaiASchedaCommand}" CommandParameter="4"
                        AutomationProperties.AutomationId="Editor_Tab_4_Button"
                        Background="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaSfondoConverter.Instance}, ConverterParameter=4}"
                        Foreground="{Binding SchedaCorrente, Converter={x:Static local:SchedaAttivaTestoConverter.Instance}, ConverterParameter=4}" />
                <!-- Revisioni non è una scheda selezionabile in creazione (Addendum: audit UX 2026-08-26,
                     correzione post-collaudo): per un test nuovo è strutturalmente sempre vuota (nessuno
                     storico, nessun changelog), quindi Riferimenti resta l'ultimo passo reale — dove compare
                     Salva. Su un test esistente Revisioni è comunque raggiungibile come sempre, dalla barra
                     "salto alla sezione" (MostraBarraSaltaSezione), non da questa striscia. -->
            </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!-- Sotto la larghezza utile di 1100 DIP i link non stanno nella barra: diventano il menu "Vai a" con le stesse sezioni
                 (stesso OnVaiSezione, Tag = nome della sezione). -->
            <Button Grid.Column="0" Classes="Link" Padding="7,4" VerticalAlignment="Center" IsVisible="{Binding MostraMenuVaiA}"
                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorVaiASezioni}"
                    AutomationProperties.AutomationId="Editor_VaiA_Button">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Tag="Pianificazione" Click="OnVaiSezione" Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=WorkflowContestoTitolo}" />
                        <MenuItem Tag="Dettagli" Click="OnVaiSezione" Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DettagliTitolo}" />
                        <MenuItem Tag="Prove" Click="OnVaiSezione" Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ReiterazioniTitolo}" />
                        <MenuItem Tag="Allegati" Click="OnVaiSezione" Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AllegatiTitolo}" />
                        <MenuItem Tag="Riferimenti" Click="OnVaiSezione" Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RiferimentiTitolo}" />
                        <MenuItem Tag="Revisioni" Click="OnVaiSezione" Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=StoricoRevisioniTitolo}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" MaxWidth="240"
                       Foreground="{DynamicResource WarningTextBrush}" IsVisible="{Binding ModificheNonSalvate}"
                       TextTrimming="CharacterEllipsis" MinWidth="0"
                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ModificheNonSalvateTitolo}"
                       ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ModificheNonSalvateTitolo}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TornaAllaLista}" Classes="Secondary" Command="{Binding AnnullaCommand}" AutomationProperties.AutomationId="Editor_Cancel_Button" />
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=Modifica}" Classes="Secondary" Command="{Binding IniziaModificaCommand}" IsVisible="{Binding MostraPulsanteModifica}" IsEnabled="{Binding PuoModificare}" AutomationProperties.AutomationId="Editor_EditMode_Button" />
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=Salva}" Classes="Primary" Command="{Binding SalvaCommand}" IsVisible="{Binding MostraAzioniModifica}" AutomationProperties.AutomationId="Editor_Save_Button" />
            </StackPanel>
        </Grid>
    </Border>

    <ScrollViewer x:Name="EditorScroll" Grid.Row="1" Padding="28">
        <StackPanel Spacing="16" MaxWidth="1100">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="PageTitle" Text="{Binding TitoloPagina}" AutomationProperties.AutomationId="Editor_Title_Text" />
                    </StackPanel>
                    <TextBlock Classes="Muted" IsVisible="{Binding !IsNew}">
                        <Run Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=UltimaModificaPrefix}" /><Run Text="{Binding TestCase.UltimaModifica, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                        <Run Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DaSuffix}" /><Run Text="{Binding TestCase.ModificatoDa}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="Secondary" Padding="8,4"
                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickMode}"
                            Command="{Binding AttivaModalitaRapidaCommand}" IsVisible="{Binding !ModoEditorRapido}"
                            AutomationProperties.AutomationId="Editor_Mode_Quick_Button" />
                    <Button Classes="Secondary" Padding="8,4"
                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorFullMode}"
                            Command="{Binding AttivaModalitaCompletaCommand}" IsVisible="{Binding ModoEditorRapido}"
                            AutomationProperties.AutomationId="Editor_Mode_Full_Button" />
                    <!-- Menu REV (Addendum §6, feedback QA): naviga qualunque revisione, non solo un'etichetta
                         statica — Dettagli/Operazioni sotto si aggiornano di conseguenza (in sola lettura se
                         non è la revisione corrente). -->
                    <ComboBox ItemsSource="{Binding RevisioniPerMenu}" SelectedItem="{Binding RevisioneVisualizzata}" IsVisible="{Binding HaRevisioneCorrente}" MinWidth="200" AutomationProperties.AutomationId="Editor_MenuRev_Combo">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Esecuzione">
                                <TextBlock Text="{Binding Converter={x:Static local:EsecuzioneRevLabelConverter.Instance}}" FontSize="13" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Classes="Banner BannerAvviso" Padding="8,4" IsVisible="{Binding VisualizzaStorico}">
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RevisioneStoricaSolaLettura}" FontSize="12" />
                    </Border>
                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DuplicaComeNuovoTest}" Classes="Secondary" Command="{Binding DuplicaTestCommand}" IsVisible="{Binding !IsNew}" IsEnabled="{Binding PuoModificare}" ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DuplicaTooltip}" />
                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=Archivia}" Classes="Danger" Command="{Binding EliminaTestCaseCommand}" AutomationProperties.AutomationId="Editor_Archivia_Button" IsVisible="{Binding !IsNew}" IsEnabled="{Binding PuoModificare}" />
                </StackPanel>
            </Grid>

            <!-- Quick workspace: the Full editor remains available at any point. -->
            <Border Classes="Card" IsVisible="{Binding ModoEditorRapido}" AutomationProperties.AutomationId="Editor_Quick_Workspace"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="OnAllegatiDragOver" DragDrop.Drop="OnAllegatiDrop">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionTitle" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickTitle}" />
                    <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickHint}" />
                    <TextBlock Classes="Muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickDropHint}" IsVisible="{Binding TipoTestScelto}" />
                    <WrapPanel Orientation="Horizontal" IsVisible="{Binding TipoTestScelto}">
                        <Button Classes="Secondary" Margin="0,0,8,6" Tag="Dettagli" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DettagliTitolo}" AutomationProperties.AutomationId="Editor_Quick_Nav_Details" />
                        <Button Classes="Secondary" Margin="0,0,8,6" Tag="Prove" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ReiterazioniTitolo}" AutomationProperties.AutomationId="Editor_Quick_Nav_Operations" />
                        <Button Classes="Secondary" Margin="0,0,8,6" Tag="Allegati" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickEvidence}" AutomationProperties.AutomationId="Editor_Quick_Nav_Attachments" />
                        <Button Classes="Secondary" Margin="0,0,8,6" Click="OnIncollaScreenshotAllegato"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPasteScreenshot}"
                                IsEnabled="{Binding PuoModificareContenuto}" IsVisible="{Binding !TestRichiedeEcu}" AutomationProperties.AutomationId="Editor_Quick_PasteScreenshot_Button" />
                        <Button Classes="Secondary" Margin="0,0,8,6" Tag="Riferimenti" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPolarion}" AutomationProperties.AutomationId="Editor_Quick_Nav_Ticketing" />
                        <Button Classes="Secondary" Margin="0,0,8,6" Tag="Pianificazione" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=WorkflowContestoTitolo}" AutomationProperties.AutomationId="Editor_Quick_Nav_Planning" />
                        <Button Classes="Secondary" Margin="0,0,8,6" Tag="Revisioni" Click="OnVaiSezione" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=StoricoRevisioniTitolo}" IsVisible="{Binding !IsNew}" AutomationProperties.AutomationId="Editor_Quick_Nav_History" />
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" IsVisible="{Binding TipoTestScelto}"
                               AutomationProperties.AutomationId="Editor_Quick_OperationProgress">
                        <TextBlock Classes="Muted" Margin="0,0,5,5"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickTotalCount}" />
                        <TextBlock FontWeight="SemiBold" Margin="0,0,14,5" Text="{Binding OperazioniRapideTotali}" />
                        <TextBlock Classes="Muted" Margin="0,0,5,5"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickExecutedCount}" />
                        <TextBlock FontWeight="SemiBold" Margin="0,0,14,5" Text="{Binding OperazioniRapideEseguite}" />
                        <TextBlock Classes="Muted" Margin="0,0,5,5"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPendingCount}" />
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,5" Text="{Binding OperazioniRapideDaEseguire}" />
                    </WrapPanel>
                    <TextBlock Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding HaRiepilogoDettagliRapido}" Text="{Binding RiepilogoDettagliRapido}"
                               AutomationProperties.AutomationId="Editor_Quick_DetailsSummary_Text" />
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding HaStatoEstaRapido}" Text="{Binding EstaStatoSintesi}"
                               AutomationProperties.AutomationId="Editor_Quick_EstaStatus_Text" />
                    <!-- Coda di lavoro della Rapida: filtro, prossima da eseguire, chiusura delle restanti. Stessi esiti rapidi delle righe. -->
                    <WrapPanel Orientation="Horizontal" IsVisible="{Binding HaOperazioniRapide}">
                        <ToggleButton Margin="0,0,8,4" IsChecked="{Binding SoloDaEseguireRapido, Mode=TwoWay}" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickOnlyTodo}"
                                      AutomationProperties.AutomationId="Editor_Quick_OnlyTodo_Toggle" />
                        <Button Classes="Secondary" Margin="0,0,8,4" Click="OnProssimaDaEseguire" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickNextTodo}"
                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickNextTodoHelp}"
                                AutomationProperties.AutomationId="Editor_Quick_NextTodo_Button" />
                        <Button Classes="Secondary" Margin="0,0,8,4" Command="{Binding SegnaRestantiOkCommand}" IsEnabled="{Binding PuoSegnareRestantiOk}"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickMarkRestOk}"
                                AutomationProperties.AutomationId="Editor_Quick_MarkRestOk_Button" />
                    </WrapPanel>
                    <!-- Rapida = solo i campi obbligatori; questo interruttore riapre tutti i campi opzionali. -->
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HaCampiOpzionaliRapido}">
                        <ToggleButton IsChecked="{Binding MostraTuttiICampiRapido, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickAllFields}"
                                      AutomationProperties.AutomationId="Editor_Quick_AllFields_Toggle" />
                        <TextBlock Classes="Muted" VerticalAlignment="Center" IsVisible="{Binding !MostraTuttiICampiRapido}"
                                   Text="{Binding CampiOpzionaliNascostiRapido, StringFormat='+{0}'}"
                                   AutomationProperties.AutomationId="Editor_Quick_HiddenFieldsCount_Text" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Passo 1 del wizard (solo test nuovo, Addendum §18): il Tipo test va scelto da solo, prima di
                 tutto il resto, perché determina quali campi specifici esisteranno più sotto. -->
            <Border Classes="Card" IsVisible="{Binding !TipoTestScelto}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ChePasso1Titolo}" Classes="SectionTitle" />
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ChePasso1Sottotitolo}" Classes="Muted" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding TemplatesDisponibili}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TestTemplate">
                                <Button Classes="Secondary" Margin="0,0,10,10" Padding="20,14"
                                        Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).SceglieTemplateCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.AutomationId="Editor_TemplatePicker_Button">
                                    <TextBlock FontSize="14" FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Icona" />
                                                <Binding Path="Nome" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Spacing="16" IsVisible="{Binding TipoTestScelto}">

            <!-- Lock -->
            <Border Classes="Banner BannerAvviso" IsVisible="{Binding AvvisoLockNonConfermato}" Margin="0,8,0,0">
                <TextBlock Text="{Binding AvvisoLockNonConfermatoTesto}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="Banner BannerAvviso" IsVisible="{Binding LockDetenutoDaAltri}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding LockInfoTesto, StringFormat='🔒 {0}'}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ForzaSbloccoBtn}" Classes="Link" Command="{Binding ForzaSbloccoCommand}" />
                </Grid>
            </Border>

            <!-- Avviso non bloccante: un'altra postazione/operatore sta modificando lo stesso Test (6.4.1,
                 concorrenza multi-PC, punto A). Non impedisce di continuare: invita solo a coordinarsi prima
                 del Salva, dove la stessa condizione viene ricontrollata e confermata esplicitamente. -->
            <Border Classes="Banner BannerInfo" IsVisible="{Binding AvvisoAltraPostazioneVisibile}">
                <TextBlock Text="{Binding AvvisoAltraPostazioneTesto, StringFormat='⚠️ {0}'}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Border>

            <!-- Avvisi -->
            <ItemsControl ItemsSource="{Binding Avvisi}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Classes="Banner BannerAvviso"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding}" TextWrapping="Wrap" /><Button Grid.Column="1" Content="×" Classes="Link" VerticalAlignment="Top" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviAvvisoCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ChiudiMessaggioTooltip}" AutomationProperties.AutomationId="Editor_Avviso_Chiudi_Button" /></Grid></Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Errori validazione -->
            <ItemsControl ItemsSource="{Binding ErroriValidazione}" AutomationProperties.AutomationId="Editor_ValidationErrors_List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Classes="Banner BannerErrore"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding}" TextWrapping="Wrap" /><Button Grid.Column="1" Content="×" Classes="Link" VerticalAlignment="Top" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviErroreValidazioneCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ChiudiMessaggioTooltip}" AutomationProperties.AutomationId="Editor_ErroreValidazione_Chiudi_Button" /></Grid></Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="Banner BannerErrore" IsVisible="{Binding RilascioLockInAttesa}" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding MessaggioRilascioLock}" TextWrapping="Wrap" AutomationProperties.AutomationId="Editor_RilascioLock_Text" />
                    <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RiprovaIndice}" Classes="Link" Command="{Binding RiprovaRilascioLockCommand}" AutomationProperties.AutomationId="Editor_RiprovaRilascioLock_Button" />
                </Grid>
            </Border>
            <Border Classes="Banner BannerErrore" IsVisible="{Binding RilascioLockCatalogoInAttesa}" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding MessaggioRilascioLockCatalogo}" TextWrapping="Wrap" AutomationProperties.AutomationId="Editor_RilascioLockCatalogo_Text" />
                    <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RiprovaIndice}" Classes="Link" Command="{Binding RiprovaRilascioLockCatalogoCommand}" AutomationProperties.AutomationId="Editor_RiprovaRilascioLockCatalogo_Button" />
                </Grid>
            </Border>

            <!-- Conferma fuori categoria -->
            <!-- Candidati iterazione -->
            <Border Classes="Banner BannerInfo" IsVisible="{Binding HaCandidatiIterazione}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TrovatiTestSimili}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding CandidatiIterazione}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:TestCaseCandidato">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Etichetta}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TestCase.DescrizioneBreve}" Classes="Muted" FontSize="12" TextWrapping="Wrap"
                                                   IsVisible="{Binding TestCase.DescrizioneBreve, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ApriTestBtn}" Classes="Link"
                                            Tag="{Binding TestCase.Id}" Click="OnApriTestCorrelatoInFinestra" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=PuoiIgnorareContinua}" Classes="Muted" />
                </StackPanel>
            </Border>

            <!-- Candidati correlati -->
            <Border Classes="Banner BannerInfo" IsVisible="{Binding HaCandidatiCorrelati}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TestAltriTipiCorrelati}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding CandidatiCorrelati}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TestCase">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock>
                                            <Run Text="{Binding Componente}" FontWeight="SemiBold" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Id}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding DescrizioneBreve}" Classes="Muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding DescrizioneBreve, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ApriTestBtn}" Classes="Link"
                                            Tag="{Binding Id}" Click="OnApriTestCorrelatoInFinestra" />
                                    <Button Grid.Column="2" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AggiungiComeCorrelato}" Classes="Link"
                                            Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).AggiungiCorrelatoCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 1. PIANIFICAZIONE: solo lo strato amministrativo/workflow, in un riquadro separato per far
                 notare subito eventuali ritardi (Addendum §7). Area/Scadenza/Assegnatario sono riservati a un
                 Master (nota obbligatoria ad ogni modifica); lo Stato del lavoro resta libero per chiunque
                 possa modificare il test. Tutto il resto (componente/Veicolo/Tipo/Funzionalità/Descrizione/Baseline)
                 è in "Dettagli", modificabile a ogni revisione come prima del redesign precedente. -->
            <Border x:Name="Pianificazione" Classes="Card" IsVisible="{Binding MostraSchedaPianificazione}">
                <StackPanel Spacing="12" IsEnabled="{Binding InModifica}">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=WorkflowContestoTitolo}" Classes="SectionTitle" />
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ContestoPropostoSottotitolo}" Classes="Muted" TextWrapping="Wrap" />
                    <!-- Griglia a tre colonne; sotto 1100 DIP di larghezza utile il VM porta ogni campo su una riga sola (ColonneSpanEditor = 3):
                         per questo niente RowSpacing, lo spazio verticale e' il Margin inferiore di ogni figlio. -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="0">
                        <StackPanel Grid.Row="{Binding RigaStatoLavoro}" Grid.Column="{Binding ColonnaStatoLavoro}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4" IsVisible="{Binding MostraCampoStatoLavoro}" svc:Spotlight.TargetId="campo-StatoLavoro">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding EtichettaStatoLavoro}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding StatoLavoroObbligatorio}" />
                            </StackPanel>
                            <ComboBox Classes="Field" ItemsSource="{Binding StatiLavoro}" SelectedItem="{Binding StatoLavoroSelezionato}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static local:WorkflowLabelConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="{Binding RigaScadenza}" Grid.Column="{Binding ColonnaScadenza}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4" IsEnabled="{Binding PuoAssegnare}" IsVisible="{Binding MostraCampoScadenza}" svc:Spotlight.TargetId="campo-Scadenza">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding EtichettaScadenza}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding ScadenzaObbligatoria}" />
                            </StackPanel>
                            <CalendarDatePicker Classes="Field" HorizontalAlignment="Stretch" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                                SelectedDate="{Binding ScadenzaTesto, Converter={x:Static local:DataTestoConverter.Instance}}"
                                                PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DataPlaceholder}" />
                        </StackPanel>
                        <StackPanel Grid.Row="{Binding RigaSeverita}" Grid.Column="{Binding ColonnaSeverita}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=SeveritaLabel}" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding SeveritaDisponibili}" SelectedItem="{Binding SeveritaSelezionata}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static local:WorkflowLabelConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="{Binding RigaAssegnatario}" Grid.Column="{Binding ColonnaAssegnatario}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4" IsVisible="{Binding MostraAssegnatarioEditabile}" svc:Spotlight.TargetId="campo-Assegnatario">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding EtichettaAssegnatario}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding AssegnatarioObbligatorio}" />
                            </StackPanel>
                            <ComboBox Classes="Field" ItemsSource="{Binding OperatoriDisponibili}" SelectedItem="{Binding AssegnatarioSelezionato}" IsVisible="{Binding OperatoriDisponibili, Converter={x:Static local:ListaEntroSogliaConverter.Instance}}" AutomationProperties.AutomationId="Editor_Assegnatario_Combo" />
                            <Button Classes="Field" Content="{Binding AssegnatarioSelezionato, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=NessunoPlaceholder}" Command="{Binding ScegliAssegnatarioCommand}" IsVisible="{Binding OperatoriDisponibili, Converter={x:Static local:ListaOltreSogliaConverter.Instance}}" />
                        </StackPanel>
                        <!-- Priorità interna: assegnabile solo da un Master (feedback utente 2026-08-20, punto 18).
                             Riga propria (Row 2): Row 1 Col 1 è già occupata da "Assegnato da". -->
                        <StackPanel Grid.Row="{Binding RigaPriorita}" Grid.Column="{Binding ColonnaPriorita}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4" IsEnabled="{Binding PuoAssegnare}">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=PrioritaLabel}" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding PrioritaDisponibili}" SelectedItem="{Binding PrioritaSelezionata}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static local:WorkflowLabelConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="{Binding RigaAssegnatario}" Grid.Column="{Binding ColonnaAssegnatario}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4" IsVisible="{Binding MostraAssegnatarioReadOnly}" svc:Spotlight.TargetId="campo-Assegnatario">
                            <TextBlock Text="{Binding EtichettaAssegnatarioReadOnly}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AssegnatarioSelezionato, FallbackValue='—', TargetNullValue='—'}" VerticalAlignment="Center" Margin="0,6" />
                        </StackPanel>
                        <StackPanel Grid.Row="{Binding RigaAssegnatoDa}" Grid.Column="{Binding ColonnaAssegnatoDa}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AssegnatoDaLabel}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TestCase.CreatoDa, FallbackValue='—', TargetNullValue='—'}" VerticalAlignment="Center" Margin="0,6" />
                        </StackPanel>
                        <StackPanel Grid.Row="{Binding RigaDataAssegnazione}" Grid.Column="{Binding ColonnaDataAssegnazione}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DataAssegnazioneLabel}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TestCase.DataAssegnazione, StringFormat={}{0:dd/MM/yyyy}, FallbackValue='—', TargetNullValue='—'}" VerticalAlignment="Center" Margin="0,6" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ChiEseguDiventaAssegnatario}" Classes="Muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=SoloMasterPianificazione}" Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding !PuoAssegnare}" />

                    <!-- Nota obbligatoria solo se Area/Scadenza/Assegnatario sono davvero cambiati rispetto
                         all'ultimo salvataggio: il ViewModel valida al momento di Salva, qui è sempre visibile
                         a un Master per non far scoprire l'obbligo solo dopo un errore — MA solo su un test
                         ESISTENTE (MostraNotaPianificazione, Addendum: audit UX 2026-08-26, correzione
                         post-collaudo): su un test nuovo non c'è ancora nulla da "cambiare", il campo non può
                         mai diventare obbligatorio, e mostrarlo comunque era solo confusione. -->
                    <StackPanel Spacing="4" IsVisible="{Binding MostraNotaPianificazione}">
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NotaPianificazioneLabel}" FontSize="13" FontWeight="SemiBold" />
                        <TextBox Classes="Field" Text="{Binding NotaPianificazioneTemp}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NotaPianificazionePlaceholder}" />
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NotaPianificazioneAiuto}" Classes="Muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <Expander Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=StoricoNotePianificazioneTitolo}" IsExpanded="False" IsVisible="{Binding TestCase.NotePianificazione.Count}">
                        <ItemsControl ItemsSource="{Binding TestCase.NotePianificazione}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NotaPianificazione">
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="12" Classes="Muted">
                                                <Run Text="{Binding Data, StringFormat={}{0:dd/MM/yyyy HH:mm}}" /><Run Text=" · " /><Run Text="{Binding Operatore}" /><Run Text=" · " /><Run Text="{Binding CampiModificati}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Nota}" TextWrapping="Wrap" FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Campi personalizzati di Pianificazione (Addendum: grill-me 2026-08-18, follow-up): campi
                 CampoLibero o del catalogo campi di sistema (Ruolo=Nessuno) assegnati dal template a questa
                 sezione — stesso motore generico di CampiRevisioneCostanti, salvati in TestCase.CampiCustom. -->
            <Border Classes="Card">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static local:TuttiVeriConverter.Instance}">
                        <Binding Path="CampiCustomPianificazioneVisual.Count" />
                        <Binding Path="MostraSchedaPianificazione" />
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="8" IsEnabled="{Binding InModifica}">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CampiPersonalizzatiTitolo}" Classes="SectionTitle" />
                    <ItemsControl ItemsSource="{Binding CampiCustomPianificazioneVisual}" ItemTemplate="{StaticResource CampoValoreItemTemplateSemplice}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 2. DETTAGLI: cosa si sta testando, modificabile a ogni revisione (Addendum §7 — ripristina la
                 separazione da Pianificazione della prima versione del redesign, ma con un taglio diverso:
                 qui ora componente/Veicolo/Tipo/Funzionalità/Descrizione, non solo gli identificativi). -->
            <Border x:Name="Dettagli" Classes="Card" IsVisible="{Binding MostraSchedaDettagli}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DettagliTitolo}" Classes="SectionTitle" />
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DettagliSottotitolo}" Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding !VisualizzaStorico}" />

                    <!-- Storico (Addendum §1, feedback QA): la fotografia completa della revisione sfogliata,
                         non solo matricola/Baseline/Operazioni, con i cambiamenti rispetto alla più recente
                         evidenziati — sostituisce il modulo editabile mentre si naviga il menu REV. -->
                    <StackPanel Spacing="8" IsVisible="{Binding VisualizzaStorico}">
                        <Border Classes="Banner BannerAvviso" IsVisible="{Binding HaCampiCambiati}">
                            <TextBlock Text="{Binding TestoCampiCambiati}" TextWrapping="Wrap" FontSize="13" />
                        </Border>
                        <!-- componente/Veicolo/Tipo/Funzionalità/Descrizione arrivano dallo snapshot nuovo (Addendum
                             §1): assenti sulle revisioni create prima di questo aggiornamento. matricola/Baseline
                             invece esistevano già per ogni revisione, quindi restano sempre visibili qui sotto
                             indipendentemente dallo snapshot. -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="{Binding DettagliStorico, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding EtichettaEcu}" FontSize="13" FontWeight="SemiBold" Classes="Muted" />
                                <TextBlock Text="{Binding DettagliStorico.Componente}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding EtichettaVeicolo}" FontSize="13" FontWeight="SemiBold" Classes="Muted" />
                                <TextBlock Text="{Binding DettagliStorico.Veicolo}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TipoTestObbl}" FontSize="13" FontWeight="SemiBold" Classes="Muted" />
                                <TextBlock Text="{Binding DettagliStorico.TestTemplateNome}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding VinLabelTesto}" FontSize="13" FontWeight="SemiBold" Classes="Muted" />
                                <TextBlock Text="{Binding RevisioneVisualizzata.Matricola}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=BaselineSwLabel}" FontSize="13" FontWeight="SemiBold" Classes="Muted" />
                                <TextBlock Text="{Binding RevisioneVisualizzata.BaselineSw}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=BaselineHwLabel}" FontSize="13" FontWeight="SemiBold" Classes="Muted" />
                                <TextBlock Text="{Binding RevisioneVisualizzata.BaselineHw}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="2" IsVisible="{Binding DettagliStorico, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding EtichettaFunzionalita}" FontSize="13" FontWeight="SemiBold" Classes="Muted" />
                            <TextBlock Text="{Binding DettagliStorico.Funzionalita, Converter={x:Static local:JoinStringsConverter.Instance}}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2" IsVisible="{Binding DettagliStorico, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DescrizioneObbl}" FontSize="13" FontWeight="SemiBold" Classes="Muted" />
                            <TextBlock Text="{Binding DettagliStorico.Descrizione}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DettagliStoriciNonDisponibiliTesto}" Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding DettagliStoriciNonDisponibili}" />
                    </StackPanel>

                    <!-- Selezione progressiva: prima Veicolo, poi componente filtrata sul Veicolo, poi Funzionalità
                         filtrata sul componente. Tenere questi tre passaggi in quest'ordine visivo rende esplicita
                         la dipendenza dei dati e riduce le scelte incoerenti. -->
                    <StackPanel IsVisible="{Binding !VisualizzaStorico}" IsEnabled="{Binding InModifica}" Spacing="8">
                        <StackPanel Margin="0,0,0,4" Spacing="4" IsVisible="{Binding MostraCampoVeicolo}" svc:Spotlight.TargetId="campo-Veicolo">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding EtichettaVeicolo}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding VeicoloObbligatorio}" />
                            </StackPanel>
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding VeicoliDisponibili}" SelectedItem="{Binding VeicoloSelezionato}" IsVisible="{Binding VeicoliDisponibili, Converter={x:Static local:ListaEntroSogliaConverter.Instance}}" AutomationProperties.AutomationId="Editor_Veicolo_ComboBox" />
                            <Button Classes="Field" Content="{Binding VeicoloSelezionato, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=ScegliVeicoloPlaceholder}" Command="{Binding ScegliVeicoloCommand}" IsVisible="{Binding VeicoliDisponibili, Converter={x:Static local:ListaOltreSogliaConverter.Instance}}" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding PuoAggiungereCampiSistemaRapidi}">
                                <TextBox Grid.Column="0" Classes="Field" Text="{Binding NuovoVeicoloNome}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AltroVeicoloPlaceholder}" AutomationProperties.AutomationId="Editor_NuovoVeicolo_TextBox" />
                                <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AggiungiBtn}" Classes="Secondary" Margin="8,0,0,0" Command="{Binding AggiungiVeicoloRapidoCommand}" AutomationProperties.AutomationId="Editor_AggiungiVeicoloRapido_Button" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding VeicoliSelezionatiVisual}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Border Classes="Badge" Background="{DynamicResource InfoBackgroundBrush}" Margin="0,4,6,0"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding}"/><Button Content="x" Classes="Link" Padding="0" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviVeicoloCommand}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ComboBox x:Name="GammaMultiSelect" Classes="Field" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TcSelezionaTuttaGammaPlaceholder}" ItemsSource="{Binding GammeDisponibili}" SelectionChanged="OnSelezionaGamma" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4" Spacing="4" IsVisible="{Binding MostraCampoEcu}" svc:Spotlight.TargetId="campo-Componente">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding EtichettaEcu}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding EcuObbligatorio}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding EcuVisual}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Border Classes="Badge" Background="{DynamicResource IndigoSoftBrush}" Margin="0,0,6,4"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding}"/><Button Content="✕" Classes="Link" Padding="0" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviEcuCommand}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="Field" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ScegliEcuPlaceholder}" Command="{Binding ScegliEcuCommand}" AutomationProperties.AutomationId="Editor_ScegliEcu_Button" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding PuoAggiungereCampiSistemaRapidi}">
                                <TextBox Grid.Column="0" Classes="Field" Text="{Binding NuovoEcuNome}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AltroEcuPlaceholder}" AutomationProperties.AutomationId="Editor_NuovoEcu_TextBox" />
                                <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AggiungiBtn}" Classes="Secondary" Margin="8,0,0,0" Command="{Binding AggiungiEcuRapidoCommand}" AutomationProperties.AutomationId="Editor_AggiungiEcuRapido_Button" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Grid invece di StackPanel (spec riordino campi 2026-09-23 §2, seguito coordinamento
                         2026-09-24): Funzionalità/Strumenti usati/Descrizione breve/Descrizione sono ora
                         riordinabili come BLOCCHI fra loro (righe 0/4/5/6 riservate, guidate da
                         CampoTemplate.Ordine come il resto — vedi TestCaseEditorViewModel.RigheBlocchiDettagli);
                         la griglia Veicolo/Componente/Baseline (riga 1) e i campi degli strumenti costanti (righe 2-3)
                         e custom (riga 7) restano a riga fissa. RowDefinitions="Auto" ovunque: una riga collassa
                         a zero altezza quando il contenuto è IsVisible=False, stesso comportamento della
                         StackPanel precedente. Margin inferiore su ciascun figlio al posto di Spacing="12"
                         (Grid non ha una proprietà Spacing). Strumenti usati era prima una card a sé — vive qui
                         come riga per poterla riordinare (nessuna anomalia di compatibilità: non era mai stata
                         visivamente adiacente a Funzionalità/Descrizioni prima d'ora, quindi la posizione di
                         default può derivare direttamente da Ordine, come per gli altri due blocchi).
                    -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding !VisualizzaStorico}" IsEnabled="{Binding InModifica}">
                    <StackPanel Grid.Row="{Binding RigaFunzionalita}" Margin="0,0,0,12" Spacing="4" IsVisible="{Binding MostraCampoFunzionalita}" svc:Spotlight.TargetId="campo-Funzionalita">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="{Binding EtichettaFunzionalita}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding FunzionalitaObbligatoria}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FunzionalitaVisual}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="Badge" Background="{DynamicResource SuccessBackgroundBrush}" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding}" />
                                            <Button Content="✕" Classes="Link" Padding="0" FontSize="11"
                                                    Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviFunzionalitaCommand}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="Field" Content="{Binding NuovaFunzionalita, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=AggiungiFunzionalitaPlaceholder}" Click="OnScegliFunzionalita" AutomationProperties.AutomationId="Editor_ScegliFunzionalita_Button" />
                        <!-- Creazione rapida di una Funzionalita' non ancora a catalogo, stesso principio di componente/Veicolo. -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding PuoAggiungereCampiSistemaRapidi}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NuovaFunzionalitaCatalogoNome}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AltraFunzionalitaPlaceholder}" AutomationProperties.AutomationId="Editor_NuovaFunzionalita_TextBox" />
                            <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AggiungiBtn}" Classes="Secondary" Margin="8,0,0,0" Command="{Binding AggiungiFunzionalitaRapidaCommand}" AutomationProperties.AutomationId="Editor_AggiungiFunzionalitaRapida_Button" />
                        </Grid>
                        <TextBlock Text="{Binding AvvisoFunzionalitaRapida}" IsVisible="{Binding HaAvvisoFunzionalitaRapida}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                        <!-- Interruttore "mostra tutte" (feedback utente 2026-09-23): con componente già scelte
                             l'elenco sopra si restringe alle funzionalità associate + generiche — questo
                             evita che il filtro blocchi mai l'operatore se l'associazione componente→Funzionalità è
                             incompleta o sbagliata. Visibile solo quando il filtro potrebbe essere attivo
                             (almeno un componente già scelta), altrimenti sarebbe un controllo senza effetto. -->
                        <CheckBox Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=MostraTutteLeFunzionalitaBtn}"
                                  IsChecked="{Binding MostraTutteLeFunzionalita}"
                                  ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=MostraTutteLeFunzionalitaTooltip}"
                                  IsVisible="{Binding TestCase.Componente.Count}" FontSize="12" />
                    </StackPanel>

                    <!-- Strumenti usati: era prima una card a sé (guidava quali sezioni di Campi specifici
                         comparivano subito dopo, Addendum §18) — vive qui come riga riordinabile (spec
                         riordino campi 2026-09-23 §2, seguito coordinamento 2026-09-24). La sezione "Campi con
                         Ambito=PerRevisione" resta comunque SEMPRE dopo l'intera card Dettagli (un Border
                         separato più sotto nel file): riordinare questa riga dentro Dettagli non inverte
                         quell'ordine causa-effetto, solo la posizione interna alla card. -->
                    <StackPanel Grid.Row="{Binding RigaStrumentiUsati}" Margin="0,0,0,12" Spacing="6">
                        <TextBlock Text="{Binding EtichettaStrumentiUsati}" Classes="SectionTitle" />
                        <TextBox Classes="Field" MaxWidth="300" HorizontalAlignment="Left" Text="{Binding FiltroStrumenti}"
                                 PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CercaPlaceholder}"
                                 IsVisible="{Binding MostraRicercaStrumenti}"
                                 AutomationProperties.AutomationId="Editor_Strumenti_Ricerca_Input" />
                        <!-- ≤10 strumenti: WrapPanel inline invariata (nessun cambio visibile per il caso comune). -->
                        <ItemsControl ItemsSource="{Binding StrumentiOptions}" IsVisible="{Binding !MostraRicercaStrumenti}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StrumentoOption">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Spacing="2" IsVisible="{Binding Visibile}">
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Selezionato}" ToolTip.Tip="{Binding Label}" AutomationProperties.AutomationId="{Binding Label, StringFormat='Editor_Strumento_{0}'}" />
                                        <!-- Campi dello strumento gestibili anche da dentro il test, non solo da
                                             Impostazioni (Addendum §8, feedback QA): stesso editor a tabella. -->
                                        <Button Content="⚙" Classes="Link" Padding="2,0" FontSize="13" Tag="{Binding Valore}" Click="OnGestisciCampiStrumento"
                                                AutomationProperties.AutomationId="{Binding Valore, StringFormat='Editor_Strumento_{0}_Rotellina_Button'}"
                                                IsVisible="{Binding MostraRotellina}"
                                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=GestisciCampiStrumentoTooltip}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- > 10 strumenti: lista VIRTUALIZZATA (profilazione 2026-09-25, commit 1a28198: 18000
                             delle 18316 visuali dell'editor sul banco 100k venivano da questa WrapPanel non
                             virtualizzata coi ~1000 strumenti a catalogo). Stesso approccio/stile di
                             FiltroMultiSelectVirtualizzato/FiltroMultiSelectRicerca (commit 1b87e8f, 58b6250):
                             ListBox col VirtualizingStackPanel di default, ricerca sul modello (mai troncata),
                             stato di selezione posseduto da StrumentoOption.Selezionato (mai dai CheckBox
                             riciclati), riga intera cliccabile e nessuna selezione visiva fuorviante della
                             ListBox (vedi code-behind OnListaStrumentiSelectionChanged). Il riepilogo sopra
                             tiene la selezione visibile anche fuori vista/filtro. -->
                        <StackPanel IsVisible="{Binding MostraRicercaStrumenti}" Spacing="4">
                            <TextBlock Text="{Binding StrumentiSelezionatiRiepilogo}" Classes="Muted" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="Editor_StrumentiSelezionatiRiepilogo_Text" />
                            <ListBox x:Name="ListaStrumentiUsati" ItemsSource="{Binding StrumentiOptionsFiltrate}" MaxHeight="260"
                                     SelectionChanged="OnListaStrumentiSelectionChanged"
                                     AutomationProperties.AutomationId="Editor_Strumenti_Lista">
                                <!-- AutomationId per riga (mai raggiungibile impostandolo su un elemento DENTRO
                                     l'ItemTemplate: Avalonia espone solo l'AutomationPeer del ListBoxItem
                                     generato, vedi README "Una scoperta empirica importante" — stesso schema
                                     gia' in uso per Impostazioni_Sub_{id}/SelezionaDialog). -->
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem" x:DataType="vm:StrumentoOption">
                                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Label, StringFormat='Editor_StrumentoLista_{0}'}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StrumentoOption">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Il CheckBox occupa l'intera colonna: un click ovunque sulla riga
                                                 (tranne sul pulsante ⚙) cambia la spunta. -->
                                            <CheckBox Grid.Column="0" Content="{Binding Label}" IsChecked="{Binding Selezionato}"
                                                      ToolTip.Tip="{Binding Label}" HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="1" Content="⚙" Classes="Link" Padding="2,0" FontSize="13" Tag="{Binding Valore}" Click="OnGestisciCampiStrumento"
                                                AutomationProperties.AutomationId="{Binding Valore, StringFormat='Editor_Strumento_{0}_Rotellina_Button'}"
                                                    IsVisible="{Binding MostraRotellina}"
                                                    ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=GestisciCampiStrumentoTooltip}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <!-- Deselezione strumento bloccata (6.5.1): operazioni con esito registrato o REV registrate. -->
                        <TextBlock Text="{Binding AvvisoStrumentiOperazioni}" IsVisible="{Binding HaAvvisoStrumentiOperazioni}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                                   AutomationProperties.AutomationId="Editor_StrumentiOperazioni_Avviso_Text" />
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding PuoGestireStrumenti}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NuovoStrumentoNome}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AltroStrumentoPlaceholder}" />
                            <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AggiungiATuttiBtn}" Classes="Secondary" Margin="8,0,0,0" Command="{Binding AggiungiStrumentoRapidoCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- Campi classici su tre colonne; sotto 1100 DIP di larghezza utile il VM li porta su una riga ciascuno (ColonneSpanEditor = 3),
                         quindi niente RowSpacing: lo spazio verticale e' il Margin inferiore di ogni figlio. -->
                    <Grid Grid.Row="1" Margin="0,0,0,12" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="0">
                        <!-- Veicolo prima di componente (feedback utente 2026-08-26): EcuDisponibili filtra già i componenti
                             proposte in base a TestCase.VeicoliEffettivi (vedi TestCaseEditorViewModel), quindi
                             ha senso che l'utente scelga prima il/i veicolo/i e solo dopo il componente filtrata di
                             conseguenza, non il contrario. Solo l'ordine delle colonne cambia: nessuna logica
                             di filtro dipende dalla posizione visiva dei due campi. -->
                        <StackPanel Grid.Row="{Binding RigaTipoTest}" Grid.Column="{Binding ColonnaTipoTest}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TipoTestObbl}" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox Classes="Field" ItemsSource="{Binding TemplatesDisponibili}" SelectedItem="{Binding TemplateSelezionato}" IsVisible="{Binding TemplatesDisponibili, Converter={x:Static local:ListaEntroSogliaConverter.Instance}}" AutomationProperties.AutomationId="Editor_Template_ComboBox"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <Button Classes="Field" Content="{Binding TemplateSelezionato, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=ScegliTipoTestPlaceholder}" Command="{Binding ScegliTemplateCommand}" IsVisible="{Binding TemplatesDisponibili, Converter={x:Static local:ListaOltreSogliaConverter.Instance}}" />
                        </StackPanel>
                        <StackPanel Grid.Row="{Binding RigaVin}" Grid.Column="{Binding ColonnaVin}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4" IsEnabled="{Binding PuoModificareCampiRevisione}" IsVisible="{Binding MostraCampoVin}" svc:Spotlight.TargetId="campo-Matricola">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding VinLabelTesto}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding VinObbligatorio}" />
                            </StackPanel>
                            <TextBox Classes="Field" Text="{Binding VinRevisione}" AutomationProperties.AutomationId="Test_Matricola_Input" PlaceholderText="{Binding VinPlaceholder}" />
                        </StackPanel>
                        <StackPanel Grid.Row="{Binding RigaBaselineSw}" Grid.Column="{Binding ColonnaBaselineSw}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4" IsEnabled="{Binding PuoModificareCampiRevisione}" IsVisible="{Binding MostraCampoBaselineSw}" svc:Spotlight.TargetId="campo-BaselineSw">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=BaselineSwLabel}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding BaselineSwObbligatorio}" />
                            </StackPanel>
                            <TextBox Classes="Field" Text="{Binding BaselineSwRevisione}" />
                        </StackPanel>
                        <StackPanel Grid.Row="{Binding RigaBaselineHw}" Grid.Column="{Binding ColonnaBaselineHw}" Grid.ColumnSpan="{Binding ColonneSpanEditor}" Margin="0,0,0,10" Spacing="4" IsEnabled="{Binding PuoModificareCampiRevisione}" IsVisible="{Binding MostraCampoBaselineHw}" svc:Spotlight.TargetId="campo-BaselineHw">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=BaselineHwLabel}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding BaselineHwObbligatorio}" />
                            </StackPanel>
                            <TextBox Classes="Field" Text="{Binding BaselineHwRevisione}" />
                        </StackPanel>
                    </Grid>

                    <!-- Campi degli strumenti costanti per l'intero test (valori uguali in ogni reiterazione), configurabili
                         da Impostazioni → Strumenti (Addendum redesign 2026-08, revisione feedback QA) -->
                    <ItemsControl Grid.Row="2" Margin="0,0,0,12" IsVisible="{Binding MostraCampiStrumentoDettagli}" ItemsSource="{Binding CampiTestCostanti}" ItemTemplate="{StaticResource CampoValoreItemTemplateConDefaultEListaTesto}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Campi costanti raggruppati (es. futuri strumenti con sotto-sezioni), dietro tendina collassata -->
                    <ItemsControl Grid.Row="3" Margin="0,0,0,12" IsVisible="{Binding MostraCampiStrumentoDettagli}" ItemsSource="{Binding GruppiTestCostanti}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GruppoCampiStrumento">
                                <Expander x:Name="GruppoCampiExpanderTest" Header="{Binding Nome}" IsExpanded="False" Margin="0,0,0,8" ToolTip.Tip="{Binding Nome}">
                                    <ItemsControl Margin="0,8,0,0" ItemTemplate="{StaticResource CampoValoreItemTemplateConDefault}">
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{x:Static localview:CampiSeEspansoConverter.Instance}">
                                                <Binding Path="Campi" />
                                                <Binding Path="#GruppoCampiExpanderTest.IsExpanded" />
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="{Binding RigaDescrizioneBreve}" Margin="0,0,0,12" Spacing="4" IsVisible="{Binding MostraCampoDescrizioneBreve}" svc:Spotlight.TargetId="campo-DescrizioneBreve">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DescrizioneBreveLabel}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding DescrizioneBreveObbligatoria}" />
                        </StackPanel>
                        <TextBox Classes="Field" Text="{Binding TestCase.DescrizioneBreve}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DescrizioneBrevePlaceholder}" MaxLength="120" AutomationProperties.AutomationId="Editor_DescrizioneBreve_TextBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="{Binding RigaDescrizione}" Margin="0,0,0,12" Spacing="4" IsVisible="{Binding MostraCampoDescrizione}" svc:Spotlight.TargetId="campo-Descrizione">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DescrizioneObbl}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="2,0,0,0" IsVisible="{Binding DescrizioneObbligatoria}" />
                            <Button Grid.Column="3" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EspandiBtn}" Classes="Link" Padding="0" FontSize="13" Command="{Binding EspandiDescrizioneCommand}" />
                        </Grid>
                        <TextBox Classes="Field" Text="{Binding TestCase.Descrizione}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="240" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Editor_Descrizione_TextBox" />
                    </StackPanel>

                    <!-- Campi personalizzati di Dettagli (Addendum: grill-me 2026-08-18, follow-up): campi
                         CampoLibero o del catalogo campi di sistema (Ruolo=Nessuno) assegnati dal template a
                         questa sezione — stesso motore generico di CampiRevisioneCostanti. -->
                    <StackPanel Grid.Row="7" Spacing="8" IsVisible="{Binding CampiCustomDettagliVisual.Count}">
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CampiPersonalizzatiTitolo}" Classes="SectionTitle" />
                        <ItemsControl ItemsSource="{Binding CampiCustomDettagliVisual}" ItemTemplate="{StaticResource CampoValoreItemTemplateSemplice}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Campi con Ambito=PerRevisione (Addendum §3, feedback QA): posizionati subito sotto Strumenti
                 usati, come richiesto — stabili tra tutte le operazioni di questa revisione, editabili solo
                 sulla revisione corrente (non sfogliando lo storico). -->
            <Border Classes="Card">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static local:TuttiVeriConverter.Instance}">
                        <Binding Path="CampiRevisioneCostanti.Count" />
                        <Binding Path="MostraSchedaDettagli" />
                        <Binding Path="MostraCampiStrumentoDettagli" />
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="8" IsEnabled="{Binding PuoModificareContenuto}">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CampiRevisioneTitolo}" Classes="SectionTitle" />
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CampiRevisioneSottotitolo}" Classes="Muted" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding CampiRevisioneCostanti}" ItemTemplate="{StaticResource CampoValoreItemTemplateSemplice}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding GruppiRevisioneCostanti}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GruppoCampiStrumento">
                                <Expander x:Name="GruppoCampiExpanderRevisione" Header="{Binding Nome}" IsExpanded="False" Margin="0,0,0,8" ToolTip.Tip="{Binding Nome}">
                                    <ItemsControl Margin="0,8,0,0" ItemTemplate="{StaticResource CampoValoreItemTemplateSemplice}">
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{x:Static localview:CampiSeEspansoConverter.Instance}">
                                                <Binding Path="Campi" />
                                                <Binding Path="#GruppoCampiExpanderRevisione.IsExpanded" />
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. REITERAZIONI (ex "Condizioni provate"; "Verifiche e Prove" eliminata come struttura separata
                 — Addendum redesign 2026-08: un test è fatto di reiterazioni, ognuna con i propri campi tecnici,
                 il proprio esito e la propria nota. La prima "Avvia" crea anche la prima revisione. -->
            <Border x:Name="Prove" Classes="Card" IsVisible="{Binding MostraSchedaProve}">
                <StackPanel Spacing="10" IsEnabled="{Binding InModifica}">
                    <StackPanel Spacing="10" IsVisible="{Binding !HaRevisioneCorrente}">
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CondizioniProvateTitolo}" Classes="SectionTitle" />
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NessunaEsecuzioneAncora}" Classes="Muted" TextWrapping="Wrap" />
                        <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AvviaPrimaEsecuzioneBtn}" Classes="Primary" HorizontalAlignment="Left" Command="{Binding AggiungiIterazioneCommand}" AutomationProperties.AutomationId="Editor_AvviaPrimaEsecuzione_Button" />
                    </StackPanel>

                    <!-- Niente più tasto manuale "+ Nuova iterazione" (Addendum §6, feedback QA): una nuova
                         revisione si crea da sola al salvataggio se Dettagli/Operazioni sono cambiati rispetto
                         all'ultimo salvataggio; naviga le revisioni già create dal menu REV in alto. -->
                    <StackPanel Spacing="12" IsVisible="{Binding HaRevisioneCorrente}" IsEnabled="{Binding PuoModificareContenuto}">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CondizioniProvateTitolo}" Classes="SectionTitle" Margin="0" />
                            <TextBlock Classes="Muted">
                                <Run Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EsecuzioneRevisioneCorrentePrefix}" /><Run Text="{Binding RevisioneVisualizzata.Iterazione}" /><Run Text=")" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Reso proattivo (feedback utente 2026-08-20, punto 22 — "i suggerimenti sono
                             spariti"): compare appena Funzionalità/Tipo test bastano per una ricerca utile,
                             non solo come effetto collaterale silenzioso del primo "+ Aggiungi condizione". -->
                        <Border Classes="Banner BannerInfo" IsVisible="{Binding HaSuggerimentoCronologia}" BorderThickness="2">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="💡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SuggerimentoCronologiaTesto}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="Secondary" Padding="10,4" Margin="8,0,0,0"
                                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ApriTestBtn}"
                                        Tag="{Binding SuggerimentoCronologiaTestId}" Click="OnApriTestCorrelatoInFinestra" />
                                <Button Grid.Column="3" Classes="Primary" Padding="10,4" Margin="8,0,0,0"
                                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=UsaSuggerimentoBtn}"
                                        Command="{Binding UsaSuggerimentoCronologiaCommand}" />
                            </Grid>
                        </Border>

                        <Expander IsExpanded="False" IsVisible="{Binding ModoEditorRapido}"
                                  Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPasteTitle}"
                                  AutomationProperties.AutomationId="Editor_QuickPaste_Expander">
                            <StackPanel Spacing="8" Margin="0,8,0,8">
                                <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPasteHint}" />
                                <TextBox Classes="Field" Text="{Binding TestoOperazioniRapide}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75" MaxHeight="220"
                                         AutomationProperties.AutomationId="Editor_QuickPaste_TextBox" />
                                <Border Classes="Banner BannerErrore" Padding="8"
                                        IsVisible="{Binding HaErroreAnteprimaRapida}"
                                        AutomationProperties.AutomationId="Editor_QuickPaste_Error_Banner">
                                    <TextBlock Text="{Binding ErroreAnteprimaRapida}" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="Editor_QuickPaste_Error_Text" />
                                </Border>
                                <Button Classes="Secondary" HorizontalAlignment="Left"
                                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPreviewButton}"
                                        Command="{Binding PreparaAnteprimaOperazioniRapideCommand}" IsEnabled="{Binding MostraAggiungiOperazioneLibera}"
                                        AutomationProperties.AutomationId="Editor_QuickPaste_Preview_Button" />
                                <!-- The preview is display-only: the Test is changed only after explicit confirmation.
                                     Rendering is capped at eight rows, the validated batch stays capped at fifty. -->
                                <Border Classes="Banner BannerInfo" Padding="10"
                                        IsVisible="{Binding MostraAnteprimaOperazioniRapide}"
                                        AutomationProperties.AutomationId="Editor_QuickPaste_PreviewPanel">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding RiepilogoAnteprimaRapida}" TextWrapping="Wrap" FontWeight="SemiBold"
                                                   AutomationProperties.AutomationId="Editor_QuickPaste_PreviewSummary_Text" />
                                        <Grid ColumnDefinitions="38,140,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold"
                                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPreviewFunction}" />
                                            <TextBlock Grid.Column="2" FontWeight="SemiBold"
                                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPreviewNote}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding RigheAnteprimaRapida}"
                                                      AutomationProperties.AutomationId="Editor_QuickPaste_PreviewRows">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RigaAnteprimaIncollaRapido">
                                                    <Grid ColumnDefinitions="38,140,*" ColumnSpacing="8" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Numero}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Funzionalita}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Nota}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="Primary" Margin="0,0,8,4"
                                                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPasteButton}"
                                                    Command="{Binding IncollaOperazioniRapideCommand}" IsEnabled="{Binding PuoConfermareAnteprimaRapida}"
                                                    AutomationProperties.AutomationId="Editor_QuickPaste_Add_Button" />
                                            <Button Classes="Secondary" Margin="0,0,8,4"
                                                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPreviewCancel}"
                                                    Command="{Binding AnnullaAnteprimaOperazioniRapideCommand}"
                                                    AutomationProperties.AutomationId="Editor_QuickPaste_CancelPreview_Button" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Button Classes="Secondary" HorizontalAlignment="Left"
                                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickUndoPaste}"
                                        Command="{Binding AnnullaUltimoIncollaRapidoCommand}" IsVisible="{Binding PuoAnnullareUltimoIncollaRapido}"
                                        AutomationProperties.AutomationId="Editor_QuickPaste_Undo_Button" />
                            </StackPanel>
                        </Expander>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ReiterazioniTitolo}" Classes="SectionTitle" FontSize="14" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorDuplicaUltimaOperazione}" Classes="Secondary" Command="{Binding CopiaDallaPrecedenteCommand}"
                                        IsVisible="{Binding MostraAggiungiOperazioneLibera}" IsEnabled="{Binding PuoModificareContenuto}"
                                        ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorDuplicaUltimaOperazioneTooltip}"
                                        AutomationProperties.AutomationId="Editor_CopiaDallaPrecedente_Button" />
                                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AnnullaCopiaBtn}" Classes="Secondary" Command="{Binding AnnullaCopiaDallaPrecedenteCommand}"
                                        IsVisible="{Binding PuoAnnullareCopiaPrecedente}" IsEnabled="{Binding PuoAnnullareCopiaPrecedente}"
                                        AutomationProperties.AutomationId="Editor_AnnullaCopiaPrecedente_Button" />
                            <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AggiungiCondizioneBtn}" Classes="Secondary" Command="{Binding AggiungiCondizioneCommand}" IsVisible="{Binding MostraAggiungiOperazioneLibera}" AutomationProperties.AutomationId="Editor_AggiungiCondizione_Button" />
                            </StackPanel>
                        </Grid>
                        <Border IsVisible="{Binding MostraAnteprimaCopiaPrecedente}" Classes="Banner BannerInfo" Padding="10" Margin="0,4,0,8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AnteprimaCampiDaCopiare}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding AnteprimaCopiaPrecedente}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CampoCopiaPrecedente">
                                            <Grid ColumnDefinitions="Auto,180,*" ColumnSpacing="10" Margin="0,2">
                                                <CheckBox IsChecked="{Binding Selezionato}" IsVisible="{Binding EModificaOperazione}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Campo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="{Binding Descrizione}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MessaggioCopiaPrecedente}" Classes="Muted" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="{Binding TestoConfermaCopiaPrecedente}" Classes="Primary" Command="{Binding ConfermaCopiaDallaPrecedenteCommand}"
                                            AutomationProperties.AutomationId="Editor_ConfermaCopiaPrecedente_Button" />
                                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=Annulla}" Classes="Secondary" Margin="8,0,0,0" Command="{Binding AnnullaAnteprimaCopiaPrecedenteCommand}"
                                            AutomationProperties.AutomationId="Editor_AnnullaAnteprimaCopiaPrecedente_Button" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=StessoServizioDiagnosticoTesto}" Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding !HaPiuDiUnaCondizione}" />

                        <!-- Raggruppamento per strumento (6.5.1): solo riepilogo con contatore ("UnitLogger 2/3 OK"); l'esito del test
                             resta calcolato per operazione, nessun nuovo aggregato. -->
                        <StackPanel Spacing="2" IsVisible="{Binding HaGruppiOperazioniStrumento}">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=OperazioniStrumentoTitolo}" Classes="Muted" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding GruppiOperazioniStrumento}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:GruppoOperazioniStrumento">
                                        <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding Contatore}" FontSize="12" AutomationProperties.AutomationId="{Binding Strumento, StringFormat='Editor_OperazioniStrumento_{0}_Contatore_Text'}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Blocco "Aggiungi guasto" dello strumento guasto Injection (6.5.1, fase 4): un guasto alla volta; ogni guasto genera la
                             coppia Validazione/Devalidazione. componente da menu, poi guasto disponibile OPPURE manuale. -->
                        <Border IsVisible="{Binding MostraBloccoAggiungiDtc}" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,2,0,8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsTitolo}" Classes="SectionTitle" FontSize="14" />
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsIntro}" Classes="Muted" FontSize="12" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DefaultPersonaleEtichetta}"
                                               Classes="Muted" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding HaDefaultDtcInjectionPersonale}" />
                                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicordaComeMioDefaultBtn}"
                                            Classes="Link" Padding="0" FontSize="12" Command="{Binding SalvaDtcInjectionDefaultsCommand}"
                                            AutomationProperties.AutomationId="Editor_DtcInjection_Default_Save_Button" />
                                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RimuoviMioDefaultBtn}"
                                            Classes="Link" Padding="0" FontSize="12" IsVisible="{Binding HaDefaultDtcInjectionPersonale}"
                                            Command="{Binding RimuoviDtcInjectionDefaultsCommand}"
                                            AutomationProperties.AutomationId="Editor_DtcInjection_Default_Remove_Button" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,2*" ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsVeicoloLabel}" Classes="Muted" FontSize="12" />
                                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding DtcInsVeicoliOpzioni}" SelectedItem="{Binding DtcInsVeicolo}"
                                                  PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsVeicoloPlaceholder}"
                                                  AutomationProperties.AutomationId="Editor_DtcInjection_Veicolo_Combo" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsEcuLabel}" Classes="Muted" FontSize="12" />
                                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding DtcInsEcuOpzioni}" SelectedItem="{Binding DtcInsEcu}"
                                                  PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsEcuPlaceholder}"
                                                  AutomationProperties.AutomationId="Editor_DtcInjection_Componente_Combo" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsDtcLabel}" Classes="Muted" FontSize="12" />
                                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding DtcInsDisponibili}" SelectedItem="{Binding DtcInsScelto}"
                                                  PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsDtcPlaceholder}"
                                                  IsVisible="{Binding DtcInsMostraCombo}"
                                                  AutomationProperties.AutomationId="Editor_DtcInjection_Guasto_Combo" />
                                        <Button Classes="Field" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding DtcInsSceltoEtichetta}"
                                                Command="{Binding ScegliDtcInsCommand}" IsVisible="{Binding DtcInsMostraPicker}"
                                                AutomationProperties.AutomationId="Editor_DtcInjection_Guasto_Scegli_Button" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsManualeLabel}" Classes="Muted" FontSize="12" />
                                        <TextBox Classes="Field" HorizontalAlignment="Stretch" Text="{Binding DtcInsCodiceManuale}"
                                                 PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsManualePlaceholder}"
                                                 AutomationProperties.AutomationId="Editor_DtcInjection_Manuale_Text" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsRequisitoLabel}" Classes="Muted" FontSize="12" />
                                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding DtcInsRequisitiOpzioni}" SelectedItem="{Binding DtcInsRequisitoSel}"
                                                  IsEnabled="{Binding DtcInsRequisitoEditabile}"
                                                  AutomationProperties.AutomationId="Editor_DtcInjection_Requisito_Combo" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsLiberoNota}" Classes="Muted" FontSize="12" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Classes="Primary" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsAggiungiBtn}"
                                            Command="{Binding AggiungiDtcCommand}" AutomationProperties.AutomationId="Editor_DtcInjection_Aggiungi_Button" />
                                </StackPanel>
                                <TextBlock Text="{Binding DtcInsErrore}" IsVisible="{Binding HaDtcInsErrore}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                                           AutomationProperties.AutomationId="Editor_DtcInjection_Errore_Text" />
                                <StackPanel Spacing="4" IsVisible="{Binding HaDtcInseriti}">
                                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsInseritiTitolo}" Classes="Muted" FontSize="12" />
                                    <ItemsControl ItemsSource="{Binding DtcInseriti}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DtcInseritoRiga">
                                                <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8" Margin="0,2">
                                                    <TextBox Grid.Column="0" Classes="Field" Text="{Binding Codice, Mode=OneWay}" LostFocus="OnDtcRigaCodiceCommit" KeyDown="OnDtcRigaCodiceKeyDown"
                                                             AutomationProperties.AutomationId="{Binding AutomationIdCodice}" />
                                                    <ComboBox Grid.Column="1" Classes="Field" HorizontalAlignment="Stretch" SelectedItem="{Binding Componente, Mode=OneWay}"
                                                              ItemsSource="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).DtcInsEcuOpzioni}" SelectionChanged="OnDtcRigaEcuModificata"
                                                              AutomationProperties.AutomationId="{Binding AutomationIdEcu}" />
                                                    <ComboBox Grid.Column="2" Classes="Field" HorizontalAlignment="Stretch" SelectedItem="{Binding RequisitoEtichetta, Mode=OneWay}"
                                                              ItemsSource="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).DtcInsRequisitiOpzioni}" SelectionChanged="OnDtcRigaRequisitoModificato"
                                                              AutomationProperties.AutomationId="{Binding AutomationIdRequisito}" />
                                                    <Button Grid.Column="3" Classes="Link" Tag="{Binding}" Click="OnDtcRigaRimuovi"
                                                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DtcInsRimuoviBtn}"
                                                            AutomationProperties.AutomationId="{Binding AutomationIdRimuovi}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Completa: scheda intera per operazione. Rapida: riga compatta (esito evidenziato, nota, durata, evidenze) con la scheda completa su richiesta. -->
                        <ItemsControl ItemTemplate="{StaticResource OperazioneCardCompleta}">
                            <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{x:Static localview:CollezioneSeModoRapidoConverter.Instance}" ConverterParameter="false">
                                    <Binding Path="CondizioniVisual" />
                                    <Binding Path="ModoEditorRapido" />
                                </MultiBinding>
                            </ItemsControl.ItemsSource>
                        </ItemsControl>
                        <ItemsControl ItemTemplate="{StaticResource OperazioneRigaRapida}">
                            <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{x:Static localview:CollezioneSeModoRapidoConverter.Instance}" ConverterParameter="true">
                                    <Binding Path="CondizioniVisual" />
                                    <Binding Path="ModoEditorRapido" />
                                </MultiBinding>
                            </ItemsControl.ItemsSource>
                        </ItemsControl>

                        <!-- Riepilogo revisione corrente -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ColData}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RevisioneCorrente.Data, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Margin="0,6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=OperatoreLabel}" FontSize="13" FontWeight="SemiBold" />
                                <ComboBox Classes="Field" ItemsSource="{Binding OperatoriDisponibili}" SelectedItem="{Binding RevisioneCorrenteOperatore}" IsVisible="{Binding OperatoriDisponibili, Converter={x:Static local:ListaEntroSogliaConverter.Instance}}" />
                                <Button Classes="Field" Content="{Binding RevisioneCorrenteOperatore, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=ScegliOperatorePlaceholder}" Command="{Binding ScegliRevisioneOperatoreCommand}" IsVisible="{Binding OperatoriDisponibili, Converter={x:Static local:ListaOltreSogliaConverter.Instance}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Riepilogo per componente×Funzionalità (feedback utente 2026-08-25, punto 9, seconda ondata):
                             sostituisce il singolo badge "esito dalla condizione peggiore" di tutto il test, che
                             non aveva più senso con più componente/Funzionalità sulla stessa revisione — un'operazione
                             con più componente compare in più badge, coppie coperte da più operazioni mostrano la
                             condizione peggiore tra loro. -->
                        <StackPanel Spacing="4" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RiepilogoEcuFunzionalitaLabel}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NessunRiepilogoEcuFunzionalita}" Classes="Muted" IsVisible="{Binding !RiepilogoEcuFunzionalita.Count}" />
                            <ItemsControl ItemsSource="{Binding RiepilogoEcuFunzionalita}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RiepilogoEcuFunzionalitaRiga">
                                        <Border Classes="Badge" Margin="0,0,6,6" Background="{Binding Esito, Converter={x:Static local:EsitoColorConverter.Instance}}">
                                            <TextBlock Foreground="{Binding Esito, Converter={x:Static local:EsitoTextColorConverter.Instance}}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                        <Binding Path="Componente" />
                                                        <Binding Path="Funzionalita" />
                                                        <Binding Path="Esito" Converter="{x:Static local:EsitoLabelConverter.Instance}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Copertura mancante (Addendum: audit UX 2026-08-26, punto 8 ridotto): stesso
                                 controllo di ValEcuSenzaOperazioneFmt/ValFunzionalitaSenzaOperazioneFmt in
                                 Valida(), ma mostrato QUI mentre si compila invece che come unico avviso al
                                 momento di Salvare — non una regola nuova, la stessa regola vista prima. -->
                            <Border Classes="Banner BannerAvviso" Margin="0,4,0,0" IsVisible="{Binding HaCoperturaIncompleta}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CoperturaMancanteTitolo}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" FontSize="13" IsVisible="{Binding FunzionalitaNonCoperte.Count}">
                                        <Run Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CoperturaFunzionalitaMancantiPrefix}" />
                                        <Run Text="{Binding FunzionalitaNonCoperte, Converter={x:Static local:JoinStringsConverter.Instance}}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" IsVisible="{Binding VeicoloEcuSenzaDtc.Count}" AutomationProperties.AutomationId="Editor_DtcInjection_CoperturaMancante_Text">
                                        <Run Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CoperturaDtcMancantiPrefix}" />
                                        <Run Text="{Binding VeicoloEcuSenzaDtc, Converter={x:Static local:JoinStringsConverter.Instance}}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" IsVisible="{Binding EcuNonCoperte.Count}">
                                        <Run Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CoperturaEcuMancantiPrefix}" />
                                        <Run Text="{Binding EcuNonCoperte, Converter={x:Static local:JoinStringsConverter.Instance}}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <CheckBox Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CorreggiManualmenteEsito}" IsChecked="{Binding RevisioneCorrenteEsitoSovrascritto}" />
                            <StackPanel Spacing="4" IsVisible="{Binding RevisioneCorrenteEsitoSovrascritto}" Margin="24,0,0,0">
                                <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Esiti}" SelectedItem="{Binding RevisioneCorrenteEsito}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Converter={x:Static local:EsitoLabelConverter.Instance}}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Classes="Field" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=MotivazioneCorrezioneObbl}" Text="{Binding RevisioneCorrenteMotivazioneOverride}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="150" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding PunteggiRequisitiVisual.Count}">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=PunteggioConformitaSezioneTitolo}" FontSize="13" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding PunteggiRequisitiVisual}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PunteggioRequisitoRowViewModel">
                                        <Border Classes="Card" Padding="8" Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding RequisitoId}" FontWeight="SemiBold" />
                                                <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).ValoriPunteggioConformita}"
                                                          SelectedItem="{Binding Valore}"
                                                          IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).InModifica}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding Converter={x:Static local:PunteggioConformitaLabelConverter.Instance}}" /></DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <CheckBox Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=PunteggioConformitaSovrascriviLabel}"
                                                          IsChecked="{Binding Sovrascritto}" />
                                                <TextBox Classes="Field" Text="{Binding MotivazioneOverride}" IsVisible="{Binding Sovrascritto}"
                                                         PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=PunteggioConformitaMotivazionePlaceholder}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DeviazioniLabel}" FontSize="13" FontWeight="SemiBold" />
                            <TextBox Classes="Field" Text="{Binding RevisioneCorrente.Deviazioni}" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding HaNonConformitaCollegata}" Classes="Muted">
                            <Run Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NonConformitaCollegataPrefix}" /><Run Text="{Binding RevisioneCorrente.NonConformitaId}" />
                        </TextBlock>

                        <!-- Campi non ripetibili per condizione: valgono per il test/collegamento. Vincolo e
                             azioni collegate sono dichiarati dal template scelto (Addendum redesign 2026-08,
                             punto 2: sostituisce i vecchi campi fissi UdtTestCollegatoId/Escalation). -->
                        <StackPanel Spacing="4" IsVisible="{Binding MostraVincoloCollegamento}">
                            <TextBlock Text="{Binding EtichettaVincoloCollegamento}" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox Classes="Field" ItemsSource="{Binding TestVincoloDisponibili}" SelectedItem="{Binding TestVincoloSelezionato}" IsVisible="{Binding TestVincoloDisponibili, Converter={x:Static local:ListaEntroSogliaConverter.Instance}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Componente}" /> · <Run Text="{Binding Id}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <Button Classes="Field" Content="{Binding TestVincoloSelezionato, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=ScegliTestCollegatoPlaceholder}" Command="{Binding ScegliTestVincoloCommand}" IsVisible="{Binding TestVincoloDisponibili, Converter={x:Static local:ListaOltreSogliaConverter.Instance}}" />
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding HaAzioniCollegate}">
                            <!-- Menu interattivo runtime (feedback utente 2026-08-20, punto 17): non più un
                                 bottone per ogni AzioneCollegataTemplate preconfigurata dal Master, un solo
                                 bottone che apre CreaTestCollegatoWindow e chiede ogni volta quale/i tipo/i di
                                 test creare e quali campi copiare. -->
                            <Button Classes="Secondary" HorizontalAlignment="Left"
                                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CreaTestCollegatoTitoloBtn}"
                                    Click="OnCreaTestCollegato" AutomationProperties.AutomationId="Editor_CreaTestCollegato_Button" />
                            <ItemsControl ItemsSource="{Binding TestCase.TestCollegatiCreati}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TestCollegatoCreato">
                                        <Button Classes="Link" Padding="0"
                                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).ApriTestCollegatoCommand}"
                                                CommandParameter="{Binding TestCollegatoId}"
                                                AutomationProperties.AutomationId="{Binding TestCollegatoId, StringFormat='Editor_TestCollegato_{0}_Button'}">
                                            <Button.Content>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="TemplateDestinazioneNome" />
                                                    <Binding Path="TestCollegatoId" />
                                                </MultiBinding>
                                            </Button.Content>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Descrizione del problema: spostata qui a sé stante, subito sotto le Operazioni (feedback
                 utente 2026-08-21, punto 6) — prima appariva dentro Dettagli, cambiando il flusso della
                 pagina ogni volta che compariva. Stessa logica automatica di prima (MostraDescrizioneProblema,
                 legata all'esito della revisione corrente): solo la posizione è cambiata, non il comportamento. -->
            <Border Classes="Card" svc:Spotlight.TargetId="campo-DescrizioneProblema">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static local:TuttiVeriConverter.Instance}">
                        <Binding Path="MostraDescrizioneProblema" />
                        <Binding Path="MostraSchedaProve" />
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="4" IsEnabled="{Binding InModifica}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DescrizioneProblemaLabel}" Classes="SectionTitle" />
                        <TextBlock Grid.Column="1" Text="*" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="2,0,0,0" IsVisible="{Binding DescrizioneProblemaObbligatoria}" />
                        <Button Grid.Column="3" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EspandiBtn}" Classes="Link" Padding="0" FontSize="13" Command="{Binding EspandiDescrizioneProblemaCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=VisibilePercheEsitoProblema}" Classes="Muted" TextWrapping="Wrap" />
                    <TextBox Classes="Field" Text="{Binding TestCase.DescrizioneProblema}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="240" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- 4. NOTE AGGIUNTIVE: nota generale sull'intera revisione, distinta dalle note per reiterazione. -->
            <Border Classes="Card">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static local:TuttiVeriConverter.Instance}">
                        <Binding Path="HaRevisioneCorrente" />
                        <Binding Path="MostraSchedaProve" />
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="4" IsEnabled="{Binding InModifica}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NoteAggiuntiveTitolo}" Classes="SectionTitle" />
                        <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EspandiBtn}" Classes="Link" Padding="0" FontSize="13" Command="{Binding EspandiNoteCommand}" />
                    </Grid>
                    <TextBox Classes="Field" Text="{Binding RevisioneCorrente.Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="220" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- 5. ALLEGATI -->
            <Border x:Name="Allegati" Classes="Card" IsVisible="{Binding MostraSchedaAllegati}"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="OnAllegatiDragOver" DragDrop.Drop="OnAllegatiDrop">
                <StackPanel Spacing="8" IsEnabled="{Binding InModifica}">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AllegatiTitolo}" Classes="SectionTitle" />
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AllegatiSottotitolo}" Classes="Muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EcuRichiestaPrima}" Classes="Muted" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding TestRichiedeEcu}" />
                    <ItemsControl ItemsSource="{Binding AllegatiVisual}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Allegato">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="📎" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="{Binding NomeFile}" Classes="Link" HorizontalAlignment="Left" ToolTip.Tip="{Binding NomeFile}"
                                            Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).ApriAllegatoCommand}" AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Allegato_{0}_Apri_Button'}" CommandParameter="{Binding}" />
                                    <TextBlock Grid.Column="2" Text="{Binding DataCaricamento, StringFormat={}{0:dd/MM/yyyy}}" Classes="Muted" Margin="0,0,10,0"
                                               ToolTip.Tip="{Binding EtichettaOperazione}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Content="⛓" Classes="Link" IsVisible="{Binding EtichettaOperazione, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EvidenzaOperazioneScollega}"
                                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).ScollegaEvidenzaOperazioneCommand}" AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Allegato_{0}_Scollega_Button'}" CommandParameter="{Binding}" />
                                        <Button Content="✕" Classes="Link"
                                                Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviAllegatoCommand}" AutomationProperties.AutomationId="{Binding Uid, StringFormat='Editor_Allegato_{0}_Rimuovi_Button'}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=SceglieFileBtn}" Classes="Secondary" HorizontalAlignment="Left" Click="OnSceglieFileAllegato" AutomationProperties.AutomationId="Editor_Allegato_Scegli_Button" IsEnabled="{Binding !TestRichiedeEcu}" />
                    <Button Classes="Secondary" HorizontalAlignment="Left" Click="OnIncollaScreenshotAllegato"
                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorQuickPasteScreenshot}"
                            IsEnabled="{Binding !TestRichiedeEcu}" AutomationProperties.AutomationId="Editor_Allegato_PasteScreenshot_Button" />
                </StackPanel>
            </Border>

            <!-- 6. RIFERIMENTI: requisiti/funzionalità collegati -->
            <Border x:Name="Riferimenti" Classes="Card" IsVisible="{Binding MostraSchedaRiferimenti}">
                <StackPanel Spacing="14" IsEnabled="{Binding InModifica}">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RiferimentiTitolo}" Classes="SectionTitle" />

                    <!-- Grid invece di StackPanel (spec riordino campi 2026-09-23 §2, seguito): Requisiti
                         collegati/Test correlati sono ora riordinabili come blocchi fra loro, guidati da
                         CampoTemplate.Ordine (TestCaseEditorViewModel.RigheBlocchiRiferimenti). -->
                    <Grid RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Row="{Binding RigaRequisitiCollegati}" Margin="0,0,0,14" Spacing="4" IsVisible="{Binding MostraRequisitiCollegati}">
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RequisitiCollegatiLabel}" FontSize="13" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding RequisitiVisual}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="Badge" Background="{DynamicResource SuccessBackgroundBrush}" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding}" />
                                            <Button Content="✕" Classes="Link" Padding="0" FontSize="11"
                                                    Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviRequisitoCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding, StringFormat='Editor_Requisito_{0}_Rimuovi_Button'}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="Field" Content="{Binding RequisitoSelezionato, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=AggiungiRequisitoPlaceholder}" Click="OnScegliRequisito" AutomationProperties.AutomationId="Editor_AggiungiRequisito_Button" />
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NessunRequisitoFunzionalitaTesto}" Classes="Muted" />
                    </StackPanel>

                    <StackPanel Grid.Row="{Binding RigaTestCorrelati}" Spacing="4" IsVisible="{Binding MostraTestCorrelati}">
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TestCorrelatiTitolo}" FontSize="13" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding TestCorrelatiVisual}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="Badge" Background="{DynamicResource SurfaceSubtleBrush}" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding}" />
                                            <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ApriTestCorrelatoBtn}" Classes="Link" Padding="0" FontSize="11"
                                                    Tag="{Binding}" Click="OnApriTestCorrelatoInFinestra" />
                                            <Button Content="✕" Classes="Link" Padding="0" FontSize="11"
                                                    Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviTestCorrelatoCommand}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="Field" Content="{Binding TestCorrelatoSelezionato, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=AggiungiTestCorrelatoPlaceholder}" Click="OnScegliTestCorrelato" />
                    </StackPanel>

                    <!-- 6b. TICKET / Ticketing: era prima una card a sé — vive qui come riga riordinabile
                         (spec riordino campi 2026-09-23 §2, seguito coordinamento 2026-09-24). La preparazione
                         del pacchetto resta sempre disponibile su ogni Tipo test, anche in sola visualizzazione;
                         la configurazione del template puo ancora nascondere il collegamento manuale
                         (MostraTicketCollegati), ma non l'export sotto. -->
                    <StackPanel Grid.Row="{Binding RigaTicketCollegati}" Spacing="8">
                        <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TicketCollegatiTitolo}" Classes="SectionTitle" />
                        <StackPanel Spacing="8" IsEnabled="{Binding InModifica}" IsVisible="{Binding MostraTicketCollegati}">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TicketSoloRiferimentoTesto}" Classes="Muted" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding TicketCollegatiVisual}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TicketRif">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                            <TextBlock Grid.Column="0" Text="{Binding Riferimento}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ApriInPolarionBtn}" Classes="Link" HorizontalAlignment="Left"
                                                    Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).ApriTicketCommand}" CommandParameter="{Binding}" IsVisible="{Binding Url, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                            <Button Grid.Column="2" Content="✕" Classes="Link" Padding="0" FontSize="11"
                                                    Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviTicketCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NessunTicketCollegato}" Classes="Muted" IsVisible="{Binding !TicketCollegatiVisual.Count}" />
                            <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Classes="Field" Text="{Binding NuovoTicketRiferimento}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=Ticket12345Placeholder}" />
                                <TextBox Grid.Column="1" Classes="Field" Text="{Binding NuovoTicketUrl}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=LinkPolarionPlaceholder}" />
                                <Button Grid.Column="2" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CollegaBtn}" Classes="Secondary" Command="{Binding AggiungiTicketCommand}" />
                            </Grid>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !HaAnomalieTestAperte}">
                            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EsportaCampiTxtTesto}" Classes="Muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=PreparaDatiPolarionBtn}" Classes="Primary" Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="Test_PreparaPacchettoPolarion_Button"
                                    IsEnabled="{Binding !TestRichiedeEcu}" ToolTip.Tip="{Binding PreparaPolarionTooltip}" Click="OnCreaTicket" />
                        </Grid>
                        <Button Content="Prepara o collega un nuovo TICKET da questo Test (NC/CR)"
                                Classes="Secondary" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="Test_Ticket_BrowserHandoff_Button"
                                Click="OnPreparaEstaDaTest"/>
                        <TextBlock Text="{Binding MessaggioTicket}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" IsVisible="{Binding HaMessaggioTicket}" />
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Read-only TICKET status kept OUTSIDE the InModifica-disabled reference card.
                 A browser draft is never labeled as a created ticket. -->
            <Border Classes="Card" IsVisible="{Binding MostraSchedaRiferimenti}"
                    AutomationProperties.AutomationId="Editor_EstaStatus_Card">
                <StackPanel Spacing="8" IsVisible="{Binding !IsNew}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="SectionTitle" VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorEstaStatusTitle}" />
                        <Button Grid.Column="1" Classes="Secondary" Command="{Binding AggiornaStatoEstaLocaleCommand}"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorEstaStatusRefresh}"
                                AutomationProperties.AutomationId="Editor_EstaStatus_Refresh_Button" />
                    </Grid>
                    <TextBlock Text="{Binding EstaStatoSintesi}" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="Editor_EstaStatus_Summary_Text" />
                    <TextBlock Text="{Binding EstaStatoNota}" Classes="Muted" TextWrapping="Wrap" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding EstaStatoRighe}"
                                  AutomationProperties.AutomationId="Editor_EstaStatus_Items">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EditorEstaStatusUnavailable}"
                               IsVisible="{Binding EstaStatoNonDisponibile}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Campi custom -->
            <Border Classes="Card" IsVisible="{Binding MostraSchedaRiferimenti}">
                <StackPanel Spacing="8" IsEnabled="{Binding InModifica}">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CampiCustomTitolo}" Classes="SectionTitle" />
                    <!-- Addendum: audit UX 2026-08-26, nota minore 3 — "due percorsi diversi per i campi
                         custom" (§18.12 della guida): questa casella libera è deliberatamente scollegata dal
                         catalogo, ma senza avviso l'utente scopre solo troppo tardi (filtro assente in
                         Home/Report) che il valore scritto qui non è filtrabile. Un avviso unico invece di un
                         badge per riga: vale identicamente per ogni riga della lista, ripeterlo non
                         aggiungerebbe informazione. -->
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CampiCustomAvvisoFiltro}"
                               Classes="Muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding CampiCustomVisual.Count}" />
                    <ItemsControl ItemsSource="{Binding CampiCustomVisual}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CampoCustomRiga">
                                <Grid ColumnDefinitions="200,*,Auto,Auto" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding Chiave}" FontWeight="SemiBold" Classes="FullTextTip" />
                                    <TextBlock Grid.Column="1" Text="{Binding Valore}" Classes="FullTextTip" />
                                    <Button Grid.Column="2" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=PromuoviCampoBtn}" Classes="Link" FontSize="12"
                                            IsVisible="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PuoPromuovereCampiCustom}"
                                            ToolTip.Tip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=PromuoviCampoTooltip}"
                                            Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PromuoviCampoCustomCommand}" CommandParameter="{Binding Chiave}" />
                                    <Button Grid.Column="3" Content="✕" Classes="Link"
                                            Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RimuoviCampoCustomCommand}" CommandParameter="{Binding Chiave}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="200,*,Auto">
                        <TextBox Grid.Column="0" Classes="Field" Text="{Binding NuovoCampoCustomChiave}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NomeCampoPlaceholder}" />
                        <TextBox Grid.Column="1" Classes="Field" Text="{Binding NuovoCampoCustomValore}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=ValorePlaceholder}" Margin="8,0" />
                        <Button Grid.Column="2" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AggiungiBtn}" Classes="Secondary" Command="{Binding AggiungiCampoCustomCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 7. ANOMALIE: lo stesso workflow operativo della vista aggregata, contestualizzato sul Test —
                 ultima sezione operativa del Test, subito prima dello storico Revisioni (feedback utente
                 2026-08-21, punto 7). -->
            <!-- Anomalie non ha un ancoraggio proprio nella barra/schede (deriva dagli esiti delle Operazioni,
                 nessun senso su un test appena iniziato): raggruppata sotto la scheda Prove/Operazioni. -->
            <Border x:Name="Anomalie" Classes="Card">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static local:TuttiVeriConverter.Instance}">
                        <Binding Path="TipoTestScelto" />
                        <Binding Path="MostraSchedaProve" />
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AnomalieTestTitolo}" Classes="SectionTitle" />
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AnomalieTestSottotitolo}" Classes="Muted" TextWrapping="Wrap" />

                    <StackPanel Spacing="8" IsVisible="{Binding HaSegnalazioniTest}">
                        <!-- Titolo del pannello e "Gestisci tutte" (feedback 2026-10-10): una sola conferma per l'intero elenco. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AnomalieDaClassificare}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="Editor_SegnalazioniDaClassificare_Text" />
                            <Button Grid.Column="1" Classes="Secondary" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=GestisciTutteBtn}"
                                    Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).GestisciTutteSegnalazioniCommand}"
                                    IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).InModifica}"
                                    AutomationProperties.AutomationId="Editor_GestisciTutteSegnalazioni_Button" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SegnalazioniTest}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SegnalazioneTestRiga">
                                    <Border Background="{DynamicResource OrangeSoftBrush}" BorderBrush="{DynamicResource OrangeBorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Etichetta}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Condizione.Esito, Converter={x:Static local:EsitoLabelConverter.Instance}}" Classes="Muted" VerticalAlignment="Center" />
                                                    <Border Classes="Badge" Background="{DynamicResource InfoBackgroundBrush}" VerticalAlignment="Center" IsVisible="{Binding EvidenziataDaRicerca}"><TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RicercaGlobaleEvidenziata}" /></Border>
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="Badge" Background="{DynamicResource OrangeBorderSoftBrush}" VerticalAlignment="Center" IsVisible="{Binding !Esclusa}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_Stato_Chip'}">
                                                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AnomalieDaClassificare}" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Grid.Column="1" Classes="Badge" VerticalAlignment="Center" IsVisible="{Binding Esclusa}">
                                                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=SegnalazioneEsclusaTesto}" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Risultato}" Classes="Muted" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding TestoSuggerimento}" IsVisible="{Binding HaTestoSuggerimento}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_Suggerimento_Text'}" />
                                            <!-- Azione primaria: una riga con severita' e un solo pulsante che dice cosa succedera'. -->
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" IsVisible="{Binding !Esclusa}" IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).InModifica}">
                                                <ComboBox Grid.Column="0" Classes="Field" MinWidth="150" ItemsSource="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).SeveritaDisponibili}" SelectedItem="{Binding Severita}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=SeveritaObbligatoria}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_Severita_Combo'}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static local:WorkflowLabelConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                                <Button Grid.Column="1" Classes="Primary" Content="{Binding EtichettaAzionePrimaria}" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).AzionePrimariaSegnalazioneCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_Primaria_Button'}" />
                                                <ToggleButton Grid.Column="2" Classes="Secondary" HorizontalAlignment="Right" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AltreAzioniBtn}" IsChecked="{Binding AltreAzioniAperte, Mode=TwoWay}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_AltreAzioni_Toggle'}" />
                                            </Grid>
                                            <!-- Azioni secondarie, chiuse di default: scegliere un'altra NC, creare comunque una NC nuova, escludere con motivazione. -->
                                            <StackPanel Spacing="8" IsVisible="{Binding AltreAzioniAperte}" IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).InModifica}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding PuoCollegareAnomaliaEsistente}">
                                                    <ComboBox Grid.Column="0" Classes="Field" ItemsSource="{Binding AnomalieCandidate}" SelectedItem="{Binding AnomaliaSelezionata}" IsVisible="{Binding AnomalieCandidate, Converter={x:Static local:ListaEntroSogliaConverter.Instance}}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_AnomaliaCombo'}"
                                                              PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CollegaAnomaliaPlaceholder}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Id}" /> - <Run Text="{Binding Descrizione}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                                    <Button Grid.Column="0" Classes="Field" Content="{Binding AnomaliaSelezionata, Converter={x:Static local:ScegliPlaceholderConverter.Instance}, ConverterParameter=CollegaAnomaliaPlaceholder}"
                                                            Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).ScegliAnomaliaCommand}" CommandParameter="{Binding}" IsVisible="{Binding AnomalieCandidate, Converter={x:Static local:ListaOltreSogliaConverter.Instance}}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_AnomaliaScegli_Button'}" />
                                                </Grid>
                                                <Button Classes="Secondary" HorizontalAlignment="Left" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CreaNuovaNcBtn}" IsVisible="{Binding AzioneCollega}"
                                                        Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).CreaAnomaliaDaTestCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_NuovaAnomalia_Button'}" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBox Classes="Field" Text="{Binding MotivazioneEsclusione}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_MotivazioneEsclusione_TextBox'}" PlaceholderText="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=MotivazioneEsclusione}" />
                                                    <Button Grid.Column="1" Classes="Secondary" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EscludiBtn}" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).EscludiSegnalazioneDaTestCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_Escludi_Button'}" />
                                                </Grid>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding Esclusa}">
                                                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=SegnalazioneEsclusaTesto}" />
                                                <TextBlock Grid.Column="1" Text="{Binding MotivazioneEsclusione}" Classes="Muted" TextWrapping="Wrap" />
                                                <Button Grid.Column="2" Classes="Secondary" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AnnullaEsclusioneBtn}" IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).InModifica}" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).AnnullaEsclusioneSegnalazioneCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding Segnalazione.Uid, StringFormat='Editor_Segnalazione_{0}_AnnullaEsclusione_Button'}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Elenco anomalie collegate VIRTUALIZZATO (feedback utente 6.5.0): con molte segnalazioni
                         collegate allo stesso test il template completo di ogni riga non va materializzato in blocco.
                         ScrollViewer + VirtualizingStackPanel con altezza massima: sotto la soglia l'elenco non scorre. -->
                    <Button Classes="Secondary" HorizontalAlignment="Left"
                            IsVisible="{Binding HaAnomalieTestAperte}"
                            AutomationProperties.AutomationId="Test_Anomalie_CreaEstaBrowser_Button"
                            Content="Prepara / collega nuovo TICKET dalla NC o CR"
                            Click="OnPreparaEstaDaTest"/>
                    <Button Classes="Primary" HorizontalAlignment="Left" IsVisible="{Binding HaAnomalieTestAperte}" IsEnabled="{Binding !PacchettoInCorso}" Click="OnCreaTicket" AutomationProperties.AutomationId="Test_Anomalie_GeneraPacchettoEsta_Button"
                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=GeneraPacchettoEstaBtn}" />
                    <!-- Righe COMPATTE in sola lettura (id, descrizione, stato, priorita, assegnatario) in UN SOLO ListBox
                         virtualizzato; la modifica (stato, campi, ticket TICKET, chiusura con motivazione) avviene nel
                         pop-up AnomaliaDettaglioWindow, lo stesso della pagina Anomalie. Righe ad altezza fissa. -->
                    <ListBox ItemsSource="{Binding AnomalieTestAperte}" IsVisible="{Binding HaAnomalieTestAperte}" MaxHeight="360" SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.AutomationId="Test_Anomalie_Aperte_List">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="0" /></Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NcRiga">
                                <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0" Margin="0,0,0,6" Height="46">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{Binding Nc.Id}" FontWeight="Bold" VerticalAlignment="Center" AutomationProperties.AutomationId="Test_Anomalia_Id_Text" />
                                        <TextBlock Grid.Column="1" Text="{Binding Nc.Descrizione}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Nc.Descrizione}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Nc.StatoWorkflow, Converter={x:Static local:WorkflowLabelConverter.Instance}}" MinWidth="110" VerticalAlignment="Center" AutomationProperties.AutomationId="Test_Anomalia_Stato_Text" />
                                        <TextBlock Grid.Column="3" Text="{Binding Nc.Priorita, Converter={x:Static local:WorkflowLabelConverter.Instance}}" MinWidth="80" VerticalAlignment="Center" AutomationProperties.AutomationId="Test_Anomalia_Priorita_Text" />
                                        <TextBlock Grid.Column="4" Text="{Binding Nc.Owner}" MinWidth="120" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="Test_Anomalia_Owner_Text" />
                                        <Button Grid.Column="5" Classes="Secondary" VerticalAlignment="Center" Click="OnApriDettaglioAnomalia" AutomationProperties.AutomationId="Test_Anomalia_Dettaglio_Button"
                                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DettaglioBtn}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NessunaAnomaliaAperta}" AutomationProperties.AutomationId="Test_Anomalie_Nessuna_Text" Classes="Muted" IsVisible="{Binding !HaAnomalieTestAperte}" />

                    <Expander Header="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=AnomalieChiuseTitolo}" IsVisible="{Binding HaAnomalieTestChiuse}">
                        <ListBox ItemsSource="{Binding AnomalieTestChiuse}" MaxHeight="360" SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.AutomationId="Test_Anomalie_Chiuse_List">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.Styles>
                            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Focusable" Value="False" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="0" /></Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                        </ListBox.Styles>
                            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:NcRiga"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6"><Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" IsEnabled="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).InModifica}"><TextBlock Text="{Binding Nc.Id}" AutomationProperties.AutomationId="Test_Anomalia_Chiusa_Id_Text" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Nc.Descrizione}" /><TextBlock Grid.Column="2" Text="{Binding Nc.MotivoChiusura}" Classes="Muted" /><Button Grid.Column="3" Classes="Secondary" IsVisible="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PuoEliminareAnomalie}" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RiapriAnomaliaBtn}" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).RiapriAnomaliaDalTestCommand}" CommandParameter="{Binding}" /><Button Grid.Column="4" Classes="Danger" IsVisible="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).PuoEliminareAnomalie}" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=EliminaBtn}" Command="{Binding #Root.((vm:TestCaseEditorViewModel)DataContext).EliminaAnomaliaDalTestCommand}" CommandParameter="{Binding}" /></Grid><Button Grid.Column="1" Classes="Secondary" Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=DettaglioBtn}" Click="OnApriDettaglioAnomalia" AutomationProperties.AutomationId="Test_Anomalia_Chiusa_Dettaglio_Button" /></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 8. REVISIONI: storico in sola lettura + cronologia modifiche, in fondo (Addendum redesign 2026-08) -->
            <Border x:Name="Revisioni" Classes="Card">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static local:TuttiVeriConverter.Instance}">
                        <Binding Path="HaStorico" />
                        <Binding Path="MostraSchedaRevisioni" />
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=StoricoRevisioniTitolo}" Classes="SectionTitle" />
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=RevisioniPrecedentiCongelate}" Classes="Muted" />
                    <!-- Storico virtualizzato (6.6.1): un Test puo' avere molte revisioni. ListBox con pannello virtualizzato e
                         altezza limitata: crea solo le righe visibili, a sola lettura come prima. -->
                    <ListBox ItemsSource="{Binding StoricoRevisioni}" MaxHeight="360" SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue"
                             AutomationProperties.AutomationId="Test_Storico_Revisioni_Lista">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="0" /></Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Esecuzione">
                                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="40,140,150,Auto,*,100">
                                        <TextBlock Grid.Column="0" Text="{Binding Iterazione, StringFormat='#{0}'}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Data, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Classes="Muted" />
                                        <TextBlock Grid.Column="2" Classes="Muted"><Run Text="{Binding Operatore}" /><Run Text="{Binding OrigineEtichetta}" /></TextBlock>
                                        <Border Grid.Column="3" Classes="Badge" Background="{Binding Esito, Converter={x:Static local:EsitoColorConverter.Instance}}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Esito, Converter={x:Static local:EsitoLabelConverter.Instance}}" FontSize="12"
                                                       Foreground="{Binding Esito, Converter={x:Static local:EsitoTextColorConverter.Instance}}" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding Note}" Classes="Muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Note}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Matricola}" Classes="Muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Matricola}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Classes="Card" IsVisible="{Binding MostraCronologiaEditor}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=CronologiaModificheTitolo}" Classes="SectionTitle" />
                    <!-- Cronologia virtualizzata (6.6.1), stessa logica dello storico: solo le righe visibili vengono create. -->
                    <ListBox ItemsSource="{Binding TestCase.Changelog}" MaxHeight="360" SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue"
                             AutomationProperties.AutomationId="Test_Cronologia_Modifiche_Lista">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="0" /></Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ChangelogEntry">
                                <Grid ColumnDefinitions="140,140,120,*" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding Data, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Classes="Muted" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding Operatore}" Classes="Muted" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding Campo}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" FontSize="12">
                                        <Run Text="{Binding ValorePrecedente}" /><Run Text=" → " /><Run Text="{Binding ValoreNuovo}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=NessunaModificaRegistrata}" Classes="Muted" IsVisible="{Binding ChangelogVuoto}" />
                </StackPanel>
            </Border>

            <!-- Avanti/Indietro: solo in creazione (Addendum: audit UX 2026-08-26, correzione post-collaudo —
                 "dovrebbe propormi anche avanti indietro come pulsanti per spostarmi nel form"), per non dover
                 puntare l'header giusto nella striscia schede ad ogni passo compilando in sequenza. -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,0,0,20">
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=SchedaIndietroBtn}" Classes="Secondary"
                        Command="{Binding SchedaIndietroCommand}" IsVisible="{Binding MostraSchedeCreazione}" IsEnabled="{Binding PuoSchedaIndietro}" />
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=SchedaAvantiBtn}" Classes="Secondary"
                        Command="{Binding SchedaAvantiCommand}" IsVisible="{Binding MostraSchedeCreazione}" IsEnabled="{Binding PuoSchedaAvanti}" />
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=TornaAllaLista}" Classes="Secondary" Command="{Binding AnnullaCommand}" />
                <Button Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=Lingua, Converter={x:Static svc:TraduciConverter.Instance}, ConverterParameter=Salva}" Classes="Primary" Command="{Binding SalvaCommand}" IsVisible="{Binding MostraAzioniModifica}" />
            </StackPanel>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
