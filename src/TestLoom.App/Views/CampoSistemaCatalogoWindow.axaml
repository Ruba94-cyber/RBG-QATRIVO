<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TestLoom.App.Views"
        xmlns:vm="using:TestLoom.App.ViewModels"
        x:Class="TestLoom.App.Views.CampoSistemaCatalogoWindow"
        Width="1000" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <!-- Niente ScrollViewer radice: darebbe altezza infinita alla tabella della vista. La vista scorre da sola. -->
    <views:CampoSistemaDefinizioneView x:Name="CampoView" />
</Window>
