<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestLoom.App.ViewModels"
             xmlns:local="using:TestLoom.App"
             xmlns:models="using:TestLoom.App.Models"
             xmlns:services="using:TestLoom.App.Services"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:TestLoom.App.Views.Controls"
             x:Class="TestLoom.App.Views.TestCaseListView"
             x:DataType="vm:TestCaseListViewModel"
             x:Name="Root">
    <!-- Layout 6.6.1: il margine viene dal token PagePadding. Riga 1: ricerca + pannello filtri comprimibile (a pannello
         chiuso i filtri attivi diventano chip). La tabella prende lo spazio residuo (riga *) con altezza minima dal token;
         la paginazione sta SOTTO la tabella. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{DynamicResource PagePadding}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListTitolo}" Classes="PageTitle" AutomationProperties.AutomationId="TestList_Title_Text" />
                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListSottotitolo}" Classes="Muted" TextWrapping="Wrap" />
                <!-- Errore di un'azione sulla lista (P4 2): collassato quando non c'e', nessuno spazio occupato. -->
                <Border Classes="Banner BannerErrore" Margin="0,8,0,0" IsVisible="{Binding HaMessaggioErrore}" AutomationProperties.AutomationId="TestList_MessaggioErrore_Banner">
                    <TextBlock Text="{Binding MessaggioErrore}" TextWrapping="Wrap" />
                </Border>
                <Border Classes="Banner BannerErrore" Margin="0,8,0,0" IsVisible="{Binding MostraRilascioLockMassaInAttesa}" AutomationProperties.AutomationId="TestList_RilascioLockInAttesa_Banner">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding MessaggioRilascioLockMassa}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="TestList_RilascioLockInAttesa_Text" />
                        <Button Grid.Column="1" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=RiprovaIndice}" Classes="Link" Command="{Binding RiprovaRilasciLockMassaCommand}" IsEnabled="{Binding PuoRiprovaRilascioLockMassa}" AutomationProperties.AutomationId="TestList_RiprovaRilascioLock_Button" />
                    </Grid>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" services:Spotlight.TargetId="test-new" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=NuovoTest}" Classes="Primary" Command="{Binding NuovoCommand}" IsEnabled="{Binding PuoCreare}" VerticalAlignment="Top" AutomationProperties.AutomationId="TestList_New_Button" />
        </Grid>

        <Border Grid.Row="1" Classes="Card" Margin="0,12,0,0">
            <StackPanel Spacing="8">
                <!-- Riga di ricerca: ricerca, pannello filtri, rimozione filtri e viste salvate sulla stessa riga. -->
                <Grid ColumnDefinitions="3*,Auto,Auto,Auto,2*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" MinWidth="200" VerticalAlignment="Center" services:Spotlight.TargetId="test-filter" services:ScorciatoieTastiera.CampoFiltroPrincipale="True" Classes="Field" Text="{Binding FiltroTestoDigitato}" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=CercaTestPlaceholder}" AutomationProperties.AutomationId="TestList_Search_TextBox">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ConfermaRicercaTestoCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="Secondary" VerticalAlignment="Center" Command="{Binding ToggleFiltriCommand}" Content="{Binding TestoToggleFiltri}" AutomationProperties.AutomationId="TestList_ToggleFiltri_Button" />
                    <Button Grid.Column="2" Classes="Link" VerticalAlignment="Center" Command="{Binding ReimpostaFiltriCommand}" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=RimuoviFiltriBtn}" IsVisible="{Binding HaFiltriAttivi}" AutomationProperties.AutomationId="TestList_RimuoviFiltri_Button" />
                    <TextBlock Grid.Column="3" Classes="Muted" FontSize="13" VerticalAlignment="Center" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=VisteSalvateLabel}" />
                    <ComboBox Grid.Column="4" MinWidth="160" VerticalAlignment="Center" Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding VisteSalvate}" SelectedItem="{Binding VistaSelezionata}" AutomationProperties.AutomationId="TestList_VisteSalvate_ComboBox" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=VisteSalvatePlaceholder}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="models:VistaSalvataFiltri"><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="5" VerticalAlignment="Center" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=SalvaVistaBtn}" Classes="Secondary" Command="{Binding SalvaVistaCorrenteCommand}" AutomationProperties.AutomationId="TestList_SalvaVista_Button" IsEnabled="{Binding HaFiltriAttivi}" />
                    <Button Grid.Column="6" VerticalAlignment="Center" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=EliminaVistaBtn}" Classes="Secondary" Command="{Binding EliminaVistaSelezionataCommand}" AutomationProperties.AutomationId="TestList_EliminaVista_Button" IsVisible="{Binding VistaSelezionata, Converter={x:Static conv:ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=EliminaVistaTooltip}" />
                </Grid>

                <!-- Pannello filtri (aperto): campi base su una griglia che si adatta alla larghezza, poi i filtri avanzati. -->
                <StackPanel Spacing="8" IsVisible="{Binding FiltriVisibili}">
                    <UniformGrid x:Name="GrigliaFiltriBase" Columns="{Binding #GrigliaFiltriBase.Bounds.Width, Converter={x:Static local:ColonneDaLarghezzaConverter.Instance}, ConverterParameter=190|8}">
                        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColEcu}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroEcu.TestoRiepilogo}" Tag="{Binding FiltroEcu}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroComponente_Button" /></StackPanel>
                        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColVeicolo}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroVeicolo.TestoRiepilogo}" Tag="{Binding FiltroVeicolo}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroVeicolo_Button" /></StackPanel>
                        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColTipoTest}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroTemplate.TestoRiepilogo}" Tag="{Binding FiltroTemplate}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroTipoTest_Button" /></StackPanel>
                        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColEsito}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroEsito.TestoRiepilogo}" Tag="{Binding FiltroEsito}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroEsito_Button" /></StackPanel>
                        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AssegnatoALabel}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroAssegnatario.TestoRiepilogo}" Tag="{Binding FiltroAssegnatario}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroAssegnatario_Button" /></StackPanel>
                        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="Ticketing" /><ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding OpzioniFiltroPolarione}" SelectedItem="{Binding FiltroHaPolarion}" AutomationProperties.AutomationId="TestList_FiltroPolarion_ComboBox">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static local:WorkflowLabelConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox></StackPanel>
                        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text=" " /><ToggleButton Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AssegnatiAMeBtn}"
                                      IsChecked="{Binding FiltroAssegnatiAMeAttivo, Mode=TwoWay}" AutomationProperties.AutomationId="TestList_FiltroAssegnatiAMe_ToggleButton" /></StackPanel>
                        <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text=" " /><ToggleButton Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=CreatiDaMeBtn}"
                                      IsChecked="{Binding FiltroCreatiDaMeAttivo, Mode=TwoWay}" AutomationProperties.AutomationId="TestList_FiltroCreatiDaMe_ToggleButton" /></StackPanel>
                    </UniformGrid>

                    <Button Classes="Link" Padding="0" HorizontalAlignment="Left" Command="{Binding ToggleFiltriAvanzatiCommand}" AutomationProperties.AutomationId="TestList_FiltriAvanzati_Button"
                            Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltriAvanzatiBtn}" />
                    <StackPanel Spacing="8" IsVisible="{Binding MostraFiltriAvanzati}">
                        <UniformGrid x:Name="GrigliaFiltriAvanzati" Columns="{Binding #GrigliaFiltriAvanzati.Bounds.Width, Converter={x:Static local:ColonneDaLarghezzaConverter.Instance}, ConverterParameter=190|9}">
                            <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroStatoLavoro}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroStatoLavoro.TestoRiepilogo}" Tag="{Binding FiltroStatoLavoro}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroStatoLavoro_Button" /></StackPanel>
                            <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroCreatoDa}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroCreatoDa.TestoRiepilogo}" Tag="{Binding FiltroCreatoDa}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroCreatoDa_Button" /></StackPanel>
                            <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroRequisito}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroRequisito.TestoRiepilogo}" Tag="{Binding FiltroRequisito}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroRequisito_Button" /></StackPanel>
                            <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroFunzionalita}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroFunzionalita.TestoRiepilogo}" Tag="{Binding FiltroFunzionalita}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroFunzionalita_Button" /></StackPanel>
                            <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroSeverita}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroSeverita.TestoRiepilogo}" Tag="{Binding FiltroSeverita}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroSeverita_Button" /></StackPanel>
                            <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroPriorita}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroPriorita.TestoRiepilogo}" Tag="{Binding FiltroPriorita}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroPriorita_Button" /></StackPanel>
                            <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroStatoAnomalia}" /><Button Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding FiltroStatoAnomalia.TestoRiepilogo}" Tag="{Binding FiltroStatoAnomalia}" Click="OnApriFiltroMultiSelect" AutomationProperties.AutomationId="TestList_FiltroStatoAnomalia_Button" /></StackPanel>
                            <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroDataDa}" /><CalendarDatePicker x:Name="ListaDataDa" Classes="Field" Width="170" HorizontalAlignment="Left" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" TextConverter="{x:Static local:DataFiltroTestoConverter.Instance}" SelectedDate="{Binding FiltroDataDa, Converter={x:Static local:DataOffsetDataConverter.Instance}}" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DataPlaceholder}" AutomationProperties.AutomationId="TestList_FiltroDataDa_DatePicker" /></StackPanel>
                            <StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Classes="Muted" FontSize="11" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroDataA}" /><CalendarDatePicker x:Name="ListaDataA" Classes="Field" Width="170" HorizontalAlignment="Left" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" TextConverter="{x:Static local:DataFiltroTestoConverter.Instance}" SelectedDate="{Binding FiltroDataA, Converter={x:Static local:DataOffsetDataConverter.Instance}}" PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DataPlaceholder}" AutomationProperties.AutomationId="TestList_FiltroDataA_DatePicker" /></StackPanel>
                        </UniformGrid>
                        <TextBlock IsVisible="{Binding HaDataNonValida}" FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroDataNonValida}" AutomationProperties.AutomationId="TestList_DataNonValida_Text" />
                        <CheckBox IsChecked="{Binding FiltroSoloImportatoUdt}" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=FiltroSoloImportatoUdtBtn}" AutomationProperties.AutomationId="TestList_FiltroImportatoUdt_CheckBox" />
                        <!-- Campi di sistema pertinenti al tipo scelto, nello stesso pannello avanzato degli altri filtri. -->
                        <controls:FiltriCampiSistemaView Filtri="{Binding FiltriCampiCustomLista}" />
                    </StackPanel>
                    <CheckBox IsVisible="{Binding FiltroSoloSenzaEcu}" IsChecked="{Binding FiltroSoloSenzaEcu}" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListSoloSenzaEcuChip}" AutomationProperties.AutomationId="TestList_FiltroSoloSenzaEcu_CheckBox" />
                </StackPanel>

                <!-- Riepilogo a chip (pannello chiuso): ogni chip rimuove solo il proprio filtro. -->
                <ItemsControl IsVisible="{Binding MostraChipFiltri}" ItemsSource="{Binding ChipFiltriAttivi}" AutomationProperties.AutomationId="TestList_ChipFiltri_ItemsControl">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChipFiltroLista">
                            <Border Classes="Chip" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Etichetta}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip.Tip="{Binding Etichetta}" />
                                    <Button Classes="Link" Content="✕" Padding="4,0" FontSize="12" Command="{Binding RimuoviCommand}" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListChipRimuoviTip}" AutomationProperties.AutomationId="TestList_ChipRimuovi_Button" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="Card" Margin="0,12,0,0" Padding="14,10" IsVisible="{Binding HaSelezione}" Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding TestoSelezione}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="TestList_SelectionSummary_Text" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                    <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AssegnaSelezionatiBtn}" Classes="Secondary" Command="{Binding AssegnaSelezionatiCommand}" IsVisible="{Binding PuoAssegnareInMassa}" AutomationProperties.AutomationId="TestList_AssegnaSelezionati_Button" />
                    <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=CambiaStatoSelezionatiBtn}" Classes="Secondary" AutomationProperties.AutomationId="TestList_CambiaStatoSelezionati_Button">
                        <Button.Flyout><MenuFlyout>
                            <MenuItem Header="{Binding Source={x:Static models:StatoLavoroTest.Pianificato}, Converter={x:Static local:WorkflowLabelConverter.Instance}}" Tag="Pianificato" Click="OnCambiaStatoSelezionati" AutomationProperties.AutomationId="TestList_CambiaStatoSelezionati_Pianificato_MenuItem" />
                            <MenuItem Header="{Binding Source={x:Static models:StatoLavoroTest.InCorso}, Converter={x:Static local:WorkflowLabelConverter.Instance}}" Tag="InCorso" Click="OnCambiaStatoSelezionati" AutomationProperties.AutomationId="TestList_CambiaStatoSelezionati_InCorso_MenuItem" />
                            <MenuItem Header="{Binding Source={x:Static models:StatoLavoroTest.DaRivedere}, Converter={x:Static local:WorkflowLabelConverter.Instance}}" Tag="DaRivedere" Click="OnCambiaStatoSelezionati" AutomationProperties.AutomationId="TestList_CambiaStatoSelezionati_DaRivedere_MenuItem" />
                            <MenuItem Header="{Binding Source={x:Static models:StatoLavoroTest.InAttesa}, Converter={x:Static local:WorkflowLabelConverter.Instance}}" Tag="InAttesa" Click="OnCambiaStatoSelezionati" AutomationProperties.AutomationId="TestList_CambiaStatoSelezionati_InAttesa_MenuItem" />
                            <MenuItem Header="{Binding Source={x:Static models:StatoLavoroTest.DaRitestare}, Converter={x:Static local:WorkflowLabelConverter.Instance}}" Tag="DaRitestare" Click="OnCambiaStatoSelezionati" AutomationProperties.AutomationId="TestList_CambiaStatoSelezionati_DaRitestare_MenuItem" />
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <Button Classes="Secondary" IsVisible="{Binding PuoVerificareAnomalie}" Click="OnVerificaAnomalie" AutomationProperties.AutomationId="TestList_VerificaAnomalie_Button"
                            Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=VerificaAnomalieBtn}" />
                    <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ArchiviaSelezionatiBtn}" Classes="Danger" Command="{Binding ArchiviaSelezionatiCommand}" AutomationProperties.AutomationId="TestList_ArchiviaSelezionati_Button" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DeselezionaTuttiBtn}" Classes="Link" Command="{Binding DeselezionaTuttiCommand}" AutomationProperties.AutomationId="TestList_DeselezionaTutti_Button" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=NessunTestFiltri}" Classes="Muted" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" IsVisible="{Binding RigheVuote}" AutomationProperties.AutomationId="TestList_Empty_Text" />

        <DataGrid x:Name="TabellaTest" services:TableLayoutPreferences.TableId="test-list" CanUserResizeColumns="True" Grid.Row="3" Margin="0,12,0,0" MinHeight="{DynamicResource AltezzaMinimaTabella}" ItemsSource="{Binding Righe}" IsReadOnly="True"
                  SelectionMode="Extended" SelectionChanged="OnSelezioneCambiata" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserSortColumns="False" IsVisible="{Binding !RigheVuote}"
                  AutomationProperties.AutomationId="TestList_Results_DataGrid">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="80" MinWidth="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ApriBtn}" Classes="Link" Command="{Binding #Root.((vm:TestCaseListViewModel)DataContext).ApriCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="TestList_Open_Button" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColId}" Width="130" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Id}" AutomationProperties.AutomationId="TestList_Row_Id_Text" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="0" IsVisible="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Classes="Badge" Background="{DynamicResource IndigoBadgeBrush}" Margin="6,4" IsVisible="{Binding Origine, Converter={x:Static local:OrigineImportatoUdtConverter.Instance}}" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportatoDaUdtTooltip}"><TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportatoDaUdtBadge}" FontSize="11" Foreground="{DynamicResource IndigoTextBrush}" AutomationProperties.AutomationId="TestList_Row_ImportatoUdt_Badge" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColDescrizioneBreve}" Width="1.6*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DescrizioneBreve}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DescrizioneBreve}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColEcu}" Width="*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Componente}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Componente}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColVeicolo}" Width="1.2*" MinWidth="140" services:TableLayoutPreferences.BassaPriorita="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding VeicoliTesto}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VeicoliTesto}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColTipoTestList}" Width="1.2*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TestTemplateUid, Converter={x:Static local:TestTemplateLabelConverter.Instance}}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TestTemplateUid, Converter={x:Static local:TestTemplateLabelConverter.Instance}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColStatoLavoro}" Width="1.1*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatoLavoro, Converter={x:Static local:WorkflowLabelConverter.Instance}}" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatoLavoro, Converter={x:Static local:WorkflowLabelConverter.Instance}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColEsitoTecnico}" Width="1.1*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Classes="Badge" Background="{Binding StatoCorrente, Converter={x:Static local:EsitoColorConverter.Instance}}" HorizontalAlignment="Left" Margin="6,4"><TextBlock Text="{Binding StatoCorrente, Converter={x:Static local:EsitoLabelConverter.Instance}, TargetNullValue='Non testato'}" FontSize="12" Foreground="{Binding StatoCorrente, Converter={x:Static local:EsitoTextColorConverter.Instance}}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColAnomalie}" Width="1.4*" MinWidth="170" services:TableLayoutPreferences.BassaPriorita="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="4" Margin="6,2"><ItemsControl ItemsSource="{Binding StatiAnomalieAperteVisual}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Classes="Badge" Background="{DynamicResource WarningBackgroundBrush}" Margin="0,0,4,0"><TextBlock Text="{Binding Converter={x:Static local:WorkflowLabelConverter.Instance}}" FontSize="11" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Classes="Muted" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding !!AnomalieChiuseVisual}"><TextBlock.Text><MultiBinding Converter="{x:Static local:LocalizedCountConverter.Instance}" ConverterParameter="AnomalieChiuseFmt"><Binding Path="AnomalieChiuseVisual" /><Binding Source="{x:Static services:LocalizationService.Instance}" Path="Lingua" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColReiterazioni}" Binding="{Binding NumeroReiterazioniCorrente}" Width="130" services:TableLayoutPreferences.BassaPriorita="True" />
                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColModificato}" Binding="{Binding UltimaModifica, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145" services:TableLayoutPreferences.BassaPriorita="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0" ColumnSpacing="8">
            <Button Grid.Column="0" Content="⏮" Classes="Secondary" Command="{Binding PrimaPaginaCommand}" AutomationProperties.AutomationId="TestList_PrimaPagina_Button" IsEnabled="{Binding PuoPaginaPrecedente}" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListPrimaPaginaTip}" />
            <Button Grid.Column="1" Content="‹" Classes="Secondary" Command="{Binding PaginaPrecedenteCommand}" AutomationProperties.AutomationId="TestList_PaginaPrecedente_Button" IsEnabled="{Binding PuoPaginaPrecedente}" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListPaginaPrecedenteTip}" />
            <TextBlock Grid.Column="2" Text="{Binding TestoPaginazione}" Classes="Muted" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.AutomationId="TestList_Pagination_Text" />
            <Button Grid.Column="3" Content="›" Classes="Secondary" Command="{Binding PaginaSuccessivaCommand}" AutomationProperties.AutomationId="TestList_PaginaSuccessiva_Button" IsEnabled="{Binding PuoPaginaSuccessiva}" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=TestListPaginaSuccessivaTip}" />
        </Grid>
    </Grid>
</UserControl>
