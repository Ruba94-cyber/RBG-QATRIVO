<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TestLoom.App.ViewModels"
        xmlns:local="using:TestLoom.App"
        xmlns:services="using:TestLoom.App.Services"
        x:Class="TestLoom.App.Views.AnomalieTestElencoWindow"
        x:DataType="vm:AnomalieTestElencoViewModel"
        Width="900" Height="520" MinWidth="640" MinHeight="320" CanResize="True"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AnomalieDelTestElencoTitolo}" />
            <TextBlock Text="{Binding TestId}" Classes="Muted" AutomationProperties.AutomationId="ListaTest_Anomalie_TestId_Text" />
        </StackPanel>

        <!-- Righe compatte ad altezza fissa in un solo ListBox virtualizzato; la modifica avviene nel pop-up di dettaglio. -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Righe}" SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 KeyboardNavigation.TabNavigation="Continue" AutomationProperties.AutomationId="ListaTest_Anomalie_List">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="0" /></Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NcRiga">
                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0" Margin="0,0,0,6" Height="46">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{Binding Nc.Id}" FontWeight="Bold" VerticalAlignment="Center" AutomationProperties.AutomationId="ListaTest_Anomalia_Id_Text" />
                            <TextBlock Grid.Column="1" Text="{Binding Nc.Descrizione}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Nc.Descrizione}" />
                            <TextBlock Grid.Column="2" Text="{Binding Nc.StatoWorkflow, Converter={x:Static local:WorkflowLabelConverter.Instance}}" MinWidth="110" VerticalAlignment="Center" AutomationProperties.AutomationId="ListaTest_Anomalia_Stato_Text" />
                            <TextBlock Grid.Column="3" Text="{Binding Nc.Priorita, Converter={x:Static local:WorkflowLabelConverter.Instance}}" MinWidth="80" VerticalAlignment="Center" AutomationProperties.AutomationId="ListaTest_Anomalia_Priorita_Text" />
                            <TextBlock Grid.Column="4" Text="{Binding Nc.Owner}" MinWidth="120" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="ListaTest_Anomalia_Owner_Text" />
                            <Button Grid.Column="5" Classes="Secondary" VerticalAlignment="Center" Click="OnModificaStato" AutomationProperties.AutomationId="ListaTest_Anomalia_Modifica_Button"
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=DettaglioBtn}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0" Classes="Secondary" Click="OnChiudi" AutomationProperties.AutomationId="ListaTest_Anomalie_Chiudi_Button"
                Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ChiudiMessaggioTip}" />
    </Grid>
</Window>
