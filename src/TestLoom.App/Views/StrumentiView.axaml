<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestLoom.App.ViewModels"
             xmlns:services="using:TestLoom.App.Services"
             xmlns:models="using:TestLoom.App.Models"
             xmlns:local="using:TestLoom.App"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="TestLoom.App.Views.StrumentiView"
             x:DataType="vm:StrumentiViewModel"
             x:Name="Root">
<Grid RowDefinitions="Auto,Auto,Auto,*" Margin="{DynamicResource PagePadding}" IsEnabled="{Binding InterazioneEditorAbilitata}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=StrumentiTitolo}" Classes="PageTitle" />
                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=StrumentiSottotitolo}" Classes="Muted" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Classes="AzioniPagina" MaxWidth="560">
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=Modifica}" Classes="Secondary" Command="{Binding IniziaModificaCommand}" IsVisible="{Binding MostraModifica}" AutomationProperties.AutomationId="Strum_Modifica_Button" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=NuovoGenerico}" Classes="Secondary" Command="{Binding NuovoCommand}" IsVisible="{Binding InModifica}" AutomationProperties.AutomationId="Strum_Nuovo_Button" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=NuovoTooltipCtrlN}" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportaExcelBtn}" Classes="Secondary" Command="{Binding ImportaDaExcelCommand}" IsVisible="{Binding InModifica}" Click="OnImportaExcel" AutomationProperties.AutomationId="Strum_ImportaExcel_Button" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=Annulla}" Classes="Secondary" Command="{Binding AnnullaCommand}" IsVisible="{Binding InModifica}" AutomationProperties.AutomationId="Strum_Annulla_Button" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AnnullaTooltipEsc}" />
                <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=Salva}" Classes="Primary" Command="{Binding SalvaCommand}" IsVisible="{Binding InModifica}" AutomationProperties.AutomationId="Strum_Salva_Button" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=SalvaTooltipCtrlS}" />
            </WrapPanel>
        </Grid>

        <!-- Banner lock/errore/esito: sempre visibili, fuori dall'area scorrevole (un errore di Salva non deve finire fuori vista). -->
        <StackPanel Grid.Row="1">
            <Border Classes="Banner BannerAvviso" IsVisible="{Binding AvvisoLockNonConfermato}" Margin="0,12,0,0">
                <TextBlock Text="{Binding AvvisoLockNonConfermatoTesto}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="Banner BannerAvviso" IsVisible="{Binding LockDetenutoDaAltri}" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding LockInfoTesto, StringFormat='🔒 {0}'}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ForzaSbloccoBtn}" Classes="Link" Command="{Binding ForzaSbloccoCommand}" />
                </Grid>
            </Border>

            <Border Classes="Banner BannerErrore" IsVisible="{Binding HaMessaggioErrore}" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding MessaggioErrore}" TextWrapping="Wrap" AutomationProperties.AutomationId="Strum_MessaggioErrore_Text" />
                    <Button Grid.Column="1" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=RiprovaIndice}" Classes="Link" Command="{Binding RiprovaRilascioLockCommand}" IsVisible="{Binding RilascioLockInAttesa}" AutomationProperties.AutomationId="Strum_RiprovaRilascioLock_Button" />
                </Grid>
            </Border>

            <Border Classes="Banner BannerSuccesso" IsVisible="{Binding HaMessaggio}" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="BannerSuccessoTesto" Text="{Binding Messaggio}" />
                    <Button Grid.Column="1" Classes="BannerChiudi" Content="✕" Command="{Binding CancellaMessaggioCommand}" ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ChiudiMessaggioTip}" AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ChiudiMessaggioTip}" />
                </Grid>
            </Border>
            <Border Classes="Banner BannerSuccesso" IsVisible="{Binding HaReportImport}" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Classes="BannerSuccessoTesto" Text="{Binding ReportImport}" TextWrapping="Wrap" AutomationProperties.AutomationId="Strum_ReportImport_Text" />
                    <WrapPanel>
                        <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportReportCopia}" Classes="Secondary" Command="{Binding CopiaReportImportCommand}" AutomationProperties.AutomationId="Strum_CopiaReportImport_Button" />
                        <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportReportAnnullaUltimo}" Classes="Secondary" Command="{Binding AnnullaUltimoImportCommand}" IsVisible="{Binding PuoAnnullareUltimoImport}" AutomationProperties.AutomationId="Strum_AnnullaUltimoImport_Button" />
                        <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ImportReportRiprova}" Classes="Secondary" Command="{Binding RiprovaImportCommand}" IsVisible="{Binding PuoRiprovareImport}" AutomationProperties.AutomationId="Strum_RiprovaImport_Button" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Zona sopra la tabella: altezza limitata e scorrevole, cosi' la griglia principale mantiene sempre
             un'altezza minima utile (NON mettere mai la DataGrid dentro questo ScrollViewer: spezza la virtualizzazione). -->
        <ScrollViewer Grid.Row="2" MaxHeight="{Binding #Root.Bounds.Height, Converter={x:Static local:AltezzaResiduaConverter.Instance}, ConverterParameter=400}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                    <TextBox Grid.Column="0" Classes="Field" Text="{Binding FiltroTesto}" AutomationProperties.AutomationId="Strum_Cerca_TextBox"
                              PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=CercaMasterDataPlaceholder}" />
                    <Button Grid.Column="1" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=RimuoviFiltriBtn}" Classes="Link"
                            Margin="8,0,0,0" Command="{Binding ReimpostaFiltriCommand}" IsVisible="{Binding HaFiltriAttivi}" />
                </Grid>


                <Expander Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False" IsVisible="{Binding Unione.MostraPannello}" Header="{Binding Unione.TitoloPannello}" AutomationProperties.AutomationId="StrumUnioneExpander">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnioneNessunaSelezione}" Classes="Muted" IsVisible="{Binding !Unione.HaSelezione}" />
                        <Border Classes="Banner BannerErrore" IsVisible="{Binding Unione.HaErroreOperazione}"><TextBlock Text="{Binding Unione.ErroreOperazione}" TextWrapping="Wrap" AutomationProperties.AutomationId="StrumUnioneErrore_Text" /></Border>
                        <Border Classes="Banner BannerSuccesso" IsVisible="{Binding Unione.HaMessaggioEsito}"><TextBlock Classes="BannerSuccessoTesto" Text="{Binding Unione.MessaggioEsito}" AutomationProperties.AutomationId="StrumUnioneEsito_Text" /></Border>
                        <TextBlock Text="{Binding Unione.ProgressoTesto}" Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding Unione.IsBusy}" AutomationProperties.AutomationId="StrumUnioneAvanzamento" />
                        <StackPanel Spacing="4" IsEnabled="{Binding Unione.PannelloAbilitato}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Unione.HaSelezione}">
                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Unione.AltreVociPerUnione}" SelectedItem="{Binding Unione.VocePerUnioneSelezionata}"
                                      PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnisciInPlaceholder}"
                                      AutomationProperties.AutomationId="StrumComboUnisciIn"
                                      IsVisible="{Binding Unione.AltreVociPerUnione, Converter={x:Static local:ListaEntroSogliaConverter.Instance}}" />
                            <Button Grid.Column="0" Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Unione.VocePerUnioneTesto}" Command="{Binding Unione.ScegliVocePerUnioneCommand}"
                                    IsVisible="{Binding Unione.AltreVociPerUnione, Converter={x:Static local:ListaOltreSogliaConverter.Instance}}" AutomationProperties.AutomationId="StrumBtnScegliUnisciIn" />
                            <Button Grid.Column="1" Classes="Secondary" AutomationProperties.AutomationId="StrumBtnUnisci"
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnisciBtn}"
                                    Command="{Binding Unione.UnisciSelezionataCommand}" IsEnabled="{Binding Unione.VocePerUnioneSelezionata, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Unione.HaSelezione}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding Unione.NuovoNomeRinomina}"
                                     PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterRinominaInPlaceholder}"
                                     AutomationProperties.AutomationId="StrumTextRinominaIn" />
                            <Button Grid.Column="1" Classes="Secondary" AutomationProperties.AutomationId="StrumBtnRinomina"
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterRinominaBtn}"
                                    Command="{Binding Unione.RinominaSelezionataCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Unione.HaSelezione}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding Unione.VociDivisioneTesto}"
                                     PlaceholderText="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterDividiInPlaceholder}"
                                     AutomationProperties.AutomationId="StrumTextDividiIn" />
                            <Button Grid.Column="1" Classes="Secondary" AutomationProperties.AutomationId="StrumBtnDividi"
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterDividiBtn}"
                                    Command="{Binding Unione.DividiSelezionataCommand}" />
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <Border Classes="Banner BannerAvviso" Margin="0,12,0,0" IsVisible="{Binding Unione.MostraCoppieSospette}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnioneCoppieSospetteTitolo}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=MasterUnioneCoppieSospetteSottotitolo}" Classes="Muted" FontSize="13" TextWrapping="Wrap" />
                        <!-- Coppie virtualizzate (6.6.1): ListBox con pannello virtualizzato e altezza dal layout, come in WU Status. -->
                        <ListBox ItemsSource="{Binding Unione.CoppieSospette}" MaxHeight="{Binding #Root.Bounds.Height, Converter={x:Static local:AltezzaResiduaConverter.Instance}, ConverterParameter=420|120}"
                                 Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue"
                                 AutomationProperties.AutomationId="Strumenti_CoppieSospette_Lista">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="0" /></Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CoppiaSospettaMaster">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run Text="{Binding A}" FontWeight="SemiBold" /><Run Text=" ↔ " /><Run Text="{Binding B}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Classes="Secondary" Padding="8,4" Margin="8,0,0,0" AutomationProperties.AutomationId="StrumBtnUnisciRapido"
                                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=WuUnisciRapidoBtn}"
                                                    Command="{Binding #Root.((vm:StrumentiViewModel)DataContext).Unione.UnisciCoppiaSospettaCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>


        <DataGrid x:Name="GridPrincipale" BeginningEdit="OnGridBeginningEdit" services:TableLayoutPreferences.TableId="tools" CanUserResizeColumns="True" Grid.Row="3" MinHeight="200" Margin="0,16,0,0" ItemsSource="{Binding ItemsAttivi}" IsReadOnly="{Binding !InModifica}"
                  SelectedItem="{Binding ElementoSelezionato}"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:StrumentoDiagnostico">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <!-- AutomationId parametrizzato per strumento (MINOR, review indipendente
                                     2026-09-24): come TplCampoSu_{chiave} nell'editor del Test Template, invece
                                     dello stesso Id ripetuto su ogni riga — evita di dover risalire dal testo
                                     della cella Nome al contenitore di riga nei test FlaUI. -->
                                <Button Content="▲" Classes="Link" Padding="4,0" AutomationProperties.AutomationId="{Binding Nome, StringFormat='StrumBtnSpostaSu_{0}'}"
                                        IsVisible="{Binding #Root.((vm:StrumentiViewModel)DataContext).InModifica}"
                                        Command="{Binding #Root.((vm:StrumentiViewModel)DataContext).SpostaSuStrumentoCommand}" CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=StrumentiSpostaSuTooltip}" />
                                <Button Content="▼" Classes="Link" Padding="4,0" AutomationProperties.AutomationId="{Binding Nome, StringFormat='StrumBtnSpostaGiu_{0}'}"
                                        IsVisible="{Binding #Root.((vm:StrumentiViewModel)DataContext).InModifica}"
                                        Command="{Binding #Root.((vm:StrumentiViewModel)DataContext).SpostaGiuStrumentoCommand}" CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=StrumentiSpostaGiuTooltip}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=StrumentiColNome}" Binding="{Binding Nome}" SortMemberPath="Nome" Width="*" MinWidth="260" />
                <!-- Tipo dello strumento (6.5.1): Da testare / Comportamento / Supporto. Vale TipoEffettivo (classificazione nota per nome se non
                     impostato, altrimenti Supporto); la scelta e esplicita e persistita in StrumentoDiagnostico.Tipo. -->
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=StrumentiColTipo}" Width="150" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:StrumentoDiagnostico">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{x:Static models:StrumentoDiagnostico.TipiDisponibili}"
                                      SelectedItem="{Binding TipoScelto, Mode=TwoWay}"
                                      IsEnabled="{Binding #Root.((vm:StrumentiViewModel)DataContext).InModifica}"
                                      AutomationProperties.AutomationId="{Binding Nome, StringFormat='Strum_Tipo_{0}_Combo'}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static local:TipoStrumentoLabelConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColCampiStrumento}" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:StrumentoDiagnostico">
                            <Button Classes="Link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Click="OnGestisciCampi" Tag="{Binding}" IsEnabled="{Binding #Root.((vm:StrumentiViewModel)DataContext).InModifica}" AutomationProperties.AutomationId="Strumenti_GestisciCampi_Button">
                                <Button.Content>
                                    <MultiBinding Converter="{x:Static local:CampiStrumentoCountConverter.Instance}">
                                        <Binding Source="{x:Static services:LocalizationService.Instance}" Path="Lingua" />
                                        <Binding Path="Campi.Count" />
                                    </MultiBinding>
                                </Button.Content>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColUltimaModifica}" Binding="{Binding UltimaModifica, Mode=OneWay, StringFormat={}{0:dd/MM/yy HH:mm}}" Width="140" MinWidth="140" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ColDa}" Binding="{Binding ModificatoDa}" Width="120" MinWidth="120" IsReadOnly="True" />
                <DataGridTemplateColumn Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:StrumentoDiagnostico">
                            <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ArchiviaBtn}" Classes="Link"
                                    IsEnabled="{Binding #Root.((vm:StrumentiViewModel)DataContext).InModifica}"
                                    Command="{Binding #Root.((vm:StrumentiViewModel)DataContext).ArchiviaCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="Strum_RigaArchivia_Button" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Stato vuoto: sovrapposto alla griglia, non intercetta i click. -->
        <StackPanel Grid.Row="3" Classes="ElencoVuotoOverlay" Margin="0,40,0,0">
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ElencoVuoto}" Classes="Muted" HorizontalAlignment="Center" IsVisible="{Binding MostraElencoVuoto}" AutomationProperties.AutomationId="Strum_ElencoVuoto_Text" />
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ElencoVuotoFiltrato}" Classes="Muted" HorizontalAlignment="Center" IsVisible="{Binding MostraElencoVuotoFiltrato}" />
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=ElencoVuotoSuggerimento}" Classes="Muted" HorizontalAlignment="Center" IsVisible="{Binding MostraSuggerimentoElencoVuoto}" />
        </StackPanel>
    </Grid>
</UserControl>
