<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:TestLoom.App.Services"
        x:Class="TestLoom.App.Views.TestFormPreviewWindow"
        Width="640" Height="640" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
            <TextBlock x:Name="TitoloText" AutomationProperties.AutomationId="AnteprimaForm_Titolo_Text" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AnteprimaFormTitolo}" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=AnteprimaFormSottotitolo}" Classes="Muted" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" AutomationProperties.AutomationId="AnteprimaForm_Contenuto_ScrollViewer">
            <ContentControl x:Name="Host" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ChiudiButton" Classes="Primary" AutomationProperties.AutomationId="AnteprimaForm_Chiudi_Button"
                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Lingua, Converter={x:Static services:TraduciConverter.Instance}, ConverterParameter=Chiudi}" />
        </StackPanel>
    </Grid>
</Window>
