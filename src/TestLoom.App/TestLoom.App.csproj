<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rbg-qatrivo.ico</ApplicationIcon>
    <AssemblyName>TestLoom</AssemblyName>
    <Product>RBG - QATRIVO</Product>
    <AssemblyTitle>RBG - QATRIVO</AssemblyTitle>
    <Description>Quality Assurance &amp; Traceability Platform</Description>
    <Authors>Paolo Rubagotti</Authors>
    <Version>7.0.1</Version>
    <AssemblyVersion>7.0.1.0</AssemblyVersion>
    <FileVersion>7.0.1.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.19" />
    <PackageReference Include="QuestPDF" Version="2026.7.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.12" />
  </ItemGroup>
  <Target Name="RbgQatrivoBuildAlias" AfterTargets="Build" Condition="Exists('$(TargetDir)TestLoom.exe')">
    <Copy SourceFiles="$(TargetDir)TestLoom.exe" DestinationFiles="$(TargetDir)RBG - QATRIVO.exe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="RbgQatrivoPublishExe" AfterTargets="Publish" Condition="Exists('$(PublishDir)TestLoom.exe')">
    <Move SourceFiles="$(PublishDir)TestLoom.exe" DestinationFiles="$(PublishDir)RBG - QATRIVO.exe" />
  </Target>
</Project>
