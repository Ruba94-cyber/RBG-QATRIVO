<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:TestLoom.App.Services">
    <!-- Apre la lista completa al primo focus/click, non solo quando si comincia a scrivere (feedback utente
         2026-08-20, punti 6/13). Globale: si applica a ogni AutoCompleteBox dell'app senza dover toccare
         ciascuna view una per una — copre Gamma, Categoria, componente, Veicolo, Funzionalità, Assegnatario, Tipo di
         test, Requisiti/Test collegati e tutti i filtri. -->
    <Style Selector="AutoCompleteBox">
        <Setter Property="services:AutoCompleteBoxBehavior.ApriAlFocus" Value="True" />
    </Style>
    <!-- Sfondo opaco per tutte le finestre (principale e dialoghi): senza Background la finestra e' trasparente e lascia
         vedere la finestra sotto (segnalato sul dialogo Campi: Pianificazione). Il colore viene dal token
         WindowBackgroundBrush di App.axaml; XamlSfondoFinestreTests ne garantisce l'opacita'. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="CanResize" Value="True" />
    </Style>
    <!-- Tooltip uniformi su tutta l'app: fondo azzurro e bordo accentuato li rendono visibili,
         il testo va a capo prima di diventare largo, e il posizionamento Popup predefinito può
         capovolgersi/scorrere/ridursi entro l'area di lavoro dello schermo. -->
    <Style Selector="ToolTip">
        <Setter Property="MaxWidth" Value="680" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ToolTip /template/ ContentPresenter">
        <Setter Property="MaxWidth" Value="680" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.SpotlightTarget">
        <Setter Property="BorderBrush" Value="#F59E0B" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="TextBox.SpotlightTarget">
        <Setter Property="BorderBrush" Value="#F59E0B" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Border.SpotlightTarget">
        <Setter Property="BorderBrush" Value="#F59E0B" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BoxShadow" Value="0 0 0 5 #55FBBF24" />
    </Style>
    <!-- StackPanel non ha BorderBrush/BorderThickness (a differenza di Button/TextBox/Border sopra), quindi
         restava l'unico contenitore "campo-XXX" del form Test senza alcun effetto visivo quando puntato da
         Spotlight (Addendum: audit UX 2026-08-26, nota minore 2 — "CampiMancantiDialog porta al campo giusto
         ma manca l'evidenza sul campo": il salto alla sezione funzionava, l'evidenziazione no, perché ogni
         campo-etichetta+controllo del form Test è avvolto in uno StackPanel, non in un Border). Sfondo invece
         di bordo, stesso colore ambra già usato per il tour: uno sfondo pieno resta visibile anche quando lo
         StackPanel contiene un ComboBox/AutoCompleteBox che disegna il proprio sfondo bianco sopra un ipotetico
         bordo esterno. -->
    <Style Selector="StackPanel.SpotlightTarget">
        <!-- Solo Background: StackPanel (a differenza di Border/TemplatedControl) non ha Padding né
             CornerRadius, e un Margin negativo per simulare un padding cambierebbe lo spazio allocato nel
             layout del genitore (Grid/StackPanel con spaziatura tra colonne), rischiando una sovrapposizione
             visiva con il campo affiancato. Solo Background resta sicuro: non influisce mai sul layout. -->
        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
    </Style>

  <!-- Dimensione dai token del layout adattivo (22 in Standard/Ampio, 18 in Compatto/Minimo). -->
  <Style Selector="TextBlock.PageTitle">
    <Setter Property="FontSize" Value="{DynamicResource TitoloPagina}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Intestazione di gruppo per pagine con più card correlate ma non abbastanza vicine da stare in una
       sola Card (Addendum: audit UX 2026-08-26, punto 7 — Impostazioni → Generale accumulava 12 blocchi in
       una sola colonna senza alcuna gerarchia visiva tra "le mie preferenze locali", "configurazione
       condivisa" e "stato/manutenzione"). Deliberatamente più discreta di SectionTitle: è un separatore, non
       il titolo di un contenuto specifico. -->
  <Style Selector="TextBlock.GroupHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Margin" Value="2,20,0,-4" />
  </Style>

  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,4,0,8" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <!-- Da 12 a 13 (Addendum: audit UX 2026-08-26, punto 5): stessa scala tipografica applicata a tutte le
         etichette secondarie sparse nelle view (204 delle 253 dichiarazioni FontSize esplicite dell'app erano
         ≤12px, corpo di testo troppo piccolo per un'app desktop usata per turni interi). Muted resta comunque
         un gradino sotto il testo principale grazie al solo colore attenuato, non più anche a una dimensione
         inferiore. -->
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Testi a riga singola in spazi vincolati: l'ellipsis segnala il taglio e il tooltip
       mantiene sempre disponibile il valore completo, anche dopo il ridimensionamento. -->
  <Style Selector="TextBlock.FullTextTip">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
  </Style>

  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
  </Style>

  <Style Selector="Border.Banner">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="Border.BannerAvviso">
    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="#F59E0B" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.BannerErrore">
    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="#DC2626" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.BannerSuccesso">
    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBlock.BannerSuccessoTesto">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.BannerChiudi">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Barra azioni dell'intestazione pagina: i pulsanti vanno a capo invece di essere tagliati a larghezze strette. -->
  <Style Selector="WrapPanel.AzioniPagina">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="ItemSpacing" Value="8" />
    <Setter Property="LineSpacing" Value="8" />
  </Style>

  <!-- Stato vuoto della tabella principale (sovrapposto alla griglia, non intercetta i click). -->
  <Style Selector="StackPanel.ElencoVuotoOverlay">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Spacing" Value="4" />
  </Style>

  <Style Selector="Border.BannerInfo">
    <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="#3B82F6" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.Badge">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <Style Selector="ListBoxItem.NavItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="8,2" />
  </Style>

  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
  </Style>

  <Style Selector="Button.Secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
  </Style>
  <Style Selector="Button.Secondary:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Variante di Secondary per bottoni sulla sidebar scura (#0F172A): Secondary da solo non imposta un
       Foreground esplicito (nero di default), invisibile lì — bug segnalato dall'utente sul bottone "Cerca
       ovunque" (2026-08-19). -->
  <Style Selector="Button.SecondaryDark">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#334155" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.SecondaryDark:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#334155" />
  </Style>
  <Style Selector="Button.SecondaryDark:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.Danger">
    <Setter Property="Background" Value="#DC2626" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.Danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#B91C1C" />
  </Style>
  <Style Selector="Button.Danger:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.Primary:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.Link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
  </Style>
  <Style Selector="Button.Link:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="TextBox.Field">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <!-- Campo con testo non valido (es. filtro TIME "1,5"): bordo rosso, il messaggio e' sotto il campo nella vista. -->
  <Style Selector="TextBox.Field.CampoNonValido">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- DataGrid: palette chiara e scura tramite token dinamici,
       per garantire leggibilità del testo su tutte le colonne (non solo sui badge colorati). -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="CanUserReorderColumns" Value="True" />
    <!-- Se le colonne eccedono la larghezza (schermi piccoli) si scorre in orizzontale invece di schiacciarle. -->
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
  </Style>
  <!-- Niente ToolTip.Tip qui (feedback utente 2026-08-25, punti 3/4): un tooltip attivo sull'header blocca
       l'hit-test del resize/reorder gripper di DataGridColumnHeader, impedendo di ridimensionare o riordinare
       le colonne. Le intestazioni sono etichette brevi definite dall'app (non dati utente lunghi), quindi non
       serve un tooltip qui — il testo integrale dei DATI resta comunque leggibile via il tooltip su DataGridCell
       TextBlock qui sotto. -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
  </Style>
  <Style Selector="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource InfoBackgroundBrush}" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SurfaceSubtleBrush}" />
  </Style>

  <Style Selector="ComboBox.Field">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Lista filtrabile sempre visibile: rimane come pattern per eventuali usi futuri, ma i campi con liste
       potenzialmente enormi (componente, veicoli, Test/Anomalie/Requisiti collegabili) sono passati a Button.Field
       + SelezionaDialog (feedback utente 2026-08-20: una lista sempre aperta allungava ogni riga del form
       anche a riposo). -->
  <Style Selector="ListBox.Field">
    <Setter Property="MaxHeight" Value="160" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- Pulsante-picker: stesso ingombro/aspetto di un TextBox.Field, testo allineato a sinistra come un campo
       normale invece che centrato come un Button.Secondary. Content mostra il valore scelto o il placeholder
       (ScegliPlaceholderConverter) — lo stesso pulsante riapre il dialog sia per scegliere sia per cambiare. -->
  <Style Selector="Button.Field">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.Field:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>

  <!-- Modo compatto e minimo (6.6.1): padding dei controlli ridotto, altezza minima 32 px sui controlli cliccabili
       (il padding si riduce, l'altezza no). Le classi Window.compatto / Window.minimo le mette MainWindow, e
       AdattamentoDialogo le copia sui dialoghi. Minimo implica anche compatto. -->
  <Style Selector="Window.compatto TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Window.compatto Button.Primary">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Window.compatto Button.Secondary">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Window.compatto Button.Danger">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Window.compatto Button.Field">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Window.compatto TextBox.Field">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Window.compatto ComboBox.Field">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Window.compatto Border.Banner">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <!-- Righe piu' basse in Compatto: l'altezza della riga la fa il pulsante di riga (32 px minimi, regola dei controlli
       cliccabili), quindi il padding verticale della cella va a zero invece di sommarsi ai 32 px (righe da ~40 a ~33 px). -->
  <Style Selector="Window.compatto DataGridCell">
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Window.compatto DataGridColumnHeader">
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <!-- Chip del riepilogo filtri (pannello filtri chiuso): un filtro attivo, con il ✕ per annullare solo lui. -->
  <Style Selector="Border.Chip">
    <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <!-- Card a colonne degli editor (6.6.1): un WrapPanel con ItemWidth da LarghezzaColonnaConverter prende il posto della Grid a
       colonne fisse. Ogni figlio ha lo stesso spazio fra colonne e righe; in Compatto la larghezza piena = una colonna sola. -->
  <Style Selector="WrapPanel.ColonneEditor > Control">
    <Setter Property="Margin" Value="0,0,12,10" />
  </Style>

  <!-- Pagina Audit in compatto (6.6.1): il sottotitolo non serve e la matrice prende lo spazio in altezza. -->
  <Style Selector="Window.compatto TextBlock.AuditSottotitolo">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Sidebar della finestra principale (6.6.1). Margini e padding stanno qui e non inline nel XAML, cosi' lo stesso
       stile vale per Standard, Compatto e Minimo. Il Link della sidebar scura non usa l'opacita' del Link disabilitato
       (su #0F172A il colore chiaro attenuato al 50% spariva): da disabilitato diventa grigio leggibile, circa 3.7:1. -->
  <Style Selector="Button.SidebarLink">
    <Setter Property="Foreground" Value="#CBD5E1" />
  </Style>
  <Style Selector="Button.SidebarLink:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.SidebarLink:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.SidebarLink:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.SidebarVoce">
    <Setter Property="Margin" Value="12,16,12,0" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.SidebarBox">
    <Setter Property="Margin" Value="12,8,12,16" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Button.SidebarIndietro">
    <Setter Property="Margin" Value="12,12,12,0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.SidebarAggiorna">
    <Setter Property="Margin" Value="12,0,12,4" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.SidebarBanner">
    <Setter Property="Margin" Value="12,0,12,8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="ListBox.SidebarNav ListBoxItem">
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Margin" Value="10,1.5" />
  </Style>
  <!-- Icone e testi della sidebar: fuori dal modo minimo le icone sono nascoste; in minimo restano solo le icone (con
       tooltip) e i testi escono dal layout, cosi' nulla viene tagliato a 64 px. -->
  <Style Selector="TextBlock.SidebarIcona">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.minimo TextBlock.SidebarIcona">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Window.minimo TextBlock.SidebarTesto">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.minimo StackPanel.SidebarTesto">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.minimo Button.SidebarTesto">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.minimo Button.SidebarVoce">
    <Setter Property="Margin" Value="6,12,6,0" />
    <Setter Property="Padding" Value="0,9" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Window.minimo Border.SidebarBox">
    <Setter Property="Margin" Value="6,6,6,10" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Window.minimo Button.SidebarIndietro">
    <Setter Property="Margin" Value="6,8,6,0" />
    <Setter Property="Padding" Value="0,3" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Window.minimo Border.SidebarBanner">
    <Setter Property="Margin" Value="6,0,6,8" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Window.minimo ListBox.SidebarNav ListBoxItem">
    <Setter Property="Padding" Value="0,9" />
    <Setter Property="Margin" Value="6,1.5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- Navigazione delle sotto-sezioni di Impostazioni (6.6.1): 220 px; in Compatto e Minimo solo icone, con il nome nel
       tooltip di ogni voce, cosi' le tabelle delle viste master restano leggibili a 1280 px. -->
  <Style Selector="ListBox.SubNavImpostazioni">
    <Setter Property="Width" Value="220" />
  </Style>
  <Style Selector="Window.compatto ListBox.SubNavImpostazioni">
    <Setter Property="Width" Value="60" />
  </Style>
  <Style Selector="Window.compatto TextBlock.NavTesto">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.compatto TextBlock.NavTitolo">
    <Setter Property="IsVisible" Value="False" />
  </Style>
</Styles>
